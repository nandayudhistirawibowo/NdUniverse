---
const {
  title = 'Dashboard | siDeutsch',
  description = 'Portal mahasiswa siDeutsch.',
  variant = 'student',
  active = '',
  user = null,
  profile = null,
} = Astro.props;

const isAdmin = variant === 'admin';
const displayName = profile?.nama_lengkap || profile?.nim || user?.user_metadata?.nim || 'Mahasiswa';
const nim = profile?.nim || user?.user_metadata?.nim || '';
const accountInitial = displayName.slice(0, 1).toUpperCase();
const logoFallback = 'siDeutsch';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class={`private-shell ${isAdmin ? 'admin-shell' : 'student-shell'}`}>
      <aside class="private-sidebar" aria-label={isAdmin ? 'Navigasi admin' : 'Navigasi mahasiswa'}>
        <a class="sidebar-logo" href={isAdmin ? '/admin' : '/dashboard'} aria-label="siDeutsch">
          <img src="/logo.png" alt="siDeutsch" />
          <span>{logoFallback}</span>
        </a>

        {!isAdmin && (
          <div class="sidebar-profile">
            {profile?.avatar_url ? (
              <img class="sidebar-avatar" src={profile.avatar_url} alt="" />
            ) : (
              <span class="sidebar-avatar avatar-initial" aria-hidden="true">{accountInitial}</span>
            )}
            <div class="profile-copy">
              <strong>{displayName}</strong>
              <span>{nim}</span>
            </div>
          </div>
        )}

        <nav class="private-nav">
          {isAdmin ? (
            <a class={`nav-item ${active === 'users' ? 'active' : ''}`} href="/admin" aria-current={active === 'users' ? 'page' : undefined}>
              <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 9h9M8 13h9M8 17h5" /></svg>
              <span>Manajemen User</span>
            </a>
          ) : (
            <>
              <a class={`nav-item ${active === 'home' ? 'active' : ''}`} href="/dashboard" aria-current={active === 'home' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1V10Z" /></svg>
                <span>Beranda</span>
              </a>
              <a class={`nav-item ${active === 'catalog' ? 'active' : ''}`} href="/dashboard/katalog" aria-current={active === 'catalog' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5v-12Z" /><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20M8 7h8M8 10h8" /></svg>
                <span>Katalog Materi</span>
              </a>
              <a class={`nav-item ${active === 'alltagsdeutsch' ? 'active' : ''}`} href="/dashboard/alltags" aria-current={active === 'alltagsdeutsch' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H6l-3 2 1.2-4.1A7.5 7.5 0 1 1 20 11.5Z" /><path d="M8 11h.01M12 11h.01M16 11h.01" /></svg>
                <span>Alltagsdeutsch</span>
              </a>
              <a class={`nav-item ${active === 'fachdeutsch' ? 'active' : ''}`} href="/dashboard/fach" aria-current={active === 'fachdeutsch' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 9-5 9 5-9 5-9-5Z" /><path d="M7 10.2V16c2.8 2.4 7.2 2.4 10 0v-5.8M21 8v7" /></svg>
                <span>Fachdeutsch</span>
              </a>
              <a class={`nav-item ${active === 'profile' ? 'active' : ''}`} href="/dashboard/profil" aria-current={active === 'profile' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                <span>Profil</span>
              </a>
            </>
          )}
        </nav>

        <form class="sidebar-logout" action="/logout" method="post">
          <button type="submit"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3" /><path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" /></svg><span>Logout</span></button>
        </form>
      </aside>

      <div class="private-main-column">
        <main class="private-content"><slot /></main>
        <footer class="private-footer">
          <span>© 2026 siDeutsch. Dibuat untuk mahasiswa Indonesia.</span>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://wa.me/6281288951254" target="_blank" rel="noopener noreferrer">Kontak Admin (WhatsApp)</a>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://ndhistira.my.id" target="_blank" rel="noopener noreferrer">Created by Nanda Yudhistira · Lihat Portofolio</a>
        </footer>
      </div>
    </div>
  </body>
</html>

<script>
  const logo = document.querySelector<HTMLImageElement>('.sidebar-logo img');
  logo?.addEventListener('error', () => {
    const fallback = document.querySelector<HTMLElement>('.sidebar-logo span');
    if (fallback) fallback.hidden = false;
    logo.hidden = true;
  }, { once: true });
</script>

<style is:global>
  :root {
    --bg-main: #F9F9FB;
    --bg-dark: #1A1A1E;
    --accent-gold: #E5A93B;
    --accent-red: #D93838;
    --text-main: #2B2D42;
    --card-bg: #ffffff;
    --muted: #6B7280;
    --border: rgba(43, 45, 66, 0.13);
    --shadow: 0 18px 40px rgba(26, 26, 30, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: var(--bg-main);
    color: var(--text-main);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.6;
  }

  a,
  button {
    color: inherit;
    font: inherit;
    transition: color 0.18s ease, background-color 0.18s ease, border-color 0.18s ease,
      transform 0.18s ease, box-shadow 0.18s ease;
  }

  .private-shell {
    display: grid;
    min-height: 100vh;
    grid-template-columns: 252px minmax(0, 1fr);
  }

  .private-sidebar {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    min-height: 600px;
    flex-direction: column;
    padding: 1.35rem 1rem 1rem;
    background: var(--bg-dark);
    color: #fff;
  }

  .sidebar-logo {
    position: relative;
    display: flex;
    min-height: 48px;
    align-items: center;
    padding: 0.25rem 0.55rem 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    text-decoration: none;
  }

  .sidebar-logo img {
    display: block;
    width: auto;
    height: 40px;
    object-fit: contain;
  }

  .sidebar-logo img[hidden] {
    display: none;
  }

  .sidebar-logo > span {
    position: absolute;
    left: 0.55rem;
    color: #fff;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .sidebar-profile {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
    margin: 1rem 0 1.2rem;
    padding: 0.85rem 0.55rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }

  .sidebar-avatar {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    object-fit: cover;
    background: var(--accent-gold);
    color: var(--bg-dark);
    font-weight: 800;
  }

  .profile-copy {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }

  .profile-copy strong,
  .profile-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .profile-copy strong {
    color: #fff;
    font-size: 0.84rem;
  }

  .profile-copy span {
    color: rgba(255, 255, 255, 0.63);
    font-size: 0.72rem;
  }

  .private-nav {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .nav-item,
  .sidebar-logout button {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.72rem;
    padding: 0.65rem 0.75rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.86rem;
    font-weight: 700;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-icon {
    display: block;
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    color: rgba(255, 255, 255, 0.57);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-item:hover,
  .sidebar-logout button:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transform: translateX(3px);
  }

  .private-content button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 7px 16px rgba(26, 26, 30, 0.14);
  }

  .nav-item.active {
    background: rgba(229, 169, 59, 0.16);
    color: var(--accent-gold);
  }

  .nav-item.active .nav-icon {
    color: var(--accent-gold);
  }

  .sidebar-logout {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  .sidebar-logout button {
    width: 100%;
  }

  .private-main-column {
    display: flex;
    min-width: 0;
    min-height: 100vh;
    flex-direction: column;
  }

  .private-content {
    width: 100%;
    max-width: 1440px;
    flex: 1;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .private-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1rem clamp(1.25rem, 3vw, 2.5rem);
    background: var(--bg-dark);
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.75rem;
  }

  .private-footer a {
    color: var(--accent-gold);
    font-weight: 700;
    text-decoration: none;
  }

  .private-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .private-footer .footer-separator {
    color: rgba(255, 255, 255, 0.42);
  }

  @media (max-width: 820px) {
    .private-shell {
      grid-template-columns: 1fr;
    }

    .private-sidebar {
      position: static;
      height: auto;
      min-height: 0;
      padding: 0.85rem 1rem;
    }

    .sidebar-logo {
      min-height: 42px;
      padding: 0 0.4rem 0.7rem;
    }

    .sidebar-logo img {
      height: 34px;
    }

    .sidebar-profile {
      margin: 0.55rem 0 0.6rem;
      padding: 0.55rem 0.4rem 0.7rem;
    }

    .sidebar-avatar {
      width: 34px;
      height: 34px;
    }

    .private-nav {
      grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
      gap: 0.25rem;
    }

    .nav-item,
    .sidebar-logout button {
      min-height: 40px;
      padding: 0.5rem;
      font-size: 0.78rem;
    }

    .private-content {
      padding: 1.25rem 1rem 2rem;
    }

    .private-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
      padding: 1rem;
    }

    .private-footer .footer-separator {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .private-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
