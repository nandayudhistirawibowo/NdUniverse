---
const {
  title = 'Dashboard | siDeutsch',
  description = 'Portal mahasiswa siDeutsch.',
  variant = 'student',
  active = '',
  user = null,
  profile = null,
} = Astro.props;
import { ClientRouter } from 'astro:transitions';

const isAdmin = variant === 'admin';
const displayName = profile?.nama_lengkap || profile?.nim || user?.user_metadata?.nim || 'Mahasiswa';
const nim = profile?.nim || user?.user_metadata?.nim || '';
const accountInitial = displayName.slice(0, 1).toUpperCase();
const logoFallback = 'siDeutsch';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
      <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <div id="navigation-progress" class="navigation-progress" transition:persist="navigation-progress" aria-hidden="true"></div>
    <div class={`private-shell ${isAdmin ? 'admin-shell' : 'student-shell'}`}>
      <aside class="private-sidebar" id="dashboard-sidebar" aria-label={isAdmin ? 'Navigasi admin' : 'Navigasi mahasiswa'}>
        <div class="sidebar-top-row">
          <a class="sidebar-logo" href={isAdmin ? '/admin' : '/dashboard'} aria-label="siDeutsch">
            <img src="/logo.png" alt="siDeutsch" />
            <span>{logoFallback}</span>
          </a>
          <button class="sidebar-close" type="button" aria-label="Tutup navigasi" aria-controls="dashboard-sidebar">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </button>
        </div>

        {!isAdmin && (
          <div class="sidebar-profile">
            {profile?.avatar_url ? (
              <img class="sidebar-avatar" src={profile.avatar_url} alt="" />
            ) : (
              <span class="sidebar-avatar avatar-initial" aria-hidden="true">{accountInitial}</span>
            )}
            <div class="profile-copy">
              <strong>{displayName}</strong>
              <span>{nim}</span>
            </div>
          </div>
        )}

        <nav class="private-nav">
          {isAdmin ? (
            <a class={`nav-item ${active === 'users' ? 'active' : ''}`} href="/admin" aria-current={active === 'users' ? 'page' : undefined}>
              <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 9h9M8 13h9M8 17h5" /></svg>
              <span>Manajemen User</span>
            </a>
          ) : (
            <>
              <a class={`nav-item ${active === 'home' ? 'active' : ''}`} href="/dashboard" aria-current={active === 'home' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1V10Z" /></svg>
                <span>Beranda</span>
              </a>
              <a class={`nav-item ${active === 'catalog' ? 'active' : ''}`} href="/dashboard/katalog" aria-current={active === 'catalog' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5v-12Z" /><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20M8 7h8M8 10h8" /></svg>
                <span>Katalog Materi</span>
              </a>
              <a class={`nav-item ${active === 'alltagsdeutsch' ? 'active' : ''}`} href="/dashboard/alltags" aria-current={active === 'alltagsdeutsch' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H6l-3 2 1.2-4.1A7.5 7.5 0 1 1 20 11.5Z" /><path d="M8 11h.01M12 11h.01M16 11h.01" /></svg>
                <span>Alltagsdeutsch</span>
              </a>
              <a class={`nav-item ${active === 'fachdeutsch' ? 'active' : ''}`} href="/dashboard/fach" aria-current={active === 'fachdeutsch' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 9-5 9 5-9 5-9-5Z" /><path d="M7 10.2V16c2.8 2.4 7.2 2.4 10 0v-5.8M21 8v7" /></svg>
                <span>Fachdeutsch</span>
              </a>
              <a class={`nav-item ${active === 'profile' ? 'active' : ''}`} href="/dashboard/profil" aria-current={active === 'profile' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                <span>Profil</span>
              </a>
              <a class="nav-item" href="/pengucapan">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 19h16M7 5v14M17 5v14" /><path d="m10 10 2 4 2-4" /></svg>
                <span>Panduan Pengucapan</span>
              </a>
              <a class="nav-item" href="/grammar">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5z" /><path d="M9 8h6M9 12h6M9 16h4" /></svg>
                <span>Tata Bahasa</span>
              </a>
            </>
          )}
        </nav>

        <form class="sidebar-logout" action="/logout" method="post">
          <button type="submit"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3" /><path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" /></svg><span>Logout</span></button>
        </form>
      </aside>

      <button class="sidebar-overlay" type="button" aria-label="Tutup navigasi"></button>

      <div class="private-main-column">
        <header class="mobile-dashboard-header">
          <button
            class="sidebar-toggle"
            type="button"
            aria-label="Buka navigasi"
            aria-expanded="false"
            aria-controls="dashboard-sidebar"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <a href={isAdmin ? '/admin' : '/dashboard'} aria-label="siDeutsch">
            <img src="/logo.png" alt="siDeutsch" />
          </a>
        </header>
        <main class="private-content"><slot /></main>
        <footer class="private-footer">
          <span>© 2026 siDeutsch. Dibuat untuk mahasiswa Indonesia.</span>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://wa.me/6281288951254" target="_blank" rel="noopener noreferrer">Kontak Admin (WhatsApp)</a>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://ndhistira.my.id" target="_blank" rel="noopener noreferrer">Created by Nanda Yudhistira · Lihat Portofolio</a>
        </footer>
      </div>
    </div>
  </body>
</html>

<script>
  const setSidebarOpen = (isOpen: boolean, restoreFocus = false) => {
    const shell = document.querySelector<HTMLElement>('.private-shell');
    const sidebarToggle = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
    shell?.classList.toggle('sidebar-open', isOpen);
    sidebarToggle?.setAttribute('aria-expanded', String(isOpen));
    sidebarToggle?.setAttribute('aria-label', isOpen ? 'Tutup navigasi' : 'Buka navigasi');
    if (!isOpen && restoreFocus) sidebarToggle?.focus();
  };

  let sidebarEventsInitialized = false;
  const initializeSidebar = () => {
    if (sidebarEventsInitialized) return;
    sidebarEventsInitialized = true;

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('.sidebar-toggle')) setSidebarOpen(true);
      else if (event.target.closest('.sidebar-close, .sidebar-overlay')) setSidebarOpen(false, true);
      else if (event.target.closest('.private-sidebar a')) setSidebarOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setSidebarOpen(false, true);
    });

    window.matchMedia('(min-width: 821px)').addEventListener('change', (event) => {
      if (event.matches) setSidebarOpen(false);
    });
  };

  document.addEventListener('astro:page-load', initializeSidebar);
  initializeSidebar();

  document.addEventListener('astro:page-load', () => {
    const logo = document.querySelector<HTMLImageElement>('.sidebar-logo img');
    logo?.addEventListener('error', () => {
      const fallback = document.querySelector<HTMLElement>('.sidebar-logo span');
      if (fallback) fallback.hidden = false;
      logo.hidden = true;
    }, { once: true });
  });

  const progressWindow = window as Window & { __sideDeutschProgressInitialized?: boolean };
  if (!progressWindow.__sideDeutschProgressInitialized) {
    progressWindow.__sideDeutschProgressInitialized = true;
    let progressResetTimer: number | undefined;

    document.addEventListener('astro:before-preparation', () => {
      window.clearTimeout(progressResetTimer);
      const progress = document.querySelector<HTMLElement>('#navigation-progress');
      progress?.classList.remove('is-complete');
      progress?.classList.add('is-loading');
    });

    document.addEventListener('astro:page-load', () => {
      const progress = document.querySelector<HTMLElement>('#navigation-progress');
      if (!progress?.classList.contains('is-loading')) return;

      progress.classList.add('is-complete');
      progressResetTimer = window.setTimeout(() => {
        progress.classList.remove('is-loading', 'is-complete');
      }, 240);
    });
  }
</script>

<style is:global>
  :root {
    --bg-main: #F9F9FB;
    --bg-dark: #1A1A1E;
    --accent-gold: #E5A93B;
    --accent-red: #D93838;
    --text-main: #2B2D42;
    --card-bg: #ffffff;
    --muted: #6B7280;
    --border: rgba(43, 45, 66, 0.13);
    --shadow: 0 18px 40px rgba(26, 26, 30, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: var(--bg-main);
    color: var(--text-main);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.6;
  }

  .navigation-progress {
    position: fixed;
    z-index: 10000;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--accent-gold);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, width 0.18s ease;
  }

  .navigation-progress.is-loading {
    opacity: 1;
    width: 78%;
    transition: opacity 0.08s linear, width 0.9s ease-out;
  }

  .navigation-progress.is-complete {
    opacity: 1;
    width: 100%;
    transition: opacity 0.12s ease, width 0.12s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-progress {
      transition-duration: 0.01ms;
    }
  }

  a,
  button {
    color: inherit;
    font: inherit;
    transition: color 0.18s ease, background-color 0.18s ease, border-color 0.18s ease,
      transform 0.18s ease, box-shadow 0.18s ease;
  }

  .private-shell {
    display: grid;
    min-height: 100vh;
    grid-template-columns: 252px minmax(0, 1fr);
  }

  .private-sidebar {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    min-height: 600px;
    flex-direction: column;
    padding: 1.35rem 1rem 1rem;
    background: var(--bg-dark);
    color: #fff;
  }

  .sidebar-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sidebar-logo {
    position: relative;
    display: flex;
    min-height: 48px;
    align-items: center;
    padding: 0.25rem 0.55rem 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    text-decoration: none;
  }

  .sidebar-close,
  .sidebar-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .sidebar-close:hover,
  .sidebar-toggle:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
  }

  .sidebar-close svg,
  .sidebar-toggle svg {
    width: 22px;
    height: 22px;
  }

  .sidebar-close path,
  .sidebar-toggle path {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .sidebar-overlay {
    display: none;
  }

  .mobile-dashboard-header {
    display: none;
  }

  .sidebar-logo img {
    display: block;
    width: auto;
    height: 40px;
    object-fit: contain;
  }

  .sidebar-logo img[hidden] {
    display: none;
  }

  .sidebar-logo > span {
    position: absolute;
    left: 0.55rem;
    color: #fff;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .sidebar-profile {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
    margin: 1rem 0 1.2rem;
    padding: 0.85rem 0.55rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }

  .sidebar-avatar {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    object-fit: cover;
    background: var(--accent-gold);
    color: var(--bg-dark);
    font-weight: 800;
  }

  .profile-copy {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }

  .profile-copy strong,
  .profile-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .profile-copy strong {
    color: #fff;
    font-size: 0.84rem;
  }

  .profile-copy span {
    color: rgba(255, 255, 255, 0.63);
    font-size: 0.72rem;
  }

  .private-nav {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .nav-item,
  .sidebar-logout button {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.72rem;
    padding: 0.65rem 0.75rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.86rem;
    font-weight: 700;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-icon {
    display: block;
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    color: rgba(255, 255, 255, 0.57);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-item:hover,
  .sidebar-logout button:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transform: translateX(3px);
  }

  .nav-item:focus-visible,
  .sidebar-logout button:focus-visible,
  .sidebar-close:focus-visible,
  .sidebar-toggle:focus-visible {
    outline: 3px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .private-content button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 7px 16px rgba(26, 26, 30, 0.14);
  }

  .nav-item.active {
    background: rgba(229, 169, 59, 0.16);
    color: var(--accent-gold);
  }

  .nav-item.active .nav-icon {
    color: var(--accent-gold);
  }

  .sidebar-logout {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  .sidebar-logout button {
    width: 100%;
  }

  .private-main-column {
    display: flex;
    min-width: 0;
    min-height: 100vh;
    flex-direction: column;
  }

  .private-content {
    width: 100%;
    max-width: 1440px;
    flex: 1;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .private-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1rem clamp(1.25rem, 3vw, 2.5rem);
    background: var(--bg-dark);
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.75rem;
  }

  .private-footer a {
    color: var(--accent-gold);
    font-weight: 700;
    text-decoration: none;
  }

  .private-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .private-footer .footer-separator {
    color: rgba(255, 255, 255, 0.42);
  }

  @media (max-width: 820px) {
    .private-shell {
      display: block;
    }

    .private-sidebar {
      position: fixed;
      z-index: 51;
      top: 0;
      bottom: 0;
      left: 0;
      width: min(300px, calc(100vw - 3rem));
      height: 100vh;
      height: 100dvh;
      min-height: 0;
      overflow-y: auto;
      padding: 1rem;
      box-shadow: 16px 0 36px rgba(0, 0, 0, 0.24);
      transform: translateX(-105%);
      transition: transform 0.28s cubic-bezier(0.2, 0.75, 0.3, 1), visibility 0s linear 0.28s;
      visibility: hidden;
    }

    .private-shell.sidebar-open .private-sidebar {
      transform: translateX(0);
      transition-delay: 0s;
      visibility: visible;
    }

    .sidebar-top-row {
      margin-bottom: 0.9rem;
    }

    .sidebar-logo {
      flex: 1;
      min-height: 44px;
      padding: 0 0.4rem 0.65rem;
    }

    .sidebar-logo img {
      height: 34px;
    }

    .sidebar-close {
      display: grid;
    }

    .sidebar-overlay {
      position: fixed;
      z-index: 50;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      padding: 0;
      background: rgba(10, 12, 16, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.24s ease, visibility 0s linear 0.24s;
      visibility: hidden;
    }

    .private-shell.sidebar-open .sidebar-overlay {
      opacity: 1;
      pointer-events: auto;
      transition-delay: 0s;
      visibility: visible;
    }

    .mobile-dashboard-header {
      position: sticky;
      z-index: 20;
      top: 0;
      display: flex;
      min-height: 60px;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg-main);
    }

    .sidebar-toggle {
      display: grid;
      position: relative;
      z-index: 1;
      min-width: 44px;
      touch-action: manipulation;
      border-color: rgba(26, 26, 30, 0.16);
      background: var(--bg-dark);
    }

    .mobile-dashboard-header img {
      display: block;
      width: auto;
      height: 32px;
      object-fit: contain;
    }

    .sidebar-profile {
      margin: 0.55rem 0 0.6rem;
      padding: 0.55rem 0.4rem 0.7rem;
    }

    .sidebar-avatar {
      width: 34px;
      height: 34px;
    }

    .private-nav {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .nav-item,
    .sidebar-logout button {
      min-height: 40px;
      padding: 0.5rem;
      font-size: 0.78rem;
    }

    .private-content {
      padding: 1.25rem 1rem 2rem;
    }

    .private-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
      padding: 1rem;
    }

    .private-footer .footer-separator {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .private-nav { grid-template-columns: 1fr; }
  }
</style>
