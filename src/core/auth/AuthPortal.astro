---
import { ClientRouter } from 'astro:transitions';

const {
  portal = 'student',
  title = 'Login | NdUniverse',
  eyebrow = 'Portal Belajar',
  heading = 'Halo! Selamat datang kembali.',
  description = 'Masuk dengan email atau NIM kamu.',
  buttonText = 'Masuk ke Portal',
  language = 'id',
} = Astro.props;
const isAdminPortal = portal === 'admin';
const isEnglish = language === 'en';
const isGerman = language === 'de';
const defaultDashboard = isEnglish ? '/en/dashboard' : '/dashboard-de';
---

<!doctype html>
<html lang={isEnglish ? 'en' : isGerman ? 'de' : 'id'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <main class={`auth-screen ${isAdminPortal ? 'admin-portal' : 'student-portal'}`}>
      <section class="auth-story" aria-label={isEnglish ? 'NdUniverse English' : isGerman ? 'NdUniverse German' : 'NdUniverse'}>
        <a class="brand" href="/">NdUniverse<span>.</span></a>
        <div class="story-copy">
          <p class="story-kicker">{isEnglish ? (isAdminPortal ? 'Restricted access' : 'English learning space') : isGerman ? (isAdminPortal ? 'Zugang beschränkt' : 'MODUL JERMAN') : (isAdminPortal ? 'Akses terbatas' : 'MODUL JERMAN')}</p>
          {isAdminPortal && <p class="portal-stamp">{isEnglish ? 'ADMIN PORTAL' : isGerman ? 'ADMIN-BEREICH' : 'PORTAL ADMIN'}</p>}
          <h1>{isEnglish ? <>Build English,<br />one session closer.</> : isGerman ? <>Deutsch lernen,<br />Sitzung für Sitzung mit NdUniverse.</> : <>Belajar Jerman,<br />satu sesi lebih dekat bersama NdUniverse.</>}</h1>
          <p class="story-detail">
            {isEnglish
              ? (isAdminPortal ? 'Manage the NdUniverse learning space and student accounts.' : 'Build a steady English learning habit, one focused session at a time.')
              : isGerman
                ? (isAdminPortal ? 'Verwalten Sie den NdUniverse-Lernbereich und die Benutzerkonten.' : 'Entwickeln Sie eine beständige Lernroutine, Schritt für Schritt.')
                : (isAdminPortal ? 'Kelola ruang belajar dan akun mahasiswa NdUniverse.' : 'Bangun kebiasaan belajar yang terasa ringan, satu sesi setiap kali.')}
          </p>
        </div>
        <p class="story-footer">{isEnglish ? 'NdUniverse · Learn at your own pace' : isGerman ? 'NdUniverse · Lernen Sie in Ihrem eigenen Tempo' : 'NdUniverse · Belajar dengan ritme sendiri'}</p>
      </section>

      <section class="auth-side" aria-labelledby="auth-title">
        <div class="auth-panel">
          {!isAdminPortal && (
            <a class="back-link-top" href="/">
              <span class="arrow-anim" aria-hidden="true">←</span> {isEnglish ? 'Back to NdUniverse' : isGerman ? 'Zurück zu NdUniverse' : 'Kembali ke NdUniverse'}
            </a>
          )}
          <div class="panel-topline">
            <span class="panel-mark" aria-hidden="true">{isAdminPortal ? 'A' : 'S'}</span>
            <span class="portal-label">{isEnglish ? (isAdminPortal ? eyebrow : 'Learning Portal') : isGerman ? (isAdminPortal ? eyebrow : 'Lernportal') : (isAdminPortal ? eyebrow : 'Portal Belajar')}</span>
          </div>
          <h2 id="auth-title">{heading}</h2>
          <p class="panel-description">{description}</p>

          <form id="auth-form" class="auth-form" data-portal={portal} data-default-dashboard={defaultDashboard} data-language={language}>
            <label for="identifier">{isEnglish ? (isAdminPortal ? 'Student ID' : 'Email / Username') : isGerman ? (isAdminPortal ? 'Admin-Kennung' : 'E-Mail / Benutzername') : (isAdminPortal ? 'Nomor Induk Mahasiswa' : 'Email / Username')}</label>
            <input
              id="identifier"
              name="identifier"
              type="text"
              inputmode="text"
              autocomplete="username"
              placeholder={isEnglish ? (isAdminPortal ? 'Enter admin ID' : 'Enter your username or email') : isGerman ? (isAdminPortal ? 'Admin-Kennung eingeben' : 'Benutzername oder E-Mail eingeben') : (isAdminPortal ? 'Masukkan NIM admin' : 'Masukkan username atau email')}
              required
            />

            <label for="password">{isEnglish ? 'Password' : isGerman ? 'Passwort' : 'Kata Sandi'}</label>
            <div class="password-field">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder={isEnglish ? 'Enter your password' : isGerman ? 'Passwort eingeben' : 'Masukkan kata sandi'}
                required
              />
              <button
                class="password-toggle"
                type="button"
                aria-label={isEnglish ? 'Show password' : isGerman ? 'Passwort anzeigen' : 'Tampilkan kata sandi'}
                aria-pressed="false"
                data-password-toggle="password"
              >
                <svg class="eye-open" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z" />
                  <circle cx="12" cy="12" r="2.7" />
                </svg>
                <svg class="eye-closed" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m3 3 18 18M10.6 6.2A10.7 10.7 0 0 1 12 6c6.1 0 9.5 6 9.5 6a16 16 0 0 1-3.1 3.7M6.2 6.3C3.8 7.8 2.5 12 2.5 12s3.4 6 9.5 6c.8 0 1.5-.1 2.2-.3" />
                  <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                </svg>
              </button>
            </div>

            <button id="auth-submit" type="submit">
              <span>{buttonText}</span>
              <span class="motion-arrow" aria-hidden="true">→</span>
            </button>
            <p id="auth-message" class="auth-message" role="status" aria-live="polite"></p>
          </form>
          {!isAdminPortal && (
            <p class="first-login-note">
              {isEnglish ? 'New account? Enter a new email and password, click Sign in, and an account will be created automatically.' : isGerman ? 'Noch kein Konto? Geben Sie eine neue E-Mail und ein Passwort ein, klicken Sie auf Anmelden, und ein Konto wird automatisch erstellt.' : 'Belum punya akun? Masukkan email dan kata sandi baru, klik Masuk, akun akan dibuat otomatis.'}
            </p>
          )}
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  import { createBrowserClient } from '@supabase/ssr';

  document.addEventListener('astro:page-load', () => {
  const form = document.querySelector<HTMLFormElement>('#auth-form');
  const identifierInput = document.querySelector<HTMLInputElement>('#identifier');
  const passwordInput = document.querySelector<HTMLInputElement>('#password');
  const submitButton = document.querySelector<HTMLButtonElement>('#auth-submit');
  const message = document.querySelector<HTMLElement>('#auth-message');
  const isAdminPortal = form?.dataset.portal === 'admin';
  const isEnglish = form?.dataset.language === 'en';
  const isGerman = form?.dataset.language === 'de';
  const adminNims = new Set(['admin', '000000']);
  const localizedText = (english: string, german: string, indonesian: string) =>
    isEnglish ? english : isGerman ? german : indonesian;

  form?.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const target = document.getElementById(toggle.dataset.passwordToggle ?? '');
      if (!(target instanceof HTMLInputElement)) return;
      const isVisible = target.type === 'text';
      target.type = isVisible ? 'password' : 'text';
      toggle.setAttribute('aria-pressed', String(!isVisible));
      toggle.setAttribute('aria-label', isVisible
        ? localizedText('Show password', 'Passwort anzeigen', 'Tampilkan kata sandi')
        : localizedText('Hide password', 'Passwort verbergen', 'Sembunyikan kata sandi'));
    });
  });

  function showMessage(text: string, state: 'error' | 'loading') {
    if (!message) return;
    message.textContent = text;
    message.dataset.state = state;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!identifierInput || !passwordInput || !submitButton || !message) return;

    const identifier = identifierInput.value.trim();
    const isEmail = identifier.includes('@');
    const isValidNim = /^[A-Za-z0-9._-]{3,32}$/.test(identifier);

    if (isAdminPortal && !isValidNim) {
      showMessage(localizedText('Invalid admin ID format.', 'Ungültiges Format der Admin-Kennung.', 'Format NIM admin tidak valid.'), 'error');
      return;
    }

    if (!isAdminPortal && !isEmail && !isValidNim) {
      showMessage(localizedText('Enter a valid email address or an ID with 3-32 characters.', 'Geben Sie eine gültige E-Mail-Adresse oder eine Matrikelnummer mit 3 bis 32 Zeichen ein.', 'Masukkan email yang valid atau NIM 3-32 karakter.'), 'error');
      return;
    }

    const email = isEmail ? identifier.toLowerCase() : `${identifier}@student.sideutsch.com`;
    if (isEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMessage(localizedText('Invalid email format.', 'Ungültiges E-Mail-Format.', 'Format email tidak valid.'), 'error');
      return;
    }

    const studentNim = email.endsWith('@student.sideutsch.com')
      ? email.slice(0, email.indexOf('@'))
      : (!isEmail ? identifier : null);
    const isPrivilegedNim = adminNims.has(String(studentNim ?? '').toLowerCase());

    if (!isAdminPortal && isPrivilegedNim) {
      showMessage(localizedText('Access denied. Please sign in through the admin portal.', 'Zugriff verweigert. Bitte melden Sie sich über das Admin-Portal an.', 'Akses ditolak. Silakan login melalui portal admin.'), 'error');
      return;
    }

    if (isAdminPortal && !isPrivilegedNim) {
      showMessage(localizedText('Access denied. Use an admin ID to access this portal.', 'Zugriff verweigert. Verwenden Sie eine Admin-Kennung für dieses Portal.', 'Akses ditolak. Gunakan NIM admin untuk masuk ke portal ini.'), 'error');
      return;
    }

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if (!supabaseUrl || !supabaseAnonKey) {
      showMessage(localizedText('Supabase configuration is unavailable.', 'Die Supabase-Konfiguration ist nicht verfügbar.', 'Konfigurasi Supabase belum tersedia.'), 'error');
      return;
    }

    const supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);
    const redirect = new URLSearchParams(window.location.search).get('redirect');
    const defaultDashboard = form?.dataset.defaultDashboard ?? '/dashboard';
    const isSafeStudentRedirect = redirect && !redirect.startsWith('//') && (
      redirect === '/en/dashboard'
      || redirect.startsWith('/en/dashboard/')
      || redirect === '/dashboard-de'
      || redirect.startsWith('/dashboard-de/')
    );
    const safeRedirect = isAdminPortal
      ? (redirect?.startsWith('/admin') && !redirect.startsWith('//') && redirect !== '/admin/login' ? redirect : '/admin')
      : (isSafeStudentRedirect ? redirect : defaultDashboard);

    submitButton.disabled = true;
    showMessage(localizedText('Checking account...', 'Konto wird überprüft...', 'Memeriksa akun...'), 'loading');

    async function prepareProfile(user: { id: string; user_metadata?: Record<string, unknown> }) {
      const { data: profile, error: profileError } = await supabase
        .from('profiles')
        .select('id, nim')
        .eq('id', user.id)
        .maybeSingle();

      if (profileError) throw new Error(localizedText('Unable to verify the account profile.', 'Das Kontoprofil konnte nicht überprüft werden.', 'Profil akun gagal diperiksa.'));
      if (profile && adminNims.has(String(profile.nim ?? '').trim().toLowerCase())) {
        await supabase.auth.signOut();
        throw new Error(localizedText('Access denied. Please sign in through the admin portal.', 'Zugriff verweigert. Bitte melden Sie sich über das Admin-Portal an.', 'Akses ditolak. Silakan login melalui portal admin.'));
      }

      if (!profile) {
        const profileNim = studentNim
          ?? (typeof user.user_metadata?.nim === 'string' ? user.user_metadata.nim : null);
        const { error: saveProfileError } = await supabase.from('profiles').upsert({
          id: user.id,
          nim: profileNim,
          nama_lengkap: profileNim || 'Member',
        }, { onConflict: 'id' });

        if (saveProfileError) throw new Error(localizedText('Unable to create the account profile. Try again or contact an administrator.', 'Das Kontoprofil konnte nicht erstellt werden. Versuchen Sie es erneut oder wenden Sie sich an den Support.', 'Profil akun gagal dibuat. Coba lagi atau hubungi admin.'));
      }
    }

    try {
      const { data: signInData, error: signInError } = await supabase.auth.signInWithPassword({
        email,
        password: passwordInput.value,
      });

      if (!signInError && signInData.user) {
        if (isAdminPortal) {
          const { data: profile, error: profileError } = await supabase
            .from('profiles')
            .select('nim')
            .eq('id', signInData.user.id)
            .maybeSingle();

          if (profileError || !adminNims.has(String(profile?.nim ?? '').trim().toLowerCase())) {
            await supabase.auth.signOut();
            throw new Error(localizedText('Access denied. This account is not registered as an administrator.', 'Zugriff verweigert. Dieses Konto ist nicht als Administratorkonto registriert.', 'Akses ditolak. Akun ini tidak terdaftar sebagai admin.'));
          }
        } else {
          await prepareProfile(signInData.user);
        }

        window.location.assign(safeRedirect);
        return;
      }

      const invalidCredentials = signInError?.code === 'invalid_credentials'
        || signInError?.message === 'Invalid login credentials';

      if (!invalidCredentials || isAdminPortal || isPrivilegedNim) {
        throw new Error(isAdminPortal
          ? localizedText('Admin sign-in failed. Check the admin ID and password.', 'Die Admin-Anmeldung ist fehlgeschlagen. Überprüfen Sie die Admin-Kennung und das Passwort.', 'Login admin gagal. Periksa NIM dan password admin.')
          : localizedText('Sign-in failed. Check your connection and email or ID format.', 'Die Anmeldung ist fehlgeschlagen. Überprüfen Sie Ihre Verbindung und das Format Ihrer E-Mail-Adresse oder Matrikelnummer.', 'Login gagal. Periksa koneksi dan format email atau NIM.'));
      }

      showMessage(localizedText('Account not found. Creating account...', 'Konto nicht gefunden. Konto wird erstellt...', 'Akun belum ditemukan. Membuat akun...'), 'loading');
      const { data: signUpData, error: signUpError } = await supabase.auth.signUp({
        email,
        password: passwordInput.value,
        options: {
          data: {
            nim: studentNim,
            nama_lengkap: studentNim || 'Member',
          },
        },
      });

      const accountAlreadyExists = signUpError?.code === 'user_already_exists'
        || /already registered|already exists/i.test(signUpError?.message ?? '')
        || signUpData.user?.identities?.length === 0;
      if (accountAlreadyExists) {
        throw new Error(localizedText('This email or ID is already registered, but the password is incorrect.', 'Diese E-Mail-Adresse oder Matrikelnummer ist bereits registriert, aber das Passwort ist falsch.', 'Email/NIM sudah terdaftar, tetapi password salah.'));
      }
      if (signUpError || !signUpData.user) {
        throw new Error(localizedText('Unable to create the account. Check your email and password, then try again.', 'Das Konto konnte nicht erstellt werden. Überprüfen Sie Ihre E-Mail-Adresse und Ihr Passwort und versuchen Sie es erneut.', 'Akun gagal dibuat. Periksa email dan password, lalu coba lagi.'));
      }

      showMessage(localizedText('Account created. Preparing your sign-in session...', 'Konto erstellt. Anmeldung wird vorbereitet...', 'Akun dibuat. Menyiapkan sesi login...'), 'loading');
      const { data: newSignInData, error: newSignInError } = await supabase.auth.signInWithPassword({
        email,
        password: passwordInput.value,
      });

      if (newSignInError || !newSignInData.user) {
        throw new Error(localizedText('Account created, but it is not ready to use. Check your email confirmation or try again.', 'Das Konto wurde erstellt, ist aber noch nicht einsatzbereit. Überprüfen Sie Ihre E-Mail-Bestätigung oder versuchen Sie es erneut.', 'Akun berhasil dibuat, tetapi belum dapat digunakan. Periksa konfirmasi email atau coba lagi.'));
      }

      await prepareProfile(newSignInData.user);
      window.location.assign(safeRedirect);
    } catch (error) {
      submitButton.disabled = false;
      showMessage(
        error instanceof Error ? error.message : localizedText('Sign-in connection failed. Check your network and try again.', 'Die Verbindung zur Anmeldung ist fehlgeschlagen. Überprüfen Sie Ihr Netzwerk und versuchen Sie es erneut.', 'Koneksi login gagal. Periksa jaringan lalu coba lagi.'),
        'error'
      );
    }
  });
  });
</script>

<style>
  :root {
    --bg-dark: #1A1A1E;
    --gold: #E5A93B;
    --accent-gold: var(--gold);
    --red: #D93838;
    --paper: #F9F9FB;
    --muted: #A7A7B0;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-width: 320px;
    min-height: 100%;
    margin: 0;
  }

  body {
    background: var(--bg-dark);
    color: var(--paper);
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  a,
  button {
    transition: all 0.2s ease;
  }

  .auth-screen {
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    grid-template-columns: minmax(0, 1.05fr) minmax(390px, 0.95fr);
    background: var(--bg-dark);
  }

  .auth-story {
    position: relative;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 6rem);
    background:
      linear-gradient(135deg, rgba(229, 169, 59, 0.07), transparent 38%),
      repeating-linear-gradient(135deg, transparent 0 42px, rgba(255, 255, 255, 0.018) 43px 44px),
      #202024;
  }

  .brand {
    width: fit-content;
    color: var(--paper);
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
  }

  .brand span {
    color: var(--gold);
  }

  .story-copy {
    max-width: 650px;
    padding: 3rem 0;
  }

  .story-kicker,
  .portal-label {
    margin: 0;
    color: var(--gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .portal-stamp {
    display: table;
    margin: 1rem 0 0;
    padding: 0.38rem 0.62rem;
    border: 1px solid rgba(229, 169, 59, 0.46);
    color: var(--gold);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .story-copy h1 {
    margin: 1rem 0 0;
    color: var(--paper);
    font-size: clamp(2.7rem, 5vw, 5.3rem);
    line-height: 1.07;
  }

  .story-detail {
    max-width: 410px;
    margin: 1.3rem 0 0;
    color: #B5B5BD;
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .story-footer {
    margin: 0;
    color: #85858F;
    font-size: 0.75rem;
  }

  .auth-side {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 4rem);
    background: #17171A;
  }

  .auth-panel {
    width: min(100%, 440px);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: var(--bg-dark);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
  }

  .panel-topline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.55rem;
  }

  .back-link-top {
    display: block;
    margin-bottom: 1.5rem;
    color: var(--accent-gold);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link-top:hover {
    color: #F0B84F;
    text-decoration: underline;
  }

  .arrow-anim {
    display: inline-block;
    animation: arrow-move 1.4s ease-in-out infinite;
  }

  @keyframes arrow-move {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-4px); }
  }

  .motion-arrow {
    display: inline-block;
    animation: arrow-drift 1.4s ease-in-out infinite;
  }

  @keyframes arrow-drift {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }

  .panel-mark {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(229, 169, 59, 0.42);
    border-radius: 8px;
    background: rgba(229, 169, 59, 0.12);
    color: var(--gold);
    font-weight: 800;
  }

  .auth-panel h2 {
    margin: 0;
    color: var(--paper);
    font-size: 1.8rem;
  }

  .panel-description {
    margin: 0.5rem 0 1.6rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .auth-form {
    display: grid;
    gap: 0.62rem;
  }

  .auth-form label {
    margin-top: 0.25rem;
    color: #E2E2E6;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .auth-form input {
    width: 100%;
    min-height: 48px;
    padding: 0.72rem 0.85rem;
    border: 1px solid #44444C;
    border-radius: 7px;
    outline: none;
    background: #222226;
    color: var(--paper);
    font: inherit;
  }

  .password-field {
    position: relative;
  }

  .auth-form .password-field input {
    padding-right: 3.1rem;
  }

  .password-toggle {
    position: absolute;
    top: 50%;
    right: 0.55rem;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    padding: 0;
    transform: translateY(-50%);
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #A7A7B0;
    cursor: pointer;
  }

  .password-toggle:hover {
    color: var(--gold);
  }

  .password-toggle:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .password-toggle svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .password-toggle .eye-closed,
  .password-toggle[aria-pressed='true'] .eye-open {
    display: none;
  }

  .password-toggle[aria-pressed='true'] .eye-closed {
    display: block;
  }

  .auth-form input::placeholder {
    color: #777780;
  }

  .auth-form input:focus-visible {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(229, 169, 59, 0.17);
  }

