---
import type { CollectionEntry } from 'astro:content';
import { clampMaterialXp, MAX_MATERIAL_XP } from '@core/db/progress-xp.js';

type ProgressRow = {
  material_slug: string;
  sessions_passed?: unknown;
  xp?: number;
};

interface Props {
  materials: CollectionEntry<'materi'>[];
  progressRows: ProgressRow[];
  materialHrefPrefix?: string;
}

const { materials = [], progressRows = [], materialHrefPrefix = '/materi' } = Astro.props;
const progressBySlug = new Map<string, ProgressRow>(
  progressRows.map((row) => [row.material_slug, row])
);
const cards = materials.map((material) => {
  const row = progressBySlug.get(material.id);
  const maxXp = MAX_MATERIAL_XP;
  const xp = clampMaterialXp(row?.xp);
  const percentage = Math.round((xp / maxXp) * 100);

  return {
    material,
    maxXp,
    xp,
    percentage,
  };
});
---

<div class="material-grid">
  {cards.map(({ material, maxXp, xp, percentage }) => (
    <a class="material-card" href={`${materialHrefPrefix}/${material.id}`} data-material-level={material.data.level ?? ''} data-progress-slug={material.id} data-progress-language="de" data-max-xp={maxXp}>
      <div class="material-topline">
        <span class="material-track">{material.data.track}</span>
        <span class="material-percent" data-progress-percent>{percentage}%</span>
      </div>
      <h2>{material.data.judulMateri}</h2>
      <p class="material-description">{material.data.deskripsi}</p>
      <div class="material-meta">
        {material.data.level && <span class="level-badge">{material.data.level}</span>}
        {material.data.jurusan && <span>{material.data.jurusan}</span>}
      </div>
      <div class="progress-copy">
        <span
          data-progress-copy
        >{xp >= maxXp ? 'Selesai (100%)' : (xp === 0 ? 'Belum dimulai' : `${xp} / ${maxXp} XP`)}</span>
        <span>{material.data.vocab.length} kosakata</span>
      </div>
      <div
        class="progress-track"
        role="progressbar"
        aria-label={`Progress ${material.data.judulMateri}`}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={percentage}
        data-progress-bar
      >
        <span data-progress-fill style={`width: ${percentage}%`} />
      </div>
      <span class="material-action"><span>Buka materi</span> <span aria-hidden="true">→</span></span>
    </a>
  ))}
</div>

<script>
  import { MAX_MATERIAL_XP } from '@core/db/progress-xp.js';

  window.addEventListener('nd:progress-updated', (event) => {
    const { slug, languageCode, xp } = (event as CustomEvent<{
      slug: string;
      languageCode: string;
      xp: number;
    }>).detail;
    if (languageCode !== 'de') return;

    document.querySelectorAll<HTMLElement>('[data-progress-slug]').forEach((card) => {
      if (card.dataset.progressSlug !== slug) return;
      const currentXp = Math.min(MAX_MATERIAL_XP, Math.max(0, Number(xp) || 0));
      const percentage = Math.round((currentXp / MAX_MATERIAL_XP) * 100);
      const copy = card.querySelector<HTMLElement>('[data-progress-copy]');
      const percent = card.querySelector<HTMLElement>('[data-progress-percent]');
      const bar = card.querySelector<HTMLElement>('[data-progress-bar]');
      const fill = card.querySelector<HTMLElement>('[data-progress-fill]');
      if (copy) {
        copy.textContent = currentXp >= MAX_MATERIAL_XP
          ? 'Selesai (100%)'
          : (currentXp === 0 ? 'Belum dimulai' : `${currentXp} / ${MAX_MATERIAL_XP} XP`);
      }
      if (percent) percent.textContent = `${percentage}%`;
      if (bar) bar.setAttribute('aria-valuenow', String(percentage));
      if (fill) fill.style.width = `${percentage}%`;
    });
  });
</script>

<style>
  .material-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
  }

  .material-card[hidden] {
    display: none;
  }

  .material-card {
    display: flex;
    min-width: 0;
    min-height: 300px;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    color: var(--text-main);
    text-decoration: none;
    box-shadow: 0 5px 15px rgba(26, 26, 30, 0.05);
    transition: all 0.2s ease;
  }

  @media (hover: hover) {
    .material-card:hover {
      transform: translateY(-5px);
      border-color: var(--accent-gold);
      box-shadow: 0 14px 28px rgba(26, 26, 30, 0.14);
    }
  }
  @media (hover: none) {
    .material-card:active {
      transform: translateY(-5px);
      border-color: var(--accent-gold);
      box-shadow: 0 14px 28px rgba(26, 26, 30, 0.14);
    }
  }

  .material-card h2 { font-size: 1.35rem; }

  .material-topline,
  .progress-copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .material-track {
    color: var(--accent-gold);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .material-percent {
    color: var(--accent-red);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .material-card h2 {
    margin: 0.75rem 0 0.4rem;
    font-size: 1rem;
    line-height: 1.4;
  }

  .material-description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .material-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .material-meta span {
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--bg-main);
    color: var(--text-main);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .material-card[data-material-level="A1"],
  .material-card[data-material-level="A2"] {
    --level-accent: #10B981;
  }

  .material-card[data-material-level="B1"],
  .material-card[data-material-level="B2"] {
    --level-accent: #3B82F6;
  }

  .material-card[data-material-level="C1"],
  .material-card[data-material-level="C2"] {
    --level-accent: #7C3AED;
  }

  .material-meta .level-badge {
    border-radius: 999px;
    background: var(--level-accent, var(--accent-gold));
    color: #071019;
  }

  .material-card[data-material-level="B1"] .material-meta .level-badge,
  .material-card[data-material-level="B2"] .material-meta .level-badge,
  .material-card[data-material-level="C1"] .material-meta .level-badge,
  .material-card[data-material-level="C2"] .material-meta .level-badge {
    color: #FFFFFF;
  }

  .progress-copy {
    margin-top: auto;
    padding-top: 0.9rem;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .progress-track {
    overflow: hidden;
    height: 6px;
    margin-top: 0.4rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
  }

  .progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent-gold);
    transition: width 0.2s ease;
  }

  .material-action {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    color: var(--level-accent, var(--text-main));
    font-size: 0.75rem;
    font-weight: 800;
  }

</style>
