---
import DashboardLayout from '@core/ui/DashboardLayout.astro';
import DashboardMaterialGrid from './DashboardMaterialGrid.astro';
import HelpHint from './HelpHint.jsx';

const {
  title,
  eyebrow,
  description,
  active,
  user,
  profile,
  materials,
  progressRows,
  backHref = '/dashboard',
  backLabel = 'Kembali ke Dashboard',
  materialHrefPrefix = '/materi',
  examHref,
  examLabel,
} = Astro.props;
const helpText = active === 'alltagsdeutsch'
  ? 'Pilih materi, pelajari kosakata per sesi, lalu latih 4 pilar CEFR (Reading, Listening, Writing, Speaking).'
  : 'Pilih materi Fachdeutsch untuk mempelajari kosakata teknis yang relevan dengan bidang studimu.';
---

<DashboardLayout title={`${title} | NdUniverse`} active={active} user={user} profile={profile}>
  <section class="catalog-page">
    <a class="back-link" href={backHref} aria-label="Kembali ke halaman sebelumnya">
      <span aria-hidden="true">←</span>
      <span>{backLabel}</span>
    </a>
    <header class="page-heading">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <div class="page-heading-title">
          <h1>{title}</h1>
          <HelpHint title="Belajar Bertahap" text={helpText} client:load />
        </div>
        <p>{description}</p>
      </div>
      <div class="heading-actions">
        {examHref && (
          <a class="exam-button" href={examHref}>{examLabel ?? `Mulai Ujian ${title.split(' ').at(-1)}`}</a>
        )}
      </div>
    </header>
    <DashboardMaterialGrid
      materials={materials}
      progressRows={progressRows}
      materialHrefPrefix={materialHrefPrefix}
    />
  </section>
</DashboardLayout>

<style>
  .catalog-page {
    display: grid;
    gap: 1.25rem;
  }

  .back-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-main);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.18s ease, color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
  }

  .back-link:hover {
    border-color: var(--accent-gold);
    background: rgba(229, 169, 59, 0.08);
    color: var(--accent-gold);
    transform: translateX(-2px);
  }

  .back-link span:first-child {
    font-size: 1rem;
    line-height: 1;
  }

  .page-heading h1 {
    margin: 0;
    color: var(--text-main);
    font-size: 2rem;
  }

  .page-heading-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .exam-button {
    flex: 0 0 auto;
    padding: 0.72rem 1rem;
    border: 1px solid var(--accent-gold);
    border-radius: 0.65rem;
    color: #966313;
    background: rgba(229, 169, 59, 0.09);
    font-weight: 800;
    text-decoration: none;
  }

  .heading-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem;
  }


  @media (max-width: 700px) {
    .page-heading { align-items: flex-start; flex-direction: column; }
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    color: #966313;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .page-heading > p:last-child {
    margin: 0.45rem 0 0;
    color: var(--muted);
  }

  .level-filter {
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .level-filter select {
    min-width: 150px;
    min-height: 40px;
    padding: 0.5rem 2rem 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    color: var(--text-main);
    font: inherit;
    cursor: pointer;
  }

  .level-filter select:focus-visible {
    outline: 3px solid rgba(229, 169, 59, 0.24);
    border-color: var(--accent-gold);
  }

  .level-filter [data-level-filter-count] {
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
