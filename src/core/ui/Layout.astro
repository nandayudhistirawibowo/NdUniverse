---
import { ClientRouter } from 'astro:transitions';
import { createAvatarSignedUrl } from '@core/auth/avatar';
import FeedbackModal from '@core/ui/FeedbackModal.jsx';

const {
  title = 'NdUniverse - Platform Belajar Bahasa',
  description = 'Platform belajar bahasa Jerman interaktif untuk siapa saja. 8.000+ kosakata, kuis A1-C2, Alltagsdeutsch, Fachdeutsch, dan persiapan karir.',
  image = '/android-chrome-512x512.png',
  hideNavbar = false,
} = Astro.props;

const siteUrl = Astro.site ?? 'https://nduniverse.ndhistira.my.id';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const imageURL = new URL(image, siteUrl).toString();
const user = Astro.locals.user;
const profile = Astro.locals.profile;
const accountName = profile?.nama_lengkap || user?.user_metadata?.nama_lengkap || profile?.nim || user?.user_metadata?.nim || 'Member';
const accountInitial = accountName.slice(0, 1).toUpperCase();
const accountAvatarUrl = await createAvatarSignedUrl(Astro.locals.supabase, profile?.avatar_url);
const isAdminArea = Astro.url.pathname.startsWith('/admin');
const isAdminLogin = Astro.url.pathname === '/admin/login';
const isAdminAccount = ['admin', '000000'].includes(String(profile?.nim ?? '').toLowerCase());
const accountHref = isAdminAccount ? '/admin' : '/dashboard';
const isEnglishRoute = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const loginHref = isEnglishRoute ? '/login-en' : '/login-de';
const languageHref = isEnglishRoute ? '/de' : '/en';
const languageLabel = isEnglishRoute ? 'Deutsch' : 'English';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'NdUniverse',
  description: 'Platform belajar bahasa Jerman interaktif untuk siapa saja. 8.000+ kosakata, kuis A1-C2, Alltagsdeutsch, Fachdeutsch, dan persiapan karir.',
  url: siteUrl,
  logo: new URL('/logo.png', siteUrl).toString(),
  sameAs: ['https://nduniverse.ndhistira.my.id'],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta property="og:site_name" content="NdUniverse" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <div id="navigation-progress" class="navigation-progress" transition:persist="navigation-progress" aria-hidden="true"></div>
    <div class="site-shell">
      {!hideNavbar && (
        <header class="topbar">
          <nav class="navbar" aria-label="Navigasi utama">
            <a href="/" class="brand" aria-label="NdUniverse">
              <img src="/logo-nduniverse.png" alt="NdUniverse" style="height: 35px;" />
            </a>
            <button
              class="menu-toggle"
              type="button"
              aria-label="Buka menu"
              aria-expanded="false"
              aria-controls="primary-navigation"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 6h16" />
                <path d="M4 12h16" />
                <path d="M4 18h16" />
              </svg>
            </button>
            <div class="nav-panel" id="primary-navigation">
              <div class="nav-links">
                {isAdminArea ? (
                  <span class="nav-context">Administrasi</span>
                ) : (
                  <>
                    <a href="/">Home</a>
                    <a href="/materi">Semua Materi</a>
                    <a href="/pengucapan">Panduan Pengucapan</a>
                    <a href="/grammar">Tata Bahasa</a>
                    <a href="/panduan">Bantuan</a>
                  </>
                )}
              </div>
              {!isAdminArea && (
                <a class="language-switch" href={languageHref} aria-label={`Switch language to ${languageLabel}`}>
                  {languageLabel}
                </a>
              )}
              <div class="mobile-feedback">
                {!isAdminLogin && <FeedbackModal client:load variant="mobile" />}
              </div>
              <div class="nav-account" data-nav-account>
                {!isAdminLogin && (user ? (
                  <a class="account-link" href={accountHref} aria-label={`${isAdminAccount ? 'Admin Panel' : 'Dashboard pengguna'} ${accountName}`}>
                    <img src={accountAvatarUrl ?? ''} alt="" data-avatar-image hidden={!accountAvatarUrl} />
                    <span class="account-initial" data-avatar-fallback aria-hidden="true" hidden={!!accountAvatarUrl}>{accountInitial}</span>
                    <span class="account-name">{accountName}</span>
                  </a>
                ) : (
                  <a class="login-link" href={loginHref}>Login</a>
                ))}
              </div>
            </div>
          </nav>
        </header>
      )}

      <main class="page-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <p>© 2026 NdUniverse. Connecting Languages & Cultures.</p>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://wa.me/6281288951254" target="_blank" rel="noopener noreferrer">Kontak Admin (WhatsApp)</a>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://ndhistira.my.id" target="_blank" rel="noopener noreferrer">Created by Nanda Yudhistira · Lihat Portofolio</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<script>
  const closeMenu = () => {
    const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const topbar = document.querySelector<HTMLElement>('.topbar');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Buka menu');
    topbar?.classList.remove('menu-open');
  };

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  document.addEventListener('click', (event) => {
    const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const topbar = document.querySelector<HTMLElement>('.topbar');
    if (menuToggle?.getAttribute('aria-expanded') === 'true' && !topbar?.contains(event.target as Node)) {
      closeMenu();
    }
  });

  import { createAvatarSignedUrl } from '@core/auth/avatar';

  const progressWindow = window as Window & { __sideDeutschProgressInitialized?: boolean };
  if (!progressWindow.__sideDeutschProgressInitialized) {
    progressWindow.__sideDeutschProgressInitialized = true;
    let progressResetTimer: number | undefined;

    document.addEventListener('astro:before-preparation', () => {
      window.clearTimeout(progressResetTimer);
      const progress = document.querySelector<HTMLElement>('#navigation-progress');
      progress?.classList.remove('is-complete');
      progress?.classList.add('is-loading');
    });

    document.addEventListener('astro:page-load', () => {
      const progress = document.querySelector<HTMLElement>('#navigation-progress');
      if (!progress?.classList.contains('is-loading')) return;

      progress.classList.add('is-complete');
      progressResetTimer = window.setTimeout(() => {
        progress.classList.remove('is-loading', 'is-complete');
      }, 240);
    });
  }

  const refreshAccount = async () => {
    const accountSlot = document.querySelector<HTMLElement>('[data-nav-account]');
    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    if (!accountSlot || !supabaseUrl || !supabaseAnonKey) return;

    const { createBrowserClient } = await import('@supabase/ssr');
    const supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);
    const { data: { user } } = await supabase.auth.getUser();

    if (user && accountSlot.isConnected) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('nim, nama_lengkap, avatar_url')
        .eq('id', user.id)
        .maybeSingle();
      const name = profile?.nama_lengkap || profile?.nim || user.user_metadata?.nim || 'Member';
      const isAdmin = ['admin', '000000'].includes(String(profile?.nim ?? '').toLowerCase());
      const accountLink = document.createElement('a');
      accountLink.className = 'account-link';
      accountLink.href = isAdmin ? '/admin' : '/dashboard';
      accountLink.setAttribute('aria-label', `${isAdmin ? 'Admin Panel' : 'Dashboard pengguna'} ${name}`);

      const avatarUrl = await createAvatarSignedUrl(supabase, profile?.avatar_url);
      if (avatarUrl) {
        const avatar = document.createElement('img');
        avatar.src = avatarUrl;
        avatar.alt = '';
        avatar.dataset.avatarImage = '';
        avatar.addEventListener('error', () => {
          const fallback = document.createElement('span');
          fallback.className = 'account-initial';
          fallback.setAttribute('aria-hidden', 'true');
          fallback.textContent = name.slice(0, 1).toUpperCase();
          avatar.replaceWith(fallback);
        }, { once: true });
        accountLink.append(avatar);
      } else {
        const initial = document.createElement('span');
        initial.className = 'account-initial';
        initial.setAttribute('aria-hidden', 'true');
        initial.textContent = name.slice(0, 1).toUpperCase();
        accountLink.append(initial);
      }

      const accountName = document.createElement('span');
      accountName.className = 'account-name';
      accountName.textContent = name;
      accountLink.append(accountName);
      accountSlot.replaceChildren(accountLink);
    }
  };

  const scheduleAccountRefresh = () => {
    const idleWindow = window as Window & {
      requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
    };

    if (idleWindow.requestIdleCallback) {
      idleWindow.requestIdleCallback(() => void refreshAccount(), { timeout: 1500 });
    } else {
      window.setTimeout(() => void refreshAccount(), 0);
    }
  };

  document.addEventListener('astro:page-load', () => {
    const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const navPanel = document.querySelector<HTMLElement>('#primary-navigation');
    const topbar = document.querySelector<HTMLElement>('.topbar');

    menuToggle?.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Buka menu' : 'Tutup menu');
      topbar?.classList.toggle('menu-open', !isOpen);
    });

    document.addEventListener('error', (event) => {
      if (!(event.target instanceof HTMLImageElement) || !event.target.matches('[data-avatar-image]')) return;
      event.target.hidden = true;
      const fallback = event.target.parentElement?.querySelector<HTMLElement>('[data-avatar-fallback]');
      if (fallback) fallback.hidden = false;
    }, true);

    navPanel?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) closeMenu();
    });

    scheduleAccountRefresh();
  });
</script>

<style is:global>
  :root {
    --bg-main: #F9F9FB;
    --bg-dark: #1A1A1E;
    --accent-gold: #E5A93B;
    --accent-red: #D93838;
    --text-main: #2B2D42;
    --bg-light: var(--bg-main);
    --card-bg: #ffffff;
    --text-dark: var(--text-main);
    --primary-blue: var(--accent-gold);
    --primary-hover: #C98D23;
    --bg: var(--bg-main);
    --bg-soft: #FFF4DC;
    --surface: var(--card-bg);
    --text: var(--text-main);
    --muted: #6B7280;
    --primary: var(--accent-gold);
    --primary-dark: var(--primary-hover);
    --accent: var(--accent-gold);
    --danger: var(--accent-red);
    --border: rgba(43, 45, 66, 0.13);
    --shadow: 0 18px 40px rgba(26, 26, 30, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
    margin: 0;
    background: var(--bg-main);
    color: var(--text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.6;
  }

  .navigation-progress {
    position: fixed;
    z-index: 10000;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--accent-gold);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, width 0.18s ease;
  }

  .navigation-progress.is-loading {
    opacity: 1;
    width: 78%;
    transition: opacity 0.08s linear, width 0.9s ease-out;
  }

  .navigation-progress.is-complete {
    opacity: 1;
    width: 100%;
    transition: opacity 0.12s ease, width 0.12s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-progress {
      transition-duration: 0.01ms;
    }
  }

  a,
  button {
    color: inherit;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease,
      transform 0.2s ease, box-shadow 0.2s ease;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  .site-shell {
    min-height: 100vh;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
    background: var(--bg-dark);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }

  .navbar {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-style: normal;
  }

  .brand {
    text-decoration: none;
    color: #fff;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .brand img {
    display: block;
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .brand span {
    color: #fff;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .language-switch {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgba(229, 169, 59, 0.55);
    border-radius: 999px;
    color: var(--accent-gold);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .language-switch:hover,
  .language-switch:focus-visible {
    background: rgba(229, 169, 59, 0.12);
    border-color: var(--accent-gold);
  }

  .nav-account {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .mobile-feedback {
    display: none;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .menu-toggle:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
  }

  .menu-toggle svg {
    width: 23px;
    height: 23px;
  }

  .menu-toggle path {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded='true'] path:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] path:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] path:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav-links a {
    position: relative;
    padding: 0.4rem 0;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .nav-links a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-gold);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--accent-gold);
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-context {
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .login-link {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--accent-gold);
    border-radius: 8px;
    background: var(--accent-gold);
    color: var(--bg-dark);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .login-link:hover {
    background: #F0B84F;
    border-color: #F0B84F;
  }

  .account-link {
    display: inline-flex;
    max-width: 220px;
    min-height: 40px;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem 0.65rem 0.25rem 0.3rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
  }

  .account-link img,
  .account-initial {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    object-fit: cover;
    background: var(--accent-gold);
    color: var(--bg-dark);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .account-name {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.82rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-link:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.48);
  }

  .page-content {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .site-footer {
    background: var(--bg-dark);
    color: #ffffff;
  }

  .footer-inner {
    display: flex;
    max-width: 1180px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 auto;
    padding: 1.25rem;
    font-size: 0.8rem;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-inner a {
    color: var(--accent-gold);
    font-weight: 700;
    text-decoration: none;
  }

  .footer-inner a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-inner span {
    color: rgba(255, 255, 255, 0.75);
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--text);
    line-height: 1.2;
  }

  p {
    margin-top: 0;
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 0.7rem 1rem;
      gap: 0.75rem;
    }

    .menu-toggle {
      display: grid;
      margin-left: auto;
    }

    .nav-panel {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 21;
      display: flex;
      max-height: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      overflow: hidden;
      padding: 0 1rem;
      border-bottom: 1px solid transparent;
      background: var(--bg-dark);
      box-shadow: 0 14px 24px rgba(0, 0, 0, 0.2);
      opacity: 0;
      transform: translateY(-8px);
      transition: max-height 0.28s ease, padding 0.2s ease, opacity 0.2s ease,
        transform 0.2s ease, visibility 0.2s ease;
      visibility: hidden;
    }

    .topbar.menu-open .nav-panel {
      max-height: min(70vh, 420px);
      overflow-y: auto;
      padding: 0.65rem 1rem 1rem;
      border-bottom-color: rgba(255, 255, 255, 0.14);
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
    }

    .language-switch {
      justify-content: center;
      min-height: 44px;
      margin: 0.45rem 0;
    }

    .nav-links a {
      padding: 0.7rem 0.25rem;
    }

    .nav-links a::after {
      right: auto;
      width: 2.5rem;
    }

    .mobile-feedback {
      display: block;
      width: 100%;
      padding: 0.25rem 0 0.55rem;
    }

    .nav-account {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      padding-top: 0.7rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .login-link {
      width: 100%;
      min-height: 44px;
    }

    .account-link {
      max-width: 100%;
      min-height: 44px;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
      padding: 1.25rem 1rem;
    }

    .footer-separator {
      display: none;
    }
  }
</style>
