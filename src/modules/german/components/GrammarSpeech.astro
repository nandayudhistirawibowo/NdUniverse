---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="grammar-speech-unit">
  <span lang="de">{text}</span>
  <button
    class="grammar-speech-button audio-btn"
    type="button"
    data-grammar-speech={text}
    aria-label={`Dengarkan ${text}`}
    title={`Dengarkan ${text}`}
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 10v4h4l5 4V6l-5 4H4Z" />
      <path d="M17 9a5 5 0 0 1 0 6M19.5 6.5a9 9 0 0 1 0 11" />
    </svg>
  </button>
</span>

<script>
  import { playAudioTTS, preloadGermanTtsAudio } from '@german/config/german-speech.js';

  const speechDocument = document as Document & { __ndUniverseGrammarSpeechHandler?: boolean };
  const preloadGrammarAudio = () => {
    document.querySelectorAll<HTMLButtonElement>('.grammar-speech-button').forEach((button) => {
      preloadGermanTtsAudio(button.dataset.grammarSpeech ?? '');
    });
  };
  preloadGrammarAudio();
  document.addEventListener('astro:page-load', preloadGrammarAudio);
  if (!speechDocument.__ndUniverseGrammarSpeechHandler) {
    speechDocument.__ndUniverseGrammarSpeechHandler = true;
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('.grammar-speech-button');
      if (!button) return;

      playAudioTTS(button.dataset.grammarSpeech ?? '', button);
    });
  }
</script>

<style>
  .grammar-speech-unit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    vertical-align: middle;
  }

  .grammar-speech-button {
    display: inline-grid;
    width: auto;
    min-width: 44px;
    min-height: 44px;
    flex: 0 0 auto;
    place-items: center;
    padding: 8px;
    border: 1px solid rgba(229, 169, 59, 0.55);
    border-radius: 6px;
    background: rgba(229, 169, 59, 0.12);
    color: var(--accent-gold);
    cursor: pointer;
    transition: transform 0.16s ease, color 0.16s ease, background-color 0.16s ease;
  }

  .grammar-speech-button svg {
    width: 17px;
    height: 17px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .grammar-speech-button:hover:not(:disabled) {
      border-color: var(--accent-gold);
      background: var(--card-bg);
    }
  }
  @media (hover: none) and (pointer: coarse) {
    .grammar-speech-button:active:not(:disabled) {
      transform: scale(0.92);
      background: rgba(212, 164, 55, 0.2);
      transition: transform 80ms ease;
    }
  }

  .grammar-speech-button.is-playing {
    background: var(--accent-gold);
    color: var(--text-main);
  }

  .grammar-speech-button:focus-visible {
    outline: 3px solid var(--accent-gold);
    outline-offset: 2px;
  }

</style>