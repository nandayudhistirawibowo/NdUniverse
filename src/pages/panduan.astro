---
import Layout from '@core/ui/Layout.astro';
import HelpContent from '@core/ui/HelpContent.astro';
---

<Layout
  title="Panduan Penggunaan | siDeutsch"
  description="Panduan publik siDeutsch: cara membuat akun, bermain kuis, memahami XP, menggunakan Bookmark, dan mengganti password."
>
  <div class="guide-shell">
    <HelpContent />
