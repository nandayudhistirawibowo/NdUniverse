---
import DashboardLayout from '@core/ui/DashboardLayout-de.astro';
---
<DashboardLayout title="Hilfe | NdUniverse" description="Hilfe zur Nutzung von NdUniverse." user={Astro.locals.user} profile={Astro.locals.profile}><main class="simple-page"><a href="/dashboard-de" class="back-link">← Kembali ke Dashboard</a><p class="eyebrow">Hilfe</p><h1>Wie können wir helfen?</h1><p>Wähle einen Lernpfad, bearbeite die vier Fertigkeiten und kontaktiere den Support bei Fragen.</p></main></DashboardLayout>
<style>.simple-page{display:grid;gap:.9rem;width:min(900px,100%);margin:0 auto}.back-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}.eyebrow{color:var(--accent-gold);font-size:.78rem;font-weight:800;text-transform:uppercase}.simple-page p:last-child{color:var(--muted)}h1{margin:0}</style>
