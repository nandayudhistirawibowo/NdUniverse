---
import Layout from '@core/ui/Layout.astro';
import CareerQuiz from '@german/components/CareerQuiz-de.jsx';
import { getEntry } from 'astro:content';

const entry = await getEntry('career', 'it');
const vocab = entry?.data.vocab ?? [];
const words = vocab.slice(0, 50).map((word, index) => {
  const alternatives = vocab
    .filter((candidate) => candidate.indonesian !== word.indonesian)
    .filter((_, candidateIndex) => candidateIndex !== index)
    .slice(index % Math.max(1, vocab.length - 4), index % Math.max(1, vocab.length - 4) + 8)
    .map((candidate) => candidate.indonesian)
    .slice(0, 3);
  return {
    ...word,
    options: [word.indonesian, ...new Set(alternatives)],
  };
});
---

<Layout title="IT & Software Engineering | Career | siDeutsch" description="Materi dan kuis kosakata IT berbahasa Jerman.">
  <main class="career-profession">
    <a class="back-link" href="/de/career">← Kembali ke Career</a>
    <header>
      <p class="eyebrow">Career · IT</p>
      <h1>IT &amp; Software Engineering</h1>
      <p>Pelajari {words.length} kosakata IT, lalu lanjutkan ke wawancara Boss Fight.</p>
    </header>
    <div id="career-quiz">
      <CareerQuiz client:load words={words} profession="IT" />
    </div>
    <section class="career-actions" aria-label="Lanjutkan latihan IT">
      <article>
        <span aria-hidden="true">🧠</span>
        <div>
          <strong>Latihan Kosakata</strong>
          <p>Kuis pilihan ganda dari {words.length} kosakata IT.</p>
        </div>
        <a href="#career-quiz">Mulai Kuis Kosakata</a>
      </article>
      <article>
        <span aria-hidden="true">⚔️</span>
        <div>
          <strong>Boss Fight</strong>
          <p>Sepuluh pertanyaan wawancara HRD dalam bahasa Jerman.</p>
        </div>
        <a href="/de/career/it/boss">Mulai Boss Fight</a>
      </article>
    </section>
  </main>
</Layout>

<style>
  .career-profession{display:grid;gap:1rem;width:min(1100px,100%);margin:0 auto}
  .back-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}
  .eyebrow{margin:0;color:#966313;font-size:.72rem;font-weight:800;text-transform:uppercase}
  header h1{margin:.35rem 0}
  header p:last-child{color:var(--muted)}
  .career-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .career-actions article{display:grid;grid-template-columns:auto 1fr;gap:.8rem;padding:1rem;border:1px solid var(--border);border-radius:12px;background:var(--card-bg)}
  .career-actions article>span{font-size:1.6rem}
  .career-actions p{margin:.25rem 0;color:var(--muted)}
  .career-actions a{grid-column:1/-1;min-height:44px;display:grid;place-items:center;border-radius:8px;background:var(--accent-red);color:#fff;text-decoration:none;font-weight:800}
  @media(max-width:700px){.career-profession{padding:0 .25rem}.career-actions{grid-template-columns:1fr}.career-actions a{width:100%;box-sizing:border-box}}
</style>
