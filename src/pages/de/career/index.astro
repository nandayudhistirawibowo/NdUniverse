---
import DashboardLayout from '@core/ui/DashboardLayout-de.astro';
const professions = [
  { slug:'it', name:'IT', description:'Digitale Systeme, Software und Sicherheit.' },
  { slug:'business', name:'Business', description:'Management, Vertrieb und Unternehmenskommunikation.' },
  { slug:'health', name:'Health', description:'Gesundheit, Pflege und medizinische Kommunikation.' },
  { slug:'nutrition', name:'Nutrition', description:'Ernährung, Lebensmittel und Gesundheitserziehung.' },
];
---
<DashboardLayout title="Career | NdUniverse" description="Karir berbahasa Jerman." active="career" user={Astro.locals.user} profile={Astro.locals.profile}><main class="career-page"><a class="back-link" href="/dashboard-de">← Kembali ke Dashboard</a><header><p class="eyebrow">Career</p><h1>Karir Profesional</h1><p>Latih kosakata dan wawancara kerja untuk empat profesi.</p></header><div class="career-grid">{professions.map((profession)=><a href={`/de/career/${profession.slug}`}><span>Career</span><h2>{profession.name}</h2><p>{profession.description}</p><small>Mulai belajar →</small></a>)}</div></main></DashboardLayout>
<style>.career-page{display:grid;gap:1.5rem;width:min(1120px,100%);margin:auto}.back-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}.eyebrow{color:var(--accent-gold);font-size:.78rem;font-weight:800;text-transform:uppercase}.career-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.career-grid a{display:grid;gap:.75rem;min-height:220px;padding:1rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--text-main);text-decoration:none}.career-grid span,.career-grid small{color:var(--accent-gold);font-weight:800}.career-grid h2,.career-grid p{margin:0}@media(max-width:800px){.career-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.career-grid{grid-template-columns:1fr}}</style>
