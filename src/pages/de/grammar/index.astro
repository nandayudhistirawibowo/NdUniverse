---
import Layout from '@core/ui/Layout.astro';
---
<Layout title="Grammatik | NdUniverse" description="Ringkasan tata bahasa bahasa Jerman.">
  <main class="simple-page">
    <a href="/de" class="back-link">← Zurück zum Deutsch-Modul</a>
    <p class="eyebrow">Grammatik</p>
    <h1>Tata Bahasa Jerman</h1>
    <p>Panduan singkat untuk membangun kalimat bahasa Jerman.</p>
    <section>
      <h2>Artikel Kata Benda</h2>
      <p><strong lang="de">der</strong> maskulin, <strong lang="de">die</strong> feminin, dan <strong lang="de">das</strong> netral.</p>
    </section>
    <section>
      <h2>Susunan Kalimat</h2>
      <p lang="de">Ich lerne Deutsch.</p>
      <p>Subjek dan kata kerja dasar dapat membentuk kalimat sederhana.</p>
    </section>
    <a class="full-link" href="/grammar">Lihat panduan lengkap →</a>
  </main>
</Layout>
<style>.simple-page{display:grid;gap:.9rem;width:min(900px,100%);margin:0 auto}.back-link,.full-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}.eyebrow{color:#966313;font-size:.78rem;font-weight:800;text-transform:uppercase}.simple-page p{color:var(--muted)}h1{margin:0}section{padding:1rem;border:1px solid var(--border);border-radius:10px;background:var(--card-bg)}section h2{margin-top:0}</style>
