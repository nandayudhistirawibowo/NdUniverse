---
import DashboardLayout from '@core/ui/DashboardLayout-de.astro';
import Leaderboard from '@core/ui/Leaderboard.astro';
import { fetchLeaderboard } from '@core/db/leaderboard';

export const prerender = false;

const { entries, unavailable } = await fetchLeaderboard('de');
---

<DashboardLayout
  title="Papan Peringkat Bahasa Jerman"
  description="Peringkat siswa berdasarkan progres belajar Bahasa Jerman."
  active="leaderboard"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <Leaderboard entries={entries} language="de" unavailable={unavailable} />
</DashboardLayout>
