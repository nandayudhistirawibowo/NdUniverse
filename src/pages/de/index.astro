---
import Layout from '@core/ui/Layout.astro';

if (Astro.locals.user) return Astro.redirect('/dashboard-de');

const features = [
  { href: '/de/alltagsdeutsch', title: 'Bahasa Jerman Sehari-hari', text: 'Latih kosakata praktis dan empat keterampilan utama bahasa Jerman.' },
  { href: '/de/ujian', title: 'Persiapan Goethe-Zertifikat', text: 'Latih keterampilan Lesen, Hören, Schreiben, dan Sprechen melalui simulasi ujian.' },
  { href: '/de/career', title: 'Bahasa Jerman untuk Karier', text: 'Pelajari kosakata profesional dan persiapkan diri untuk wawancara kerja berbahasa Jerman.' },
];
---

<Layout
  title="Belajar Bahasa Jerman | NdUniverse"
  description="Jelajahi materi Alltagsdeutsch, Fachdeutsch, ujian Goethe, dan persiapan karier dalam bahasa Jerman."
  url="/de"
  alternates={[
    { lang: 'id', url: '/' },
    { lang: 'en', url: '/en' },
    { lang: 'de', url: '/de' },
    { lang: 'x-default', url: '/' },
  ]}
>
  <main class="module-page">
    <a class="back-link" href="/de">← Kembali ke portal Bahasa Jerman</a>
    <header>
      <p class="eyebrow">NdUniverse · Bahasa Jerman</p>
      <h1>Kuasai Bahasa Jerman untuk masa depan.</h1>
      <p class="lead">Pilih jalur belajar untuk komunikasi sehari-hari, persiapan Goethe-Zertifikat, atau peluang karier global.</p>
    </header>
    <div class="feature-grid">
      {features.map((feature) => (
        <a class="feature-card" href={feature.href}>
          <strong>{feature.title}</strong>
          <span>{feature.text}</span>
          <small>Buka modul →</small>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  :global(html:root body) {
    --bg-main: #0b1520;
    --bg-dark: #071019;
    --accent-gold: #e5a93b;
    --accent-red: #D93838;
    --text-main: #f8fafc;
    --card-bg: #071019;
    --muted: rgba(248, 250, 252, 0.66);
    --border: rgba(229, 169, 59, 0.28);
    --shadow: 0 18px 40px color-mix(in srgb, var(--bg-dark) 28%, transparent);
    --primary-hover: #C98D23;
    --bg-soft: color-mix(in srgb, var(--accent-gold) 12%, var(--bg-main));
    --text: var(--text-main);
    background: var(--bg-main);
    color: var(--text-main);
  }

  .module-page { display:grid; gap:2rem; width:min(1120px,100%); margin:0 auto; padding:1rem 0 3rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-decoration:none; }
  @media (hover: hover) {
    .back-link:hover {
      color:var(--accent-gold);
    }
  }
  @media (hover: none) {
    .back-link:active {
      color:var(--accent-gold);
    }
  }
  .eyebrow { margin:0 0 .6rem; color:var(--accent-gold); font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  h1 { margin:0; color:var(--text-main); font-size:clamp(2.2rem,6vw,4.8rem); line-height:1; }
  .lead { max-width:680px; margin:1rem 0 0; color:var(--muted); line-height:1.75; }
  .feature-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); gap:1rem; }
  .feature-card { display:grid; min-height:220px; align-content:start; gap:.75rem; padding:1.35rem; border:1px solid var(--border); border-radius:1rem; background:var(--card-bg); color:var(--text-main); text-decoration:none; box-shadow:var(--shadow); transition:transform .18s ease,border-color .18s ease; }
  @media (hover: hover) {
    .feature-card:hover {
      border-color:var(--accent-gold);
      transform:translateY(-3px);
    }
  }
  @media (hover: none) {
    .feature-card:active {
      border-color:var(--accent-gold);
      transform:translateY(-3px);
    }
  }
  .feature-card strong { font-size:1.2rem; }
  .feature-card span { color:var(--muted); line-height:1.65; }
  .feature-card small { align-self:end; color:var(--accent-gold); font-weight:800; }
  @media(max-width:768px) { .feature-card { min-height:0; } }
</style>
