---
import DashboardLayout from '@core/ui/DashboardLayout-de.astro';
import { hasCompletedPillarSession } from '@core/db/progress-client.js';
import { getCollection } from 'astro:content';

const POINTS_PER_LEVEL = { A1: 10, A2: 20, B1: 30, B2: 40, C1: 50, C2: 60 };
const LEVEL_STEPS = [
  { threshold: 0, label: 'A1 Pemula', nextThreshold: 200, nextLabel: 'A1 Lanjut' },
  { threshold: 200, label: 'A1 Lanjut', nextThreshold: 400, nextLabel: 'A2 Pemula' },
  { threshold: 400, label: 'A2 Pemula', nextThreshold: 700, nextLabel: 'A2 Lanjut' },
  { threshold: 700, label: 'A2 Lanjut', nextThreshold: 1000, nextLabel: 'B1' },
  { threshold: 1000, label: 'B1', nextThreshold: 1400, nextLabel: 'B2' },
  { threshold: 1400, label: 'B2', nextThreshold: 1800, nextLabel: 'C1' },
  { threshold: 1800, label: 'C1', nextThreshold: 2200, nextLabel: 'C2 (Mastery)', },
  { threshold: 2200, label: 'C2 (Mastery)', nextThreshold: null, nextLabel: null },
];

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const displayName = profile?.nama_lengkap || user?.user_metadata?.nama_lengkap || 'Pembelajar';
const { data: progressData } = user
  ? await Astro.locals.supabase.from('user_progress').select('material_slug, xp, sessions_passed').eq('user_id', user.id).eq('language_code', 'de')
  : { data: [] };
const progressRows = progressData ?? [];
const materials = await getCollection('materi');
const materialBySlug = new Map(materials.map((item) => [item.id, item]));
const cefrPoints = progressRows.reduce((total, row) => {
  const material = materialBySlug.get(row.material_slug);
  if (!material || material.data.track !== 'Alltagsdeutsch' || !material.data.level) return total;
  if (!hasCompletedPillarSession(row.sessions_passed)) return total;
  return total + POINTS_PER_LEVEL[material.data.level];
}, 0);
const currentLevel = [...LEVEL_STEPS].reverse().find((step) => cefrPoints >= step.threshold) ?? LEVEL_STEPS[0];
const levelProgress = currentLevel.nextThreshold
  ? Math.min(100, Math.max(0, Math.floor(((cefrPoints - currentLevel.threshold) / (currentLevel.nextThreshold - currentLevel.threshold)) * 100)))
  : 100;
const totalXp = progressRows.reduce((total, row) => total + Math.max(0, Number(row.xp) || 0), 0);
const levelMaterials = materials
  .filter((material) => material.data.track === 'Alltagsdeutsch' && material.data.level)
  .map((material) => ({
    slug: material.id,
    points: POINTS_PER_LEVEL[material.data.level] ?? 0,
  }));
---

<DashboardLayout title="Dashboard | NdUniverse" description="Dashboard pembelajaran bahasa Jerman." active="home" user={user} profile={profile}>
  <section class="dashboard-content">
    <header class="dashboard-heading">
      <p class="eyebrow">Level Bahasa Jerman</p>
      <h1>Halo, {displayName}</h1>
      <p>Siap melanjutkan perjalanan belajar bahasa Jerman?</p>
    </header>

    <article
      class="level-card"
      data-progress-dashboard
      data-progress-rows={JSON.stringify(progressRows)}
      data-level-materials={JSON.stringify(levelMaterials)}
      data-level-steps={JSON.stringify(LEVEL_STEPS)}
    >
      <div>
        <span>Level CEFR Saat Ini</span>
        <strong data-level-label>{currentLevel.label}</strong>
      </div>
      <div class="progress-track" role="progressbar" aria-label={`Progres menuju ${currentLevel.nextLabel ?? currentLevel.label}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={levelProgress} data-level-progress>
        <span data-level-fill style={`width: ${levelProgress}%`}></span>
      </div>
      <small
        data-level-summary
      >{cefrPoints} poin CEFR · {currentLevel.nextThreshold ? `${levelProgress}% menuju ${currentLevel.nextLabel}` : 'Level tertinggi tercapai'} · {totalXp} XP</small>
    </article>

    <nav class="shortcut-grid" aria-label="Menu cepat">
      <a href="/de/materi"><strong>Katalog Materi</strong><span>Jelajahi seluruh materi bahasa Jerman.</span></a>
      <a href="/de/ujian"><strong>Ujian Goethe-Zertifikat</strong><span>Mulai ujian Goethe resmi.</span></a>
      <a href="/de/career"><strong>Karier</strong><span>Siapkan karier profesional.</span></a>
      <a href="/de/dashboard/bookmark"><strong>Penanda Buku</strong><span>Buka kosakata tersimpan</span></a>
    </nav>
  </section>
</DashboardLayout>

<script>
  import { hasCompletedPillarSession } from '@core/db/progress-client.js';

  const renderLevelCard = () => {
    const dashboard = document.querySelector<HTMLElement>('[data-progress-dashboard]');
    if (!dashboard) return;

    const rows = new Map<string, { material_slug: string; xp: number; sessions_passed: unknown }>(
      (JSON.parse(dashboard.dataset.progressRows ?? '[]') as Array<{
        material_slug: string;
        xp: number;
        sessions_passed: unknown;
      }>).map((row) => [row.material_slug, row]),
    );

    const levelMaterials = JSON.parse(dashboard.dataset.levelMaterials ?? '[]') as Array<{
      slug: string;
      points: number;
    }>;
    const steps = JSON.parse(dashboard.dataset.levelSteps ?? '[]') as Array<{
      threshold: number;
      label: string;
      nextThreshold: number | null;
      nextLabel: string | null;
    }>;
    const totalPoints = levelMaterials.reduce((total, material) => {
      const progress = rows.get(material.slug);
      return progress && hasCompletedPillarSession(progress.sessions_passed)
        ? total + material.points
        : total;
    }, 0);
    const totalXp = [...rows.values()].reduce((total, row) => total + Math.max(0, Number(row.xp) || 0), 0);
    const currentLevel = [...steps].reverse().find((step) => totalPoints >= step.threshold) ?? steps[0];
    if (!currentLevel) return;

    const percentage = currentLevel.nextThreshold
      ? Math.min(100, Math.max(0, Math.floor(
        ((totalPoints - currentLevel.threshold) / (currentLevel.nextThreshold - currentLevel.threshold)) * 100,
      )))
      : 100;
    const label = dashboard.querySelector<HTMLElement>('[data-level-label]');
    const progress = dashboard.querySelector<HTMLElement>('[data-level-progress]');
    const fill = dashboard.querySelector<HTMLElement>('[data-level-fill]');
    const summary = dashboard.querySelector<HTMLElement>('[data-level-summary]');
    const nextLevel = currentLevel.nextLabel ?? currentLevel.label;
    if (label) {
      label.textContent = currentLevel.label;
    }
    if (progress) {
      progress.setAttribute('aria-valuenow', String(percentage));
      progress.setAttribute(
        'aria-label',
        `Progres menuju ${nextLevel}`,
      );
    }
    if (fill) fill.style.width = `${percentage}%`;
    if (summary) {
      summary.textContent = currentLevel.nextThreshold
        ? `${totalPoints} poin CEFR · ${percentage}% menuju ${nextLevel} · ${totalXp} XP`
        : `${totalPoints} poin CEFR · Level tertinggi tercapai · ${totalXp} XP`;
    }
  };

  window.addEventListener('nd:progress-updated', (event) => {
    const { slug, languageCode, pillars, xp } = (event as CustomEvent<{
      slug: string;
      languageCode: string;
      session: number | null;
      pillar: string | null;
      xpEarned: number;
      pillars: string[];
      xp: number;
    }>).detail;
    if (languageCode !== 'de') return;

    const dashboard = document.querySelector<HTMLElement>('[data-progress-dashboard]');
    if (!dashboard) return;
    const rows = new Map<string, { material_slug: string; xp: number; sessions_passed: unknown }>(
      (JSON.parse(dashboard.dataset.progressRows ?? '[]') as Array<{
        material_slug: string;
        xp: number;
        sessions_passed: unknown;
      }>).map((row) => [row.material_slug, row]),
    );
    rows.set(slug, { material_slug: slug, xp, sessions_passed: pillars });
    dashboard.dataset.progressRows = JSON.stringify([...rows.values()]);
    renderLevelCard();
  });

  renderLevelCard();
</script>

<style>
  .dashboard-content { display: grid; gap: 1.25rem; }
  .dashboard-heading h1 { margin: .3rem 0; font-size: clamp(2rem, 4vw, 3rem); }
  .dashboard-heading p:last-child { margin: 0; color: var(--muted); }
  .eyebrow { color: #966313; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .level-card { display: grid; gap: .85rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
  .level-card > div:first-child { display: flex; justify-content: space-between; align-items: baseline; }
  .level-card strong { color: #966313; font-size: 2rem; }
  .progress-track { height: 10px; overflow: hidden; border-radius: 999px; background: #e8e5de; }
  .progress-track span { display: block; width: 25%; height: 100%; background: var(--accent-gold); }
  .level-card small { color: var(--muted); }
  .shortcut-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .shortcut-grid a { display: grid; gap: .45rem; min-height: 120px; align-content: center; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text-main); text-decoration: none; }
  .shortcut-grid a:hover { border-color: var(--accent-gold); }
  .shortcut-grid span { color: var(--muted); }
  @media (max-width: 700px) {
    .dashboard-content { gap: 1rem; min-width: 0; }
    .level-card > div:first-child { align-items: flex-start; flex-direction: column; gap: .35rem; }
    .level-card strong { font-size: 1.65rem; }
    .shortcut-grid { grid-template-columns: 1fr; }
    .shortcut-grid a { min-height: 104px; }
  }
</style>
