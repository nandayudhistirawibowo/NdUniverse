---
import Layout from '@core/ui/Layout.astro';
---
<Layout title="Aussprache | NdUniverse" description="Ausspracheübungen für Deutschlernende."><main class="simple-page"><a href="/de" class="back-link">← Zurück zum Deutsch-Modul</a><p class="eyebrow">Aussprache</p><h1>Panduan Pengucapan</h1><p>Lautschrift, Hörübungen und Ausspracheübungen folgen in Kürze.</p></main></Layout>
<style>.simple-page{display:grid;gap:.9rem;width:min(900px,100%);margin:0 auto}.back-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}.eyebrow{color:#966313;font-size:.78rem;font-weight:800;text-transform:uppercase}.simple-page p:last-child{color:var(--muted)}h1{margin:0}</style>
