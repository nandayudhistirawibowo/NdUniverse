---
import DashboardLayout from '@core/ui/DashboardLayout-de.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const materials = (await getCollection('materi')).filter((item) => item.data.track === 'Fachdeutsch');
const item = materials.find((material) =>
  material.id === slug
  || material.id.endsWith(`/${slug}`)
  || String(material.data.jurusan ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '-') === slug
);
if (!item) return new Response('Materi Fachdeutsch tidak ditemukan.', { status: 404 });

const materialSlug = item.id.split('/').at(-1) ?? item.id;
const pillars = [
  { type: 'reading', label: 'Membaca' },
  { type: 'listening', label: 'Menyimak' },
  { type: 'writing', label: 'Menulis' },
  { type: 'speaking', label: 'Berbicara' },
];
---

<DashboardLayout
  title={`${item.data.judulMateri} | Fachdeutsch | NdUniverse`}
  description={item.data.deskripsi}
  active="fachdeutsch"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <main class="material-page">
    <a class="back-link" href="/de/fachdeutsch">← Kembali ke Fachdeutsch</a>
    <header>
      <p class="eyebrow">Fachdeutsch · {item.data.jurusan ?? item.data.fakultas ?? 'Studi dan profesi'}</p>
      <h1>{item.data.judulMateri}</h1>
      <p>{item.data.deskripsi}</p>
    </header>

    <section class="vocabulary-list" aria-label="Daftar kosakata">
      {item.data.vocab.map((entry) => (
        <article class="vocabulary-card">
          <div>
            <h2 lang="de">{entry.german}</h2>
            <p>{entry.indonesian}</p>
          </div>
          {entry.context && <p class="context" lang="de">{entry.context}</p>}
        </article>
      ))}
    </section>

    <nav class="practice-links" aria-label="Pilar latihan">
      {pillars.map((pillar) => (
        <a href={`/de/fachdeutsch/${materialSlug}/latihan?type=${pillar.type}`}>
          Latihan {pillar.label}
        </a>
      ))}
    </nav>
  </main>
</DashboardLayout>

<style>
  .material-page { display: grid; gap: 1.25rem; width: min(100%, 980px); margin: 0 auto; }
  .back-link { width: fit-content; color: var(--text-main); font-weight: 800; text-decoration: none; }
  .eyebrow { margin: 0 0 .4rem; color: var(--accent-gold); font-size: .78rem; font-weight: 800; text-transform: uppercase; }
  h1 { margin: 0; }
  header > p:last-child { color: var(--muted); line-height: 1.6; }
  .vocabulary-list { display: grid; gap: .7rem; }
  .vocabulary-card { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr); gap: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: .8rem; background: var(--card-bg); }
  .vocabulary-card h2, .vocabulary-card p { margin: 0; }
  .vocabulary-card h2 { color: var(--text-main); font-size: 1.05rem; }
  .vocabulary-card p { margin-top: .3rem; color: var(--muted); line-height: 1.55; }
  .vocabulary-card .context { margin: 0; color: var(--text-main); }
  .practice-links { display: flex; flex-wrap: wrap; gap: .65rem; }
  .practice-links a { min-height: 44px; display: inline-flex; align-items: center; padding: .65rem .85rem; border: 1px solid var(--border); border-radius: .65rem; color: var(--text-main); font-weight: 700; text-decoration: none; }
  @media (hover: hover) {
    .practice-links a:hover {
      border-color: var(--accent-gold);
    }
  }
  @media (hover: none) {
    .practice-links a:active {
      border-color: var(--accent-gold);
    }
  }
  @media (max-width: 640px) { .vocabulary-card { grid-template-columns: 1fr; } }
  @media (max-width: 767px) {
    .vocabulary-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
