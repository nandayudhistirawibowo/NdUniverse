---
import DashboardLayout from '@core/ui/DashboardLayout-de.astro';
import { getCollection } from 'astro:content';

const materi = await getCollection('materi');
const sortedMateri = materi.toSorted((first, second) =>
  first.data.judulMateri.localeCompare(second.data.judulMateri, 'id')
);
---

<DashboardLayout
  title="Semua Materi | siDeutsch"
  description="Jelajahi seluruh materi Alltagsdeutsch dan Fachdeutsch siDeutsch."
>
  <main class="catalog-page">
    <a class="dashboard-back-link" href="/dashboard-de">← Kembali ke Dashboard</a>
    <header class="page-hero">
      <p class="eyebrow">Katalog pembelajaran</p>
      <h1>Semua Materi</h1>
      <p class="intro">Jelajahi materi bahasa Jerman sehari-hari dan kosakata sesuai bidang studi.</p>
    </header>

    <label class="search-field" for="material-search">
      <span>Cari materi berdasarkan judul</span>
      <input
        id="material-search"
        type="search"
        placeholder="Contoh: Perkenalan Dasar"
        autocomplete="off"
      />
    </label>

    <p id="search-status" class="search-status" aria-live="polite">
      {sortedMateri.length} materi
    </p>

    <div class="materi-grid" id="material-grid">
      {sortedMateri.map((item) => (
        <a
          class="materi-card"
          href={`/de/materi/${item.id}`}
          data-material-card
          data-level={item.data.level ?? ''}
          data-title={item.data.judulMateri.toLocaleLowerCase('id')}
        >
          <span class="track-label">{item.data.track}</span>
          <h2>{item.data.judulMateri}</h2>
          <p class="description">{item.data.deskripsi}</p>
          <div class="card-meta">
            {item.data.level && <span class="level-badge" data-level={item.data.level}>{item.data.level}</span>}
            {item.data.jurusan && <span class="meta-badge">{item.data.jurusan}</span>}
          </div>
        </a>
      ))}
    </div>

    <p id="no-results" class="no-results" hidden>Tidak ada materi dengan judul tersebut.</p>
  </main>
</DashboardLayout>

<script>
  document.addEventListener('astro:page-load', () => {
  const searchInput = document.querySelector<HTMLInputElement>('#material-search');
  const materialCards = Array.from(document.querySelectorAll<HTMLElement>('[data-material-card]'));
  const searchStatus = document.querySelector<HTMLElement>('#search-status');
  const noResults = document.querySelector<HTMLElement>('#no-results');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLocaleLowerCase('id');
    let visibleCount = 0;

    for (const card of materialCards) {
      const matches = card.dataset.title?.includes(query) ?? false;
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    if (searchStatus) {
      searchStatus.textContent = `${visibleCount} materi`;
    }

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
  });
  });
</script>

<style>
  .dashboard-back-link {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 1.1rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .dashboard-back-link:hover {
    border-color: var(--accent-gold);
    background: rgba(229, 169, 59, 0.1);
  }

  .catalog-page {
    display: grid;
    gap: 1.5rem;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .page-hero {
    display: grid;
    gap: 0.75rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent-gold);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--text-main);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .intro {
    margin: 0;
    max-width: 700px;
    color: var(--muted);
    line-height: 1.75;
  }

  .search-field {
    display: grid;
    gap: 0.5rem;
    max-width: 560px;
    color: var(--text-main);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .search-field input {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    color: var(--text-main);
    font: inherit;
  }

  .search-field input:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent-gold) 35%, transparent);
    border-color: var(--accent-gold);
  }

  .search-status {
    margin: -0.75rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .materi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .materi-card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    color: var(--text-main);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .materi-card:hover {
    border-color: var(--accent-gold);
  }

  .track-label {
    color: var(--accent-gold);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .materi-card h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .materi-card .description {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .card-meta span {
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--bg-dark);
    color: var(--text-main);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .card-meta .level-badge {
    border-radius: 999px;
    background: var(--level-accent, var(--accent-gold));
    color: #071019;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .materi-card[data-level="A1"],
  .materi-card[data-level="A2"] {
    --level-accent: #10B981;
  }

  .materi-card[data-level="B1"],
  .materi-card[data-level="B2"] {
    --level-accent: #3B82F6;
  }

  .materi-card[data-level="C1"],
  .materi-card[data-level="C2"] {
    --level-accent: #7C3AED;
  }

  .card-meta .level-badge[data-level="B1"],
  .card-meta .level-badge[data-level="B2"],
  .card-meta .level-badge[data-level="C1"],
  .card-meta .level-badge[data-level="C2"] {
    color: #FFFFFF;
  }

  .no-results {
    margin: 0;
    color: var(--muted);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 700px) {
    .materi-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
