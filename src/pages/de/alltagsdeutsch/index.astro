---
import DashboardLayout from '@core/ui/DashboardLayout-de.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const materials = (await getCollection('materi'))
  .filter((item) => item.data.track === 'Alltagsdeutsch')
  .sort((a, b) => a.data.level?.localeCompare(b.data.level ?? '') || a.data.judulMateri.localeCompare(b.data.judulMateri));

const user = Astro.locals.user;
const { data: progressData } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('material_slug, xp')
    .eq('user_id', user.id)
    .eq('language_code', 'de')
  : { data: [] };

const xpBySlug = new Map<string, number>();
for (const row of (progressData ?? [])) {
  const xp = Math.max(0, Number(row.xp) || 0);
  xpBySlug.set(row.material_slug, xp);
  const short = row.material_slug.split('/').at(-1);
  if (short && !xpBySlug.has(short)) xpBySlug.set(short, xp);
}

const PILLAR_COUNT = 4;
const XP_PER_CORRECT_ANSWER = 10;
---
<DashboardLayout title="Alltagsdeutsch | NdUniverse" description="Semua materi Alltagsdeutsch dari A1 sampai C2." active="alltagsdeutsch" user={Astro.locals.user} profile={Astro.locals.profile}>
  <main class="language-page">
    <a href="/dashboard-de" class="back-link">← Kembali ke Dashboard</a>
    <header>
      <p class="eyebrow">Alltagsdeutsch · {materials.length} Materi</p>
      <h1>Materi Alltagsdeutsch</h1>
      <p class="lead">Semua materi dari A1 sampai C2.</p>
    </header>
    <div class="catalog-controls">
      <div class="level-filter" aria-label="Filter level">
        <label for="level-filter">Pilih level</label>
        <select id="level-filter" data-level-filter>
          <option value="ALL">Semua Level</option>
          {levels.map((level) => <option value={level}>Level {level}</option>)}
        </select>
      </div>
      <a class="exam-link" data-exam-link href="/de/ujian/goethe">Ujian Goethe</a>
    </div>
    {materials.length > 0 ? (
      <div class="material-grid">
        {materials.map((item) => {
          const vocabCount = item.data.vocab?.length ?? 0;
          const maxXp = vocabCount * PILLAR_COUNT * XP_PER_CORRECT_ANSWER;
          const shortSlug = item.id.split('/').at(-1) ?? item.id;
          const currentXp = xpBySlug.get(item.id) ?? xpBySlug.get(shortSlug) ?? 0;
          const percentage = maxXp > 0
            ? (currentXp >= maxXp ? 100 : Math.min(99, Math.round((currentXp / maxXp) * 100)))
            : 0;
          return (
            <article class="material-card" data-level={item.data.level ?? ''}>
              <span class="level-badge">{item.data.level}</span>
              <h2>{item.data.judulMateri}</h2>
              <p>{item.data.deskripsi}</p>
              <div class="card-progress-wrap">
                <div class="card-progress-info">
                  <span>Progres</span>
                  <span class="card-progress-percent">{percentage}%</span>
                </div>
                <div class="card-progress-track" role="progressbar" aria-valuenow={percentage} aria-valuemin="0" aria-valuemax="100" aria-label={`Progres ${item.data.judulMateri}`}>
                  <div class="card-progress-fill" style={`width: ${percentage}%`} />
                </div>
              </div>
              <a href={`/de/materi/${item.id}`}>Buka Materi →</a>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">Materi Alltagsdeutsch belum tersedia.</p>
    )}
  </main>
</DashboardLayout>
<style>
  :global(html:root body) {
    --bg-main: #0b1520;
    --bg-dark: #071019;
    --accent-gold: #e5a93b;
    --accent-red: #d93838;
    --text-main: #f8fafc;
    --card-bg: #071019;
    --muted: rgba(248, 250, 252, 0.66);
    --border: rgba(229, 169, 59, 0.28);
    background: var(--bg-main);
    color: var(--text-main);
  }

  .language-page { display: grid; gap: 1.5rem; width: min(1120px, 100%); margin: 0 auto; }
  .back-link { width: fit-content; color: var(--text-main); font-weight: 800; text-decoration: none; }
  .eyebrow { color: var(--accent-gold); font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .lead { color: var(--muted); }
  h1 { margin: .25rem 0; }
  .material-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; }
  .material-card { display: grid; align-content: start; gap: .65rem; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
  .material-card[hidden] { display: none; }
  .material-card .level-badge { width: fit-content; padding: .3rem .55rem; border-radius: 999px; background: var(--level-accent, var(--accent-gold)); color: #071019; font-size: .72rem; font-weight: 800; }
  .material-card[data-level="A1"], .material-card[data-level="A2"] { --level-accent: #10B981; }
  .material-card[data-level="B1"], .material-card[data-level="B2"] { --level-accent: #3B82F6; }
  .material-card[data-level="C1"], .material-card[data-level="C2"] { --level-accent: #7C3AED; }
  .material-card[data-level="B1"] .level-badge,
  .material-card[data-level="B2"] .level-badge,
  .material-card[data-level="C1"] .level-badge,
  .material-card[data-level="C2"] .level-badge { color: #FFFFFF; }
  .material-card h2, .material-card p { margin: 0; }
  .material-card p, .empty-state { color: var(--muted); line-height: 1.55; }
  .card-progress-wrap { display: grid; gap: .35rem; margin-top: auto; padding-top: .4rem; }
  .card-progress-info { display: flex; justify-content: space-between; align-items: center; font-size: .75rem; color: var(--muted); font-weight: 700; }
  .card-progress-percent { color: var(--accent-gold); font-weight: 800; font-size: .8rem; }
  .card-progress-track { width: 100%; height: 6px; background: rgba(255, 255, 255, 0.1); border-radius: 4px; overflow: hidden; }
  .card-progress-fill { height: 100%; background: var(--accent-gold); border-radius: 4px; transition: width .3s ease; }
  .material-card a { color: var(--level-accent, var(--accent-gold)); font-weight: 800; text-decoration: none; }
  .catalog-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .level-filter { display: flex; align-items: center; gap: .75rem; }
  .level-filter label { font-weight: 800; }
  .level-filter select { min-height: 44px; padding: .55rem .75rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text-main); }
  .exam-link { min-height: 44px; display: inline-flex; align-items: center; padding: .65rem 1rem; border-radius: 8px; background: var(--accent-gold); color: var(--bg-dark); font-weight: 900; text-decoration: none; }
  @media (max-width: 700px) {
    .language-page { padding-inline: .25rem; }
    .catalog-controls { width: 100%; align-items: stretch; flex-direction: column; }
    .level-filter { width: 100%; align-items: flex-start; flex-direction: column; }
    .level-filter select, .exam-link { width: 100%; }
    .exam-link { justify-content: center; }
  }
  @media (max-width: 767px) {
    .material-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
<script>
  const applyFilter = () => {
    const filter = document.querySelector<HTMLSelectElement>('[data-level-filter]');
    const selected = (filter?.value ?? 'ALL').trim().toUpperCase();
    const examLink = document.querySelector<HTMLAnchorElement>('[data-exam-link]');
    if (examLink) {
      examLink.href = selected === 'ALL'
        ? '/de/ujian/goethe'
        : `/de/ujian/goethe/${selected.toLowerCase()}`;
      examLink.textContent = selected === 'ALL'
        ? 'Ujian Goethe'
        : `Ujian Goethe ${selected}`;
    }
    document.querySelectorAll<HTMLElement>('.material-card[data-level]').forEach((card) => {
      const materialLevel = (card.dataset.level ?? '').trim().toUpperCase();
      card.hidden = selected !== 'ALL' && materialLevel !== selected;
    });
  };
  document.addEventListener('change', (event) => {
    if (event.target instanceof HTMLSelectElement && event.target.matches('[data-level-filter]')) {
      applyFilter();
    }
  });
  document.addEventListener('astro:page-load', applyFilter);
  applyFilter();
</script>
