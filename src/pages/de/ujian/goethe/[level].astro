---
// @ts-nocheck
import Layout from '@core/ui/Layout.astro';
import GoetheExam from '@german/components/GoetheExam-de.jsx';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  return ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'].map((level) => ({
    params: { level: level.toLowerCase() },
  }));
}

const { level: levelParam } = Astro.params;
const level = String(levelParam ?? '').toUpperCase();
const allowedLevels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
if (!allowedLevels.includes(level)) return new Response('Level tidak ditemukan.', { status: 404 });

const materials = (await getCollection('materi'))
  .filter((item) =>
    String(item.data.track ?? '').toLowerCase() === 'alltagsdeutsch'
    && String(item.data.level ?? '').toLowerCase() === level.toLowerCase()
  );
const vocabPool = materials.flatMap((material) => material.data.vocab ?? []);
const counts: Record<string, number> = { A1: 10, A2: 15, B1: 25, B2: 25, C1: 25, C2: 25 };
const readingListeningCount = counts[level] ?? 10;

function shuffle(items: any[]) {
  const copy = [...items];
  for (let index = copy.length - 1; index > 0; index -= 1) {
    const randomIndex = Math.floor(Math.random() * (index + 1));
    [copy[index], copy[randomIndex]] = [copy[randomIndex], copy[index]];
  }
  return copy;
}

function makeOptions(correct: string) {
  const alternatives = shuffle(
    [...new Set(vocabPool.map((item) => item.indonesian).filter((value) => value && value !== correct))]
  ).slice(0, 3);
  if (!correct) return [];
  return shuffle([correct, ...alternatives]);
}

function makeGermanOptions(correct: string) {
  const alternatives = shuffle(
    [...new Set(vocabPool.map((item) => item.german).filter((value) => value && value !== correct))]
  ).slice(0, 3);
  if (!correct || alternatives.length === 0) return [];
  return shuffle([correct, ...alternatives]);
}

const readingItems = shuffle(vocabPool.filter((item) =>
  (item.lesen_teks || item.context) && item.german
)).slice(0, readingListeningCount);
const listeningItems = shuffle(vocabPool.filter((item) => item.hoeren_audio || item.context || item.german)).slice(0, readingListeningCount);
const keyWords = readingItems.slice(0, 5).map((item) => item.german).filter(Boolean);
const reading = readingItems.map((item) => {
  const passage = item.lesen_teks || item.context;
  const hasReadingQuestion = Boolean(item.lesen_pertanyaan);
  const fallbackAnswer = item.indonesian || item.contextIndonesian;
  return {
    passage,
    keyParagraph: passage,
    prompt: item.lesen_pertanyaan || `Pilih arti yang tepat untuk "${item.german}".`,
    answer: hasReadingQuestion ? item.german : fallbackAnswer,
    options: hasReadingQuestion
      ? makeGermanOptions(item.german)
      : makeOptions(fallbackAnswer),
    keywords: keyWords,
  };
});
const listening = listeningItems.map((item) => {
  const audioText = item.hoeren_audio || item.context || item.german;
  return {
    audio: audioText,
    audioFallback: item.context || item.german,
    prompt: `Dengarkan audio, lalu pilih arti yang tepat untuk "${item.german}".`,
    answer: item.indonesian || item.contextIndonesian || item.german,
    options: makeOptions(item.indonesian || item.contextIndonesian || item.german),
    transcript: audioText,
  };
});

const writingPool = shuffle(vocabPool.filter((item) => item.german));
const speakingPool = shuffle(vocabPool.filter((item) => item.german));
const textTaskCount = ['A1', 'A2'].includes(level) ? 1 : 2;
const writing = writingPool.slice(0, textTaskCount).map((item) => ({
    prompt: item.schreiben_instruksi || `Tulis sebuah kalimat bahasa Jerman menggunakan kosakata "${item.german}".`,
    answer: item.german || item.indonesian,
    keywords: [item.german, item.indonesian].filter(Boolean),
    keywordGroups: [
      [item.german, item.indonesian].filter(Boolean),
    ],
}));
const speaking = speakingPool.slice(0, textTaskCount).map((item) => ({
    prompt: item.sprechen_pertanyaan || `Sebutkan kosakata bahasa Jerman untuk arti "${item.indonesian}".`,
    answer: item.german || item.indonesian,
    keywords: [item.german, item.indonesian].filter(Boolean),
    keywordGroups: [
      [item.german, item.indonesian].filter(Boolean),
    ],
}));

const tasks = {
  lesen: reading,
  hoeren: listening,
  schreiben: writing,
  sprechen: speaking,
};
const available = vocabPool.length > 0
  && reading.length > 0
  && listening.length > 0
  && writing.length > 0
  && speaking.length > 0;
---

<Layout title={`Simulate Goethe-Zertifikat ${level} | NdUniverse`} description={`Simulasi resmi Goethe-Zertifikat level ${level}.`}>
  <main class="goethe-shell">
    <GoetheExam client:load level={level} tasks={tasks} available={available} />
  </main>
</Layout>

<style is:global>
  .goethe-shell { width:min(980px,calc(100% - 2rem)); min-width:0; margin:2rem auto 4rem; }
  .goethe-exam { display:grid; gap:1.25rem; }
  .goethe-heading { padding:1.4rem; border:1px solid var(--border); border-radius:1rem; background:var(--card-bg); }
  .goethe-heading { display:flex; min-width:0; align-items:center; justify-content:space-between; gap:1rem; }
  .goethe-heading > div { min-width:0; }
  .exam-timer { flex:0 0 auto; min-width:110px; display:grid; gap:.15rem; text-align:center; padding:.65rem .8rem; border:1px solid var(--accent-gold); border-radius:.75rem; background:#fffaf0; }
  .exam-timer span { font-size:.72rem; font-weight:800; text-transform:uppercase; color:var(--muted); }
  .exam-timer strong { font-size:1.35rem; color:#966313; font-variant-numeric:tabular-nums; }
  .goethe-heading h1 { margin:.15rem 0 .35rem; }
  .goethe-heading p { margin:.25rem 0; color:var(--muted); }
  .module-progress { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; }
  .module-progress button { display:grid; gap:.35rem; padding:.75rem; border:1px solid var(--border); border-radius:.75rem; background:var(--card-bg); color:var(--text-main); text-align:left; cursor:pointer; }
  .module-progress button.active { border-color:var(--accent-gold); box-shadow:0 0 0 3px rgba(229,169,59,.12); }
  .module-progress strong { font-size:.78rem; color:var(--muted); }
  .module-track { height:5px; overflow:hidden; border-radius:999px; background:#e8e8e8; }
  .module-track span { display:block; height:100%; border-radius:inherit; background:var(--accent-gold); }
  .module-panel { display:grid; gap:1rem; }
  .module-panel > header { padding:.75rem 0; }
  .module-panel > header p { margin:0; color:#966313; font-weight:800; text-transform:uppercase; }
  .module-panel > header h2 { margin:.25rem 0 0; }
  .goethe-task { display:grid; gap:.8rem; padding:1.25rem; border:1px solid var(--border); border-radius:1rem; background:var(--card-bg); }
  .task-meta { color:var(--muted); font-size:.82rem; font-weight:800; text-transform:uppercase; }
  .goethe-task blockquote { margin:0; padding:.85rem 1rem; border-left:4px solid var(--accent-gold); background:#fffaf0; line-height:1.65; overflow-wrap:anywhere; }
  .prompt { margin:0; font-weight:700; overflow-wrap:anywhere; }
  .audio-button,.mic-button { width:fit-content; min-height:44px; border:0; border-radius:.65rem; padding:.75rem 1rem; background:var(--accent-gold); color:#fff; font-weight:800; cursor:pointer; }
  .audio-button:disabled { opacity:.65; cursor:not-allowed; }
  .audio-controls { display:flex; }
  .text-answer small { color:var(--muted); line-height:1.5; }
  .options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; }
  .option { display:flex; align-items:center; gap:.65rem; min-height:44px; padding:.65rem .75rem; border:1px solid var(--border); border-radius:.65rem; cursor:pointer; }
  .option.selected { border-color:var(--accent-gold); background:rgba(229,169,59,.09); }
  .text-answer { display:grid; gap:.75rem; }
  .text-answer textarea { width:100%; box-sizing:border-box; padding:.8rem; border:1px solid var(--border); border-radius:.65rem; resize:vertical; font:inherit; }
  .submit-button { justify-self:center; min-height:44px; border:0; border-radius:.75rem; padding:.85rem 1.2rem; background:var(--accent-red); color:#fff; font-weight:800; cursor:pointer; }
  .goethe-result { display:grid; gap:1rem; padding:1.25rem; border:1px solid var(--border); border-radius:1rem; text-align:center; }
  .goethe-result.passed { background:#edf8ef; border-color:#9bd0a5; }
  .goethe-result.failed { background:#fff2f2; border-color:#e6a3a3; }
  .result-label { margin:0; font-size:.78rem; font-weight:900; letter-spacing:.08em; }
  .module-results { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; }
  .module-results article { padding:.75rem; border-radius:.65rem; border:1px solid var(--border); background:#fff; }
  .module-results article p { margin:.25rem 0 0; color:var(--muted); }
  .module-results article.failed strong { color:#b42318; }
  .module-results article.passed strong { color:#218838; }
  .retry-message { margin:0; font-weight:700; }
  .result-navigation { display:flex; justify-content:center; flex-wrap:wrap; gap:.75rem; }
  .certificate-link { justify-self:center; padding:.75rem 1rem; border-radius:.65rem; background:var(--accent-red); color:#fff; text-decoration:none; font-weight:800; }
  .failure-link { background:#966313; }
  @media(max-width:768px) {
    .module-progress,.module-results { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .options { grid-template-columns:1fr; }
    .goethe-heading { align-items:flex-start; flex-direction:column; }
    .exam-timer { min-width:0;width:100%; }
    .goethe-task { padding:.9rem; }
    .text-answer textarea { min-height:140px;font-size:16px; }
    .result-navigation a { width:100%;box-sizing:border-box;text-align:center; }
    .submit-button { width:100%; }
  }
  @media(max-width:420px) {
    .module-progress,.module-results { grid-template-columns:minmax(0,1fr); }
    .module-progress button { min-height:58px; }
  }
</style>
