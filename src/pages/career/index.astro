---
import { getCollection } from 'astro:content';
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
const materials = (await getCollection('career')).toSorted((left, right) =>
  left.data.judulMateri.localeCompare(right.data.judulMateri, 'id')
);
---

<DashboardLayout
  title="Career | siDeutsch"
  description="Materi bahasa Jerman untuk persiapan dunia kerja."
  active="career"
  user={user}
  profile={Astro.locals.profile}
>
  <section class="career-catalog">
    <a class="back-link" href="/dashboard">
      <span aria-hidden="true">←</span>
      <span>Kembali ke Dashboard</span>
    </a>
    <header class="page-heading">
      <p class="eyebrow">Persiapan dunia kerja</p>
      <h1>Career</h1>
      <p>Pelajari bahasa Jerman untuk wawancara, CV, dan komunikasi profesional.</p>
    </header>

    {materials.length > 0 ? (
      <div class="material-grid">
        {materials.map((item) => (
          <article class="material-card">
            <p class="material-track">Career</p>
            <h2>{item.data.judulMateri}</h2>
            <p class="material-description">{item.data.deskripsi}</p>
            <div class="card-footer">
              <span>{item.data.vocab.length} kosakata</span>
              <a class="material-action" href={`/career/${item.id}`}>
                Buka materi <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">Materi Career akan segera tersedia.</p>
    )}
  </section>
</DashboardLayout>

<style>
  .career-catalog {
    display: grid;
    gap: 1.25rem;
  }

  .back-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-main);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    border-color: var(--accent-gold);
  }

  .page-heading h1 {
    margin: 0;
    color: var(--text-main);
    font-size: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    color: #966313;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .page-heading > p:last-child {
    margin: 0.45rem 0 0;
    color: var(--muted);
  }

  .material-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .material-card {
    display: flex;
    min-height: 210px;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    color: var(--text-main);
    box-shadow: 0 5px 15px rgba(26, 26, 30, 0.05);
  }

  .material-track {
    margin: 0;
    color: #966313;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .material-card h2 {
    margin: 0.75rem 0 0.4rem;
    font-size: 1rem;
  }

  .material-description {
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .material-action {
    display: inline-flex;
    gap: 0.35rem;
    color: var(--text-main);
    font-weight: 800;
    text-decoration: none;
  }

  .material-action:hover {
    color: var(--accent-gold);
  }

  .empty-state {
    color: var(--muted);
  }
</style>
