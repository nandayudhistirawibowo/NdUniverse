---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

---
<DashboardLayout
  title="Career | siDeutsch"
  description="Katalog profesi untuk mempersiapkan karir berbahasa Jerman."
  active="career"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <section class="career-catalog">
    <header class="page-heading">
      <p class="eyebrow">Persiapan dunia kerja</p>
      <h1>Career</h1>
      <p>Pilih rumpun profesi untuk mempersiapkan karir berbahasa Jerman.</p>
    </header>

    <div class="career-grid">
      <article class="career-card">
        <span class="career-icon" aria-hidden="true">💻</span>
        <h2>IT &amp; Software Engineering</h2>
        <p>Siapkan dirimu untuk wawancara kerja sebagai Software Engineer di Jerman.</p>
        <a href="/career/it">Mulai Belajar</a>
      </article>

      <article class="career-card">
        <span class="career-icon" aria-hidden="true">📈</span>
        <h2>Digital Business &amp; E-Commerce</h2>
        <p>Pelajari kosakata pemasaran digital &amp; bisnis untuk karir di Eropa.</p>
        <a href="/career/business">Mulai Belajar</a>
      </article>

      <article class="career-card">
        <span class="career-icon" aria-hidden="true">🏥</span>
        <h2>Pflege &amp; Gesundheitswesen</h2>
        <p>Persiapkan bahasa Jerman medis untuk bekerja di rumah sakit Jerman.</p>
        <a href="/career/health">Mulai Belajar</a>
      </article>

      <article class="career-card">
        <span class="career-icon" aria-hidden="true">🧑‍🍼</span>
        <h2>Gizi &amp; Kebidanan</h2>
        <p>Kosakata khusus untuk ahli gizi dan bidan dalam dunia kerja Jerman.</p>
        <a href="/career/nutrition">Mulai Belajar</a>
      </article>
    </div>
  </section>
</DashboardLayout>

<style>
  .career-catalog {
    display: grid;
    gap: 1.5rem;
  }

  .page-heading h1 {
    margin: 0.35rem 0 0;
    color: var(--text-main);
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .page-heading > p:last-child {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  .eyebrow {
    margin: 0;
    color: #966313;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .career-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .career-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-height: 220px;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card-bg);
    box-shadow: var(--shadow);
  }

  .career-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 12px;
    background: rgba(229, 169, 59, 0.14);
    font-size: 1.5rem;
  }

  .career-card h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.15rem;
  }

  .career-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .career-card a {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent-red);
    color: #fff;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (min-width: 1100px) {
    .career-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .career-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
