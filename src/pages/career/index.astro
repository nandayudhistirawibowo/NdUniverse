---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

---
<DashboardLayout
  title="Career Segera Hadir | siDeutsch"
  description="Fitur Career siDeutsch sedang dalam tahap pengembangan."
  active="career"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <section class="career-coming-soon">
    <span class="career-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="3" y="7" width="18" height="14" rx="2" />
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2" />
      </svg>
    </span>
    <p class="eyebrow">Persiapan dunia kerja</p>
    <h1>Career</h1>
    <p class="coming-soon-message">
      Fitur Career sedang dalam tahap pengembangan. Nantikan segera!
    </p>
    <a class="back-link" href="/dashboard">Kembali ke Dashboard</a>
  </section>
</DashboardLayout>

<style>
  .career-coming-soon {
    display: grid;
    justify-items: center;
    max-width: 720px;
    margin: clamp(2rem, 8vh, 6rem) auto;
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--border);
    border-radius: 20px;
    background:
      radial-gradient(circle at top, rgba(229, 169, 59, 0.13), transparent 55%),
      var(--card-bg);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .career-icon {
    display: grid;
    width: 68px;
    height: 68px;
    place-items: center;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(229, 169, 59, 0.4);
    border-radius: 20px;
    background: rgba(229, 169, 59, 0.14);
    color: #966313;
  }

  .career-icon svg {
    width: 32px;
    height: 32px;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .eyebrow {
    margin: 0;
    color: #966313;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.35rem 0 0;
    color: var(--text-main);
    font-size: clamp(2.2rem, 6vw, 3.2rem);
  }

  .coming-soon-message {
    max-width: 470px;
    margin: 0.85rem 0 1.5rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .back-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-main);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    border-color: var(--accent-gold);
    background: rgba(229, 169, 59, 0.1);
  }
</style>
