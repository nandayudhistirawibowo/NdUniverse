---
import { getEntry } from 'astro:content';
import DashboardLayout from '@core/ui/DashboardLayout.astro';
import HelpHint from '@core/ui/HelpHint.jsx';

export const prerender = false;

const item = await getEntry('career', Astro.params.slug ?? '');
if (!item) return new Response('Materi Career tidak ditemukan.', { status: 404 });
---

<DashboardLayout
  title={`${item.data.judulMateri} | Career | siDeutsch`}
  description={item.data.deskripsi}
  active="career"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <article class="career-material">
    <a class="back-link" href="/career">← Kembali ke Career</a>
    <header class="page-heading">
      <p class="eyebrow">Career • Kosakata profesional</p>
      <div class="heading-title">
        <h1>{item.data.judulMateri}</h1>
        <HelpHint title="Persiapan Karir" text="Pelajari 50 kosakata dan ikuti simulasi wawancara (Boss Fight) di bawah." client:load />
      </div>
      <p>{item.data.deskripsi}</p>
    </header>
    <section class="vocabulary-list" aria-label="Daftar kosakata">
      {item.data.vocab.map((entry) => (
        <article class="vocabulary-card">
          <div class="vocabulary-terms">
            <h2 lang="de">{entry.german}</h2>
            <p>{entry.indonesian}</p>
          </div>
          {entry.context && (
            <div class="context" lang="de">
              <p>{entry.context}</p>
              {entry.contextIndonesian && <p lang="id">{entry.contextIndonesian}</p>}
            </div>
          )}
        </article>
      ))}
    </section>
  </article>
</DashboardLayout>

<style>
  .career-material {
    display: grid;
    gap: 1.25rem;
  }

  .back-link {
    width: fit-content;
    color: var(--text-main);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent-gold);
  }

  .page-heading h1 {
    margin: 0;
    color: var(--text-main);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }

  .heading-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    color: #966313;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .page-heading > p:last-child {
    margin: 0.45rem 0 0;
    color: var(--muted);
  }

  .vocabulary-list {
    display: grid;
    gap: 0.75rem;
  }

  .vocabulary-card {
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
  }

  .vocabulary-terms h2,
  .vocabulary-terms p,
  .context p {
    margin: 0;
  }

  .vocabulary-terms h2 {
    color: var(--text-main);
    font-size: 1rem;
  }

  .vocabulary-terms p,
  .context p {
    margin-top: 0.35rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .context p:first-child {
    color: var(--text-main);
  }

  @media (max-width: 600px) {
    .vocabulary-card {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
