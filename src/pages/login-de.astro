---
import AuthPortal from '@core/auth/AuthPortal.astro';
import { isAdminNim } from '@core/auth/admin';

if (Astro.locals.user) {
  return Astro.redirect(isAdminNim(Astro.locals.profile?.nim) ? '/admin' : '/dashboard-de');
}
---

<AuthPortal
  portal="student"
  language="id"
  dashboardPath="/dashboard-de"
  title="Belajar Bahasa Jerman & Inggris Gratis | NdUniverse"
  eyebrow="Portal Belajar"
  heading="Selamat Datang Kembali!"
  description="Masuk dengan email atau username kamu."
  seoDescription="Platform belajar bahasa Jerman dan Inggris interaktif. Dilengkapi simulasi ujian Goethe, IELTS, TOEFL, dan fitur audio TTS. Daftar gratis sekarang!"
  storyKicker="MODUL BAHASA JERMAN"
  storyHeading="Kuasai Bahasa Asing dari Nol Hingga Mahir"
  storyDetail="Tingkatkan kemampuan bahasa Jerman dan Inggris kamu melalui latihan 4 pilar CEFR, simulasi ujian resmi, dan bantuan Chatbot AI."
  buttonText="Masuk / Daftar"
/>
