---
import AuthPortal from '@core/auth/AuthPortal.astro';
import { isAdminNim } from '@core/auth/admin';

if (Astro.locals.user) {
  return Astro.redirect(isAdminNim(Astro.locals.profile?.nim) ? '/admin' : '/dashboard-de');
}
---

<AuthPortal
  portal="student"
  language="de"
  title="Login | German - NdUniverse"
  eyebrow="Lernportal"
  heading="Willkommen zurück!"
  description="Melden Sie sich mit E-Mail oder Matrikelnummer an."
  buttonText="Anmelden"
/>
