---
import { getCollection } from 'astro:content';
import DashboardMaterialCatalog from '../../components/DashboardMaterialCatalog.astro';

export const prerender = false;

const user = Astro.locals.user;
const materials = (await getCollection('materi'))
  .filter((item) => item.data.track === 'Alltagsdeutsch')
  .toSorted((left, right) => left.data.judulMateri.localeCompare(right.data.judulMateri, 'id'));
const { data } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('material_slug, sessions_passed')
    .eq('user_id', user.id)
  : { data: [] };
---

<DashboardMaterialCatalog
  title="Alltagsdeutsch"
  eyebrow="Bahasa sehari-hari"
  description="Materi percakapan dan kosakata berdasarkan level CEFR."
  active="alltagsdeutsch"
  user={user}
  profile={Astro.locals.profile}
  materials={materials}
  progressRows={data ?? []}
/>
