---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getCollection } from 'astro:content';

const POINTS_PER_LEVEL = { A1: 10, A2: 20, B1: 30, B2: 40, C1: 50, C2: 60 };
const LEVEL_STEPS = [
  { threshold: 0, label: 'A1 Pemula', nextThreshold: 200, nextLabel: 'A1 Lanjut' },
  { threshold: 200, label: 'A1 Lanjut', nextThreshold: 400, nextLabel: 'A2 Pemula' },
  { threshold: 400, label: 'A2 Pemula', nextThreshold: 700, nextLabel: 'A2 Lanjut' },
  { threshold: 700, label: 'A2 Lanjut', nextThreshold: 1000, nextLabel: 'B1' },
  { threshold: 1000, label: 'B1', nextThreshold: 1400, nextLabel: 'B2' },
  { threshold: 1400, label: 'B2', nextThreshold: 1800, nextLabel: 'C1' },
  { threshold: 1800, label: 'C1', nextThreshold: 2200, nextLabel: 'C2 (Mastery)' },
  { threshold: 2200, label: 'C2 (Mastery)', nextThreshold: null, nextLabel: null },
];

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const nim = profile?.nim ?? user?.user_metadata?.nim ?? 'Mahasiswa';
const displayName = profile?.nama_lengkap || user?.user_metadata?.nama_lengkap || nim;
const accessDenied = Astro.url.searchParams.get('error') === 'admin-only';
const { data: progressData } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('material_slug, xp, sessions_passed')
    .eq('user_id', user.id)
  : { data: [] };
const progressRows = progressData ?? [];
const totalXp = progressRows.reduce((total, row) => total + Math.max(0, Number(row.xp) || 0), 0);
const materials = await getCollection('materi');
const totalSessions = materials.reduce((total, material) => total + Math.ceil(material.data.vocab.length / 5), 0);
const materialBySlug = new Map(materials.map((item) => [item.id, item]));
const totalPoints = progressRows.reduce((total, row) => {
  const material = materialBySlug.get(row.material_slug);
  if (!material || !material.data.level || !Array.isArray(row.sessions_passed)) return total;

  const levelPoints = POINTS_PER_LEVEL[material.data.level];
  if (!levelPoints) return total;

  const totalMaterialSessions = Math.ceil(material.data.vocab.length / 5);
  const passedSessions = new Set(
    row.sessions_passed
      .map(Number)
      .filter((session) => Number.isInteger(session) && session > 0 && session <= totalMaterialSessions)
  );
  return total + passedSessions.size * levelPoints;
}, 0);
const currentLevel = [...LEVEL_STEPS].reverse().find((step) => totalPoints >= step.threshold) ?? LEVEL_STEPS[0];
const levelProgressPercent = currentLevel.nextThreshold
  ? Math.min(100, Math.round((totalPoints / currentLevel.nextThreshold) * 100))
  : 100;
const completedMaterials = progressRows.flatMap((row) => {
  const material = materialBySlug.get(row.material_slug);
  if (!material) return [];

  const totalSessions = Math.ceil(material.data.vocab.length / 5);
  const passedSessions = Array.isArray(row.sessions_passed)
    ? new Set(row.sessions_passed.map(Number).filter(Number.isInteger))
    : new Set();
  const isComplete = totalSessions > 0
    && Array.from({ length: totalSessions }, (_, index) => index + 1).every((session) => passedSessions.has(session));

  return isComplete ? [{ slug: row.material_slug, title: material.data.judulMateri }] : [];
});
---

<DashboardLayout
  title="Dashboard Mahasiswa | siDeutsch"
  description="Dashboard belajar bahasa Jerman mahasiswa siDeutsch."
  active="home"
  user={user}
  profile={profile}
>
  <section class="dashboard-content">
      {accessDenied && <p class="access-notice" role="alert">Akses Admin ditolak. Akun ini tidak memiliki izin administrator.</p>}
      <header class="dashboard-heading">
        <p class="eyebrow">Portal Mahasiswa</p>
        <h1>Halo, {displayName}</h1>
        <p>Siap melanjutkan perjalanan belajar bahasa Jerman?</p>
      </header>

      <section class="welcome-strip">
        <div>
          <p class="eyebrow">Lanjutkan belajar</p>
          <h2>Waktunya satu sesi baru.</h2>
          <p>Pilih materi, pelajari kosakata, lalu selesaikan latihan bertahap.</p>
          <a href="/materi">Buka katalog <span aria-hidden="true">→</span></a>
        </div>
        <a class="welcome-mark" href="/materi" aria-label="Buka katalog materi">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6.5A2.5 2.5 0 0 1 4 17.5v-11Z" />
            <path d="M8 8h8M8 12h8M8 16h5" />
          </svg>
        </a>
      </section>

      <section class="dynamic-level-card" aria-labelledby="dynamic-level-title">
        <div class="level-summary">
          <p class="level-eyebrow">Level Bahasa Jerman</p>
          <p class="level-caption">Level Saat Ini</p>
          <h2 id="dynamic-level-title">{currentLevel.label}</h2>
          <p class="level-points">{totalPoints} poin terkumpul dari sesi yang lulus</p>
        </div>
        <div class="level-next-step">
          {currentLevel.nextThreshold ? (
            <>
              <div class="level-progress-heading">
                <span>Menuju {currentLevel.nextLabel}</span>
                <strong>{levelProgressPercent}%</strong>
              </div>
              <div
                class="level-progress-track"
                role="progressbar"
                aria-label={`Progress menuju ${currentLevel.nextLabel}`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow={levelProgressPercent}
              >
                <span style={`width: ${levelProgressPercent}%`} />
              </div>
              <p>{totalPoints} / {currentLevel.nextThreshold} Poin untuk naik ke {currentLevel.nextLabel}</p>
            </>
          ) : (
            <>
              <div class="level-progress-heading"><span>Level tertinggi</span><strong>100%</strong></div>
              <div class="level-progress-track" role="progressbar" aria-label="Level tertinggi tercapai" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
                <span style="width: 100%" />
              </div>
              <p>C2 (Mastery) tercapai. Lanjutkan belajar untuk mempertahankan ritme.</p>
            </>
          )}
        </div>
      </section>

      <section class="learning-section" aria-labelledby="learning-title">
        <div class="learning-heading">
          <div>
            <p class="eyebrow">Jalur Belajar</p>
            <h2 id="learning-title">Pilih ruang belajarmu</h2>
          </div>
          <a href="/materi">Semua Materi <span aria-hidden="true">→</span></a>
        </div>
        <div class="learning-grid">
          <a class="learning-card" href="/materi">
            <span class="learning-index">01</span>
            <h3>Katalog Materi</h3>
            <p>Jelajahi seluruh materi bahasa Jerman.</p>
            <span class="learning-arrow" aria-hidden="true">→</span>
          </a>
          <a class="learning-card" href="/alltagsdeutsch">
            <span class="learning-index">02</span>
            <h3>Alltagsdeutsch</h3>
            <p>Bangun komunikasi sehari-hari dari A1 sampai C2.</p>
            <span class="learning-arrow" aria-hidden="true">→</span>
          </a>
          <a class="learning-card" href="/fachdeutsch">
            <span class="learning-index">03</span>
            <h3>Fachdeutsch</h3>
            <p>Pelajari kosakata sesuai bidang studi.</p>
            <span class="learning-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <div class="dashboard-grid">
        <article class="dashboard-card" id="status">
          <span class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
          <p class="card-label">Status Profil</p>
          <h2>{profile?.nama_lengkap && profile?.nomor_wa ? 'Profil lengkap' : 'Lengkapi profil'}</h2>
          <p>{profile?.nama_lengkap && profile?.nomor_wa ? 'Informasi akunmu sudah diperbarui.' : 'Tambahkan nama dan nomor WhatsApp agar profilmu siap.'}</p>
          <a href="/dashboard/profil">Buka profil <span aria-hidden="true">→</span></a>
        </article>
        <article class="dashboard-card" id="total-xp">
          <span class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" /></svg></span>
          <p class="card-label">Progress Belajar</p>
          <h2>{totalXp} XP</h2>
          <p>Total XP yang terkumpul dari seluruh materi.</p>
        </article>
      </div>

      <section class="completed-section" aria-labelledby="completed-title">
        <div class="completed-heading">
          <div>
            <p class="eyebrow">Pencapaian</p>
            <h2 id="completed-title">Materi selesai</h2>
          </div>
          <span>{completedMaterials.length} materi</span>
        </div>
        {completedMaterials.length > 0 ? (
          <ul class="completed-list">
            {completedMaterials.map((material) => (
              <li><a href={`/materi/${material.slug}`}>{material.title}<span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        ) : (
          <p class="completed-empty">Belum ada materi yang seluruh sesinya lulus.</p>
        )}
      </section>
  </section>
</DashboardLayout>

<style>
  .dashboard-content {
    min-width: 0;
    padding: 0.5rem 0;
  }

  .access-notice {
    margin: 0 0 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--accent-red);
    border-radius: 8px;
    background: #FCE7E7;
    color: var(--accent-red);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .dashboard-heading {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--text-main);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--text-main);
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .dashboard-heading > p:last-child {
    margin: 0.6rem 0 0;
    color: #64748b;
  }

  .welcome-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 12px;
    background: var(--bg-dark);
    color: #e2e8f0;
  }

  .welcome-strip .eyebrow {
    color: var(--accent-gold);
  }

  .welcome-strip h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.35rem, 3vw, 1.9rem);
  }

  .welcome-strip p:not(.eyebrow) {
    max-width: 520px;
    margin: 0.6rem 0 0.9rem;
    color: #b6c5d9;
    font-size: 0.9rem;
  }

  .welcome-strip a,
  .dashboard-card a {
    color: var(--accent-gold);
    font-size: 0.84rem;
    font-weight: 800;
    text-decoration: none;
  }

  .welcome-strip a:hover,
  .dashboard-card a:hover {
    color: #F0B84F;
  }

  .welcome-mark {
    display: grid;
    width: 96px;
    height: 96px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(229, 169, 59, 0.4);
    border-radius: 50%;
    background: rgba(229, 169, 59, 0.08);
    color: var(--accent-gold);
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .welcome-mark:hover {
    background: rgba(229, 169, 59, 0.16);
    border-color: rgba(229, 169, 59, 0.7);
    transform: translateY(-2px);
  }

  .welcome-mark svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dynamic-level-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: 1rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--accent-gold);
    border-radius: 12px;
    background: var(--bg-dark);
    color: #F9F9FB;
    box-shadow: 0 16px 36px rgba(26, 26, 30, 0.13);
  }

  .level-eyebrow {
    margin: 0 0 0.8rem;
    color: var(--accent-gold);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .level-caption {
    margin: 0 0 0.15rem;
    color: rgba(249, 249, 251, 0.68);
    font-size: 0.8rem;
  }

  .level-summary h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .level-points {
    margin: 0.55rem 0 0;
    color: rgba(249, 249, 251, 0.66);
    font-size: 0.76rem;
  }

  .level-next-step {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding-left: clamp(0rem, 2.6vw, 1.75rem);
    border-left: 1px solid rgba(229, 169, 59, 0.34);
  }

  .level-progress-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: rgba(249, 249, 251, 0.82);
    font-size: 0.8rem;
  }

  .level-progress-heading strong {
    color: var(--accent-gold);
    font-size: 0.9rem;
  }

  .level-progress-track {
    height: 9px;
    overflow: hidden;
    margin-top: 0.6rem;
    border-radius: 999px;
    background: rgba(249, 249, 251, 0.15);
  }

  .level-progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent-gold);
    transition: width 0.25s ease;
  }

  .level-next-step > p {
    margin: 0.6rem 0 0;
    color: rgba(249, 249, 251, 0.68);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .completed-section {
    margin-top: 2rem;
  }

  .completed-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .completed-heading h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.35rem;
  }

  .completed-heading > span {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .completed-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .completed-list li {
    border-bottom: 1px solid var(--border);
  }

  .completed-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.2rem;
    color: var(--text-main);
    font-weight: 700;
    text-decoration: none;
  }

  .completed-list a span {
    color: #966313;
  }

  .completed-empty {
    margin: 0;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.88rem;
  }

  .learning-section {
    margin-top: 2rem;
  }

  .learning-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .learning-heading .eyebrow {
    margin-bottom: 0.3rem;
  }

  .learning-heading h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.35rem;
  }

  .learning-heading > a {
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: var(--accent-gold);
    text-underline-offset: 3px;
  }

  .learning-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 0.75rem;
  }

  .learning-card {
    position: relative;
    display: flex;
    min-height: 174px;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    color: var(--text-main);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .learning-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-gold);
    box-shadow: 0 10px 24px rgba(229, 169, 59, 0.14);
  }

  .learning-index {
    color: #966313;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .learning-card h3 {
    margin: 0.8rem 0 0.35rem;
    font-size: 1rem;
  }

  .learning-card p {
    max-width: 260px;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .learning-arrow {
    align-self: flex-end;
    margin-top: auto;
    color: #966313;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .dashboard-card {
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    transition: all 0.2s ease;
  }

  .dashboard-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-gold);
    box-shadow: 0 12px 26px rgba(26, 26, 30, 0.12);
  }

  .card-icon {
    display: inline-flex;
    width: 1.3rem;
    height: 1.3rem;
    color: var(--accent-red);
  }

  .card-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card-label {
    margin: 0.7rem 0 0.3rem;
    color: #64748b;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .dashboard-card h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.1rem;
  }

  .dashboard-card > p:not(.card-label) {
    min-height: 2.8rem;
    margin: 0.55rem 0 0.85rem;
    color: #64748b;
    font-size: 0.84rem;
  }

  .dashboard-card a {
    color: var(--text-main);
    text-decoration: underline;
    text-decoration-color: var(--accent-gold);
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .dynamic-level-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .level-next-step {
      padding-top: 1rem;
      padding-left: 0;
      border-top: 1px solid rgba(229, 169, 59, 0.34);
      border-left: 0;
    }

    .welcome-mark {
      width: 62px;
      height: 62px;
    }

    .welcome-mark svg {
      width: 24px;
      height: 24px;
    }

    .learning-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
