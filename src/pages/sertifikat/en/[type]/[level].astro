---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';

export const prerender = false;

const examType = String(Astro.params.type ?? '').toLowerCase();
const level = String(Astro.params.level ?? '').toUpperCase();
if (!['ielts', 'toefl'].includes(examType)) {
  return new Response('Exam type not found.', { status: 404 });
}
if (!['A1', 'A2', 'B1', 'B2', 'C1', 'C2'].includes(level)) {
  return new Response('Exam level not found.', { status: 404 });
}

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const candidateName = profile?.nama_lengkap
  || user?.user_metadata?.nama_lengkap
  || profile?.nim
  || user?.user_metadata?.nim
  || 'NdUniverse Learner';
const reportTitle = examType === 'ielts' ? 'Test Report Form' : 'Score Report';
---

<DashboardLayout
  title={`${examType.toUpperCase()} ${level} Simulation Report | NdUniverse`}
  description={`NdUniverse ${examType.toUpperCase()} practice exam simulation report for level ${level}.`}
  active="exam"
  user={user}
  profile={profile}
>
  <main
    class="report-page"
    id="certificate-page"
    data-exam-type={examType}
    data-exam-level={level}
    data-candidate-name={candidateName}
    data-report-title={reportTitle}
  >
    <div class="report-toolbar">
      <a class="back-link" href="/en/dashboard">Back to English dashboard</a>
      <p class="verification-status" id="certificate-status" role="status">Verifying passed exam result...</p>
    </div>

    <div class="verification-error" id="certificate-error" role="alert" hidden>
      <h1>Certificate unavailable</h1>
      <p id="certificate-error-message"></p>
      <p>You will be redirected to your dashboard shortly.</p>
      <a href="/en/dashboard">Go to English dashboard now</a>
    </div>

    <section class="certificate-container" id="certificate-container" aria-label="NdUniverse simulation score report" hidden>
      <header class="report-header">
        <div class="brand">
          <img src="/logo-nduniverse.png" alt="NdUniverse" />
          <span>NdUniverse</span>
        </div>
        <div class="report-title">
          <p>ENGLISH EXAM SIMULATION</p>
          <h1>{reportTitle}</h1>
          <span>{examType.toUpperCase()} · {level}</span>
        </div>
      </header>

      <section class="candidate-details" aria-label="Candidate details">
        <div>
          <span class="field-label">Candidate name</span>
          <strong id="candidate-name"></strong>
        </div>
        <div>
          <span class="field-label">Test date</span>
          <strong id="test-date"></strong>
        </div>
        <div>
          <span class="field-label">Candidate number</span>
          <strong id="candidate-number"></strong>
        </div>
      </section>

      <section class="score-report" aria-label="Exam scores">
        <div class="score-grid">
          <div class="grid-heading"><span>Module</span><span>Score</span></div>
          <div id="module-scores"></div>
        </div>
        <div class="overall-score">
          <span id="overall-label"></span>
          <strong id="overall-score"></strong>
          <small id="overall-caption"></small>
        </div>
      </section>

      <footer class="report-footer">
        <div class="signature-block">
          <svg class="simulation-seal" viewBox="0 0 120 120" role="img" aria-label="NdUniverse simulation seal">
            <circle cx="60" cy="60" r="53" />
            <circle cx="60" cy="60" r="46" />
            <path d="M37 67h46M42 67V53l18-13 18 13v14M48 67V55h24v12M54 67v-8h12v8" />
            <text x="60" y="85" text-anchor="middle">SIMULATION</text>
          </svg>
          <div>
            <span class="signature-mark">NdUniverse</span>
            <span class="signature-rule"></span>
            <span class="signature-caption">NdUniverse Learning Team</span>
          </div>
        </div>
        <p class="disclaimer">This is a simulation result generated by NdUniverse. Not an official IELTS/TOEFL certificate.</p>
      </footer>
    </section>

    <div class="download-actions">
      <button class="download-button" id="download-certificate" type="button" disabled>Download PDF</button>
    </div>
  </main>
</DashboardLayout>

<script>
  import html2pdfModule from 'html2pdf.js';
  import {
    getExamResult,
    getIeltsBandScore,
    getToeflTotalScore,
    isPassed,
  } from '@core/game/exam-grading.js';

  const page = document.querySelector('#certificate-page');
  const certificate = document.querySelector('#certificate-container');
  const errorPanel = document.querySelector('#certificate-error');
  const errorMessage = document.querySelector('#certificate-error-message');
  const statusElement = document.querySelector('#certificate-status');
  const downloadButton = document.querySelector('#download-certificate');

  function showUnavailable(message) {
    statusElement.textContent = 'Exam result verification failed.';
    errorMessage.textContent = message;
    errorPanel.hidden = false;
    window.setTimeout(() => window.location.assign('/en/dashboard'), 4000);
  }

  function formatExamDate(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return null;
    return new Intl.DateTimeFormat('en-GB', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    }).format(date);
  }

  function createCandidateNumber(level) {
    const today = new Date();
    const dateCode = [
      String(today.getFullYear()).slice(-2),
      String(today.getMonth() + 1).padStart(2, '0'),
      String(today.getDate()).padStart(2, '0'),
    ].join('');
    const randomCode = String(Math.floor(100000 + Math.random() * 900000));
    return `ND-${dateCode}-${randomCode}-${level}`;
  }

  try {
    const examType = page?.dataset.examType;
    const level = page?.dataset.examLevel;
    const result = getExamResult(examType, level);
    const modules = examType === 'ielts'
      ? ['listening', 'reading', 'writing', 'speaking']
      : ['reading', 'listening', 'speaking', 'writing'];
    const rawScores = modules.map((module) => result?.scores?.[module]);
    const scores = rawScores.map((score) => Number(score));
    const totalScore = Number(result?.totalScore);
    const examDate = formatExamDate(result?.completedAt) ?? formatExamDate(new Date());
    const resultMatchesRoute = (result?.examType == null || String(result.examType).toLowerCase() === examType)
      && (result?.level == null || String(result.level).toUpperCase() === level);
    const hasScoreBreakdown = result?.scores != null;
    const scoresAreValid = !hasScoreBreakdown
      || (scores.every((score) => Number.isFinite(score) && score >= 0 && score <= 100) && isPassed(scores));
    const maximumTotalScore = examType === 'toefl' ? 120 : 100;
    const validPassedResult = result?.passed === true
      && resultMatchesRoute
      && scoresAreValid
      && Number.isFinite(totalScore)
      && totalScore >= 0
      && totalScore <= maximumTotalScore;

    if (!validPassedResult) {
      showUnavailable(`A passed ${examType.toUpperCase()} result for level ${level} was not found.`);
    } else {
      const overallScore = examType === 'ielts'
        ? getIeltsBandScore(hasScoreBreakdown ? scores : [totalScore]).toFixed(1)
        : hasScoreBreakdown
          ? getToeflTotalScore(scores)
          : totalScore;
      document.querySelector('#candidate-name').textContent = page.dataset.candidateName;
      document.querySelector('#test-date').textContent = examDate;
      document.querySelector('#candidate-number').textContent = createCandidateNumber(level);
      document.querySelector('#overall-label').textContent = examType === 'ielts'
        ? 'Overall Band Score'
        : 'Total Score';
      document.querySelector('#overall-score').textContent = examType === 'ielts'
        ? overallScore
        : `${Math.round(overallScore)} / 120`;
      document.querySelector('#overall-caption').textContent = examType === 'ielts'
        ? 'Estimated from the NdUniverse module scores'
        : 'Practice score out of 120';

      const scoreContainer = document.querySelector('#module-scores');
      modules.forEach((module, index) => {
        const row = document.createElement('div');
        row.className = 'score-row';
        const moduleName = document.createElement('span');
        moduleName.textContent = module.charAt(0).toUpperCase() + module.slice(1);
        const score = document.createElement('strong');
        score.textContent = Number.isFinite(scores[index]) ? `${scores[index]}%` : '—';
        row.append(moduleName, score);
        scoreContainer.append(row);
      });

      certificate.hidden = false;
      statusElement.textContent = 'Passed result verified. Your simulation report is ready.';
      downloadButton.disabled = false;
      downloadButton.addEventListener('click', async () => {
        downloadButton.disabled = true;
        statusElement.textContent = 'Preparing your PDF...';
        try {
          const html2pdf = html2pdfModule.default ?? html2pdfModule;
          await html2pdf()
            .set({
              margin: 8,
              filename: `NdUniverse-${examType.toUpperCase()}-${level}-simulation-report.pdf`,
              image: { type: 'jpeg', quality: 0.98 },
              html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
              jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' },
            })
            .from(certificate)
            .save();
          statusElement.textContent = 'Simulation report downloaded.';
        } catch (error) {
          console.error('Failed to generate the English simulation certificate PDF.', error);
          statusElement.textContent = 'The PDF could not be generated. Please try again.';
        } finally {
          downloadButton.disabled = false;
        }
      });
    }
  } catch (error) {
    console.error('Failed to verify the English exam result for certificate access.', error);
    showUnavailable('We could not verify a passed result. Please complete and pass the exam first.');
  }
</script>

<style>
  .report-page {
    --report-ink: var(--text-main, #202a35);
    --report-muted: var(--muted, #66717e);
    --report-gold: var(--accent-gold, #c59b47);
    --report-paper: #fff;
    --report-line: #d7dce2;
    width: min(100%, 1120px);
    margin: 0 auto;
    padding: 1rem 0 2.5rem;
    color: var(--report-ink);
  }
  #certificate-container[hidden],
  #certificate-error[hidden] { display: none !important; }
  .report-toolbar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.75rem; margin-bottom:1rem; }
  .back-link { color:var(--text-main); font-weight:700; text-decoration:none; }
  .verification-status { margin:0; color:var(--muted); font-size:.9rem; }
  .verification-error { padding:1.25rem; border:1px solid #d99494; border-radius:8px; background:var(--card-bg,#fff); }
  .verification-error h1,.verification-error p { margin-top:0; }
  .verification-error a { color:var(--text-main); font-weight:700; }
  .certificate-container {
    box-sizing:border-box;
    width:100%;
    min-height:190mm;
    padding:clamp(1.25rem, 3.5vw, 2.5rem);
    border:1px solid var(--report-ink);
    outline:1px solid var(--report-gold);
    outline-offset:-7px;
    background:var(--report-paper);
    color:var(--report-ink);
    font-family:Georgia, 'Times New Roman', serif;
  }
  .report-header { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding-bottom:1rem; border-bottom:1px solid var(--report-line); }
  .brand { display:flex; align-items:center; gap:.7rem; font-family:Arial, sans-serif; font-size:1.05rem; font-weight:800; }
  .brand img { width:64px; height:64px; object-fit:contain; }
  .report-title { text-align:right; }
  .report-title p,.report-title h1,.report-title span { margin:0; }
  .report-title p,.field-label { color:var(--report-muted); font-family:Arial, sans-serif; font-size:.68rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .report-title h1 { margin:.2rem 0; font-size:clamp(1.5rem, 3vw, 2.2rem); }
  .report-title span { color:var(--report-gold); font-family:Arial, sans-serif; font-size:.8rem; font-weight:800; letter-spacing:.12em; }
  .candidate-details { display:grid; grid-template-columns:1.5fr 1fr 1fr; gap:1rem; padding:1.2rem 0; border-bottom:1px solid var(--report-line); }
  .candidate-details > div { display:grid; gap:.35rem; min-width:0; }
  .candidate-details strong { overflow-wrap:anywhere; font-family:Arial, sans-serif; font-size:.95rem; }
  .score-report { display:grid; grid-template-columns:1.3fr .7fr; align-items:center; gap:2rem; padding:1.4rem 0; }
  .score-grid { border:1px solid var(--report-line); font-family:Arial, sans-serif; }
  .grid-heading,.score-row { display:grid; grid-template-columns:1fr auto; gap:1rem; padding:.7rem .85rem; }
  .grid-heading { background:#f6f3eb; font-size:.72rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .score-row + .score-row { border-top:1px solid var(--report-line); }
  .score-row strong { font-variant-numeric:tabular-nums; }
  .overall-score { display:grid; justify-items:center; gap:.35rem; text-align:center; }
  .overall-score span { font-family:Arial, sans-serif; font-size:.8rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .overall-score strong { font-size:clamp(3rem, 7vw, 4rem); line-height:1; }
  .overall-score small { color:var(--report-muted); font-family:Arial, sans-serif; font-size:.72rem; }
  .report-footer { display:flex; align-items:flex-end; justify-content:space-between; gap:1.5rem; padding-top:1rem; border-top:1px solid var(--report-line); }
  .signature-block { display:flex; align-items:center; gap:.75rem; }
  .simulation-seal { width:76px; height:76px; fill:none; stroke:var(--report-gold); stroke-width:1.5; }
  .simulation-seal text { fill:var(--report-ink); stroke:none; font-family:Arial, sans-serif; font-size:8px; font-weight:700; letter-spacing:.5px; }
  .signature-block > div { display:grid; gap:.2rem; }
  .signature-mark { color:var(--report-gold); font-size:1.35rem; font-style:italic; }
  .signature-rule { width:150px; border-top:1px solid var(--report-ink); }
  .signature-caption { font-family:Arial, sans-serif; font-size:.68rem; }
  .disclaimer { max-width:42%; margin:0; color:var(--report-muted); font-family:Arial, sans-serif; font-size:.68rem; line-height:1.5; text-align:right; }
  .download-actions { display:flex; justify-content:center; padding-top:1rem; }
  .download-button { min-height:46px; padding:.7rem 1.1rem; border:0; border-radius:6px; background:var(--accent-gold); color:var(--text-main); font:inherit; font-weight:800; cursor:pointer; }
  .download-button:disabled { opacity:.55; cursor:not-allowed; }
  @media(max-width:700px) {
    .candidate-details { grid-template-columns:1fr 1fr; }
    .score-report { grid-template-columns:1fr; gap:1.25rem; }
    .overall-score { order:-1; }
    .report-footer { align-items:flex-start; flex-direction:column; }
    .disclaimer { max-width:100%; text-align:left; }
  }
  @media print {
    .report-toolbar,.download-actions { display:none; }
    .report-page { width:100%; margin:0; padding:0; }
    .certificate-container { min-height:0; border:1px solid #202a35; outline-color:#c59b47; }
  }
</style>
