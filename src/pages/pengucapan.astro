---
import Layout from '../layouts/Layout.astro';

const alphabet = [
  { letter: 'A', orthography: 'A', reading: 'Ah', example: 'Apfel', translation: 'apel', spelling: 'Ah - Peh - Ef - Eh - El' },
  { letter: 'B', orthography: 'Be', reading: 'Beh', example: 'Buch', translation: 'buku', spelling: 'Beh - Uh - Tseh - Ha' },
  { letter: 'C', orthography: 'Ce', reading: 'Tseh', example: 'Computer', translation: 'komputer', spelling: 'Tseh - Oh - Em - Peh - Uh - Teh - Eh - Er' },
  { letter: 'D', orthography: 'De', reading: 'Deh', example: 'Danke', translation: 'terima kasih', spelling: 'Deh - Ah - En - Kah - Eh' },
  { letter: 'E', orthography: 'E', reading: 'Eh', example: 'Elefant', translation: 'gajah', spelling: 'Eh - El - Eh - Ef - Ah - En - Teh' },
  { letter: 'F', orthography: 'Ef', reading: 'Ef', example: 'Fisch', translation: 'ikan', spelling: 'Ef - Ih - Es - Tseh - Ha' },
  { letter: 'G', orthography: 'Ge', reading: 'Geh', example: 'Garten', translation: 'kebun', spelling: 'Geh - Ah - Er - Teh - Eh - En' },
  { letter: 'H', orthography: 'Ha', reading: 'Ha', example: 'Haus', translation: 'rumah', spelling: 'Ha - Ah - Uh - Es' },
  { letter: 'I', orthography: 'I', reading: 'Ih', example: 'Insel', translation: 'pulau', spelling: 'Ih - En - Es - Eh - El' },
  { letter: 'J', orthography: 'Jot', reading: 'Yot', example: 'Jahr', translation: 'tahun', spelling: 'Yot - Ah - Ha - Er' },
  { letter: 'K', orthography: 'Ka', reading: 'Kah', example: 'Kind', translation: 'anak', spelling: 'Kah - Ih - En - Deh' },
  { letter: 'L', orthography: 'El', reading: 'El', example: 'Liebe', translation: 'cinta', spelling: 'El - Ih - Eh - Beh - Eh' },
  { letter: 'M', orthography: 'Em', reading: 'Em', example: 'Mutter', translation: 'ibu', spelling: 'Em - Uh - Teh - Teh - Eh - Er' },
  { letter: 'N', orthography: 'En', reading: 'En', example: 'Nacht', translation: 'malam', spelling: 'En - Ah - Tseh - Ha - Teh' },
  { letter: 'O', orthography: 'O', reading: 'Oh', example: 'Orange', translation: 'jeruk', spelling: 'Oh - Er - Ah - En - Geh - Eh' },
  { letter: 'P', orthography: 'Pe', reading: 'Peh', example: 'Pferd', translation: 'kuda', spelling: 'Peh - Ef - Eh - Er - Deh' },
  { letter: 'Q', orthography: 'Qu', reading: 'Kuh', example: 'Quelle', translation: 'sumber', spelling: 'Kuh - Uh - Eh - El - El - Eh' },
  { letter: 'R', orthography: 'Er', reading: 'Er', example: 'Rot', translation: 'merah', spelling: 'Er - Oh - Teh' },
  { letter: 'S', orthography: 'Es', reading: 'Es', example: 'Sonne', translation: 'matahari', spelling: 'Es - Oh - En - En - Eh' },
  { letter: 'T', orthography: 'Te', reading: 'Teh', example: 'Tisch', translation: 'meja', spelling: 'Teh - Ih - Es - Tseh - Ha' },
  { letter: 'U', orthography: 'U', reading: 'Uh', example: 'Uhr', translation: 'jam', spelling: 'Uh - Ha - Er' },
  { letter: 'V', orthography: 'Vau', reading: 'Fau', example: 'Vater', translation: 'ayah', spelling: 'Fau - Ah - Teh - Eh - Er' },
  { letter: 'W', orthography: 'We', reading: 'Weh', example: 'Wasser', translation: 'air', spelling: 'Weh - Ah - Es - Es - Eh - Er' },
  { letter: 'X', orthography: 'Ix', reading: 'Iks', example: 'Xylophon', translation: 'xilofon', spelling: 'Iks - Ypsilon - El - Oh - Peh - Ha - Oh - En' },
  { letter: 'Y', orthography: 'Ypsilon', reading: 'Ypsilon', example: 'Yoga', translation: 'yoga', spelling: 'Ypsilon - Oh - Geh - Ah' },
  { letter: 'Z', orthography: 'Zet', reading: 'Tset', example: 'Zug', translation: 'kereta', spelling: 'Tset - Uh - Geh' },
];

const specialLetters = [
  {
    letter: 'Ä ä',
    name: 'A-Umlaut',
    sound: 'Mirip bunyi “e” pada kata “enak”, dengan mulut terbuka lebih lebar.',
    example: 'Mädchen',
  },
  {
    letter: 'Ö ö',
    name: 'O-Umlaut',
    sound: 'Bentuk bibir membulat seperti “o”, lalu ucapkan bunyi “e”.',
    example: 'Öl',
  },
  {
    letter: 'Ü ü',
    name: 'U-Umlaut',
    sound: 'Bentuk bibir membulat seperti “u”, lalu ucapkan bunyi “i”.',
    example: 'Tür',
  },
  {
    letter: 'ß',
    name: 'Eszett',
    sound: 'Dibaca seperti “ss” yang tajam. Dalam huruf kapital, ß dapat ditulis SS atau ẞ.',
    example: 'Straße',
  },
];

const diphthongs = [
  { combination: 'au', reading: 'au', example: 'Haus', meaning: 'rumah' },
  { combination: 'ei', reading: 'ai', example: 'mein', meaning: 'punyaku' },
  { combination: 'ai', reading: 'ai', example: 'Mai', meaning: 'Mei' },
  { combination: 'eu', reading: 'oi', example: 'Feuer', pronunciation: 'Foi-er', meaning: 'api' },
  { combination: 'äu', reading: 'oi', example: 'Häuser', meaning: 'rumah-rumah' },
  { combination: 'ie', reading: 'ii panjang', example: 'Liebe', pronunciation: 'Lii-be', meaning: 'cinta' },
];
---

<Layout
  title="Panduan Pengucapan (Aussprache) | siDeutsch"
  description="Panduan pengucapan abjad bahasa Jerman, umlaut Ä, Ö, Ü, dan Eszett ß untuk pemula."
>
  <div class="pronunciation-page">
    <header class="page-heading">
      <p class="eyebrow">Panduan Pemula</p>
      <h1>Panduan Pengucapan (Aussprache)</h1>
      <p class="intro-copy">Kenali nama huruf bahasa Jerman dan bunyi khas yang sering muncul saat membaca kata.</p>
    </header>

    <section class="alphabet-section" aria-labelledby="alphabet-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">01 / Alfabet</p>
          <h2 id="alphabet-heading">Abjad A-Z</h2>
        </div>
        <p class="section-note">Ejaan huruf mengikuti bahasa Jerman; kolom “Dibaca” memakai pendekatan bunyi untuk penutur Indonesia.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel pengucapan abjad Jerman" tabindex="0">
        <table class="alphabet-table spelling-table">
          <thead>
            <tr>
              <th scope="col">Huruf</th>
              <th scope="col">Ejaan Huruf</th>
              <th scope="col">Dibaca</th>
              <th scope="col">Contoh Kata</th>
              <th scope="col">Cara Ngeja (Spelling)</th>
            </tr>
          </thead>
          <tbody>
            {alphabet.map(({ letter, orthography, reading, example, translation, spelling }) => (
              <tr>
                <th scope="row" class="letter-cell">{letter}</th>
                <td lang="de">{orthography}</td>
                <td>{reading}</td>
                <td>
                  <div class="example-with-speech">
                    <span lang="de">{example}</span>{translation && <> ({translation})</>}
                    <button class="speech-button" type="button" data-speech={example} aria-label={`Dengarkan ${example}`} title={`Dengarkan ${example}`} disabled>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4H4Z" /><path d="M17 9a5 5 0 0 1 0 6M19.5 6.5a9 9 0 0 1 0 11" /></svg>
                    </button>
                  </div>
                </td>
                <td lang="de">{spelling}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="special-section" aria-labelledby="special-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 / Bunyi khas</p>
          <h2 id="special-heading">Umlaut & Eszett</h2>
        </div>
        <p class="section-note">Tanda titik pada umlaut mengubah bunyi huruf vokalnya.</p>
      </div>

      <div class="special-grid">
        {specialLetters.map(({ letter, name, sound, example }) => (
          <article class="special-item">
            <div class="special-topline">
              <span class="special-letter" lang="de">{letter}</span>
              <h3>{name}</h3>
            </div>
            <p>{sound}</p>
            <p class="example-line">
              <span>Contoh: <span lang="de">{example}</span></span>
              <button class="speech-button" type="button" data-speech={example} aria-label={`Dengarkan ${example}`} title={`Dengarkan ${example}`} disabled>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4H4Z" /><path d="M17 9a5 5 0 0 1 0 6M19.5 6.5a9 9 0 0 1 0 11" /></svg>
              </button>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="alphabet-section" aria-labelledby="diphthong-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">03 / Kombinasi vokal</p>
          <h2 id="diphthong-heading">Kombinasi Vokal dan Diphthong</h2>
        </div>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel kombinasi vokal bahasa Jerman" tabindex="0">
        <table class="alphabet-table">
          <thead>
            <tr>
              <th scope="col">Kombinasi</th>
              <th scope="col">Dibaca</th>
              <th scope="col">Contoh Kata</th>
            </tr>
          </thead>
          <tbody>
            {diphthongs.map(({ combination, reading, example, pronunciation, meaning }) => (
              <tr>
                <th scope="row" class="letter-cell" lang="de">{combination}</th>
                <td>{reading}</td>
                <td>
                  <div class="example-with-speech">
                    <span><span lang="de">{example}</span>{pronunciation && <> ({pronunciation})</>} ({meaning})</span>
                    <button class="speech-button" type="button" data-speech={example} aria-label={`Dengarkan ${example}`} title={`Dengarkan ${example}`} disabled>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4H4Z" /><path d="M17 9a5 5 0 0 1 0 6M19.5 6.5a9 9 0 0 1 0 11" /></svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="section-note diphthong-note"><span lang="de">ie</span> bukan diftong; gabungan ini menandai bunyi vokal <em>i</em> panjang, seperti pada <span lang="de">Liebe</span>.</p>
    </section>
  </div>
</Layout>

<script>
  const speechSupported = () =>
    'speechSynthesis' in window && typeof SpeechSynthesisUtterance !== 'undefined';

  const configureSpeechButtons = () => {
    const supported = speechSupported();
    document.querySelectorAll<HTMLButtonElement>('.speech-button').forEach((button) => {
      button.disabled = !supported;
    });
  };

  document.addEventListener('astro:page-load', configureSpeechButtons);
  configureSpeechButtons();

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('.speech-button');
    if (!button || button.disabled || !speechSupported()) return;

    const utterance = new SpeechSynthesisUtterance(button.dataset.speech ?? '');
    utterance.lang = 'de-DE';
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(utterance);
  });
</script>

<style>
  .pronunciation-page {
    display: grid;
    gap: 2.8rem;
    padding-top: 0.5rem;
  }

  .page-heading {
    max-width: 780px;
  }

  .alphabet-section {
    min-width: 0;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.55rem;
    color: #806018;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    color: var(--text-main);
    font-size: 2.35rem;
    line-height: 1.15;
  }

  .intro-copy {
    max-width: 660px;
    margin: 0.85rem 0 0;
    color: var(--muted);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.45rem;
  }

  .section-note {
    max-width: 430px;
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .table-scroll {
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    border: 1px solid rgba(43, 45, 66, 0.16);
    border-radius: 8px;
    background: var(--bg-main);
    scrollbar-color: var(--accent-gold) rgba(43, 45, 66, 0.08);
  }

  .alphabet-table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    text-align: left;
  }

  .spelling-table {
    min-width: 1040px;
  }

  .spelling-table th:nth-child(1) { width: 6%; }
  .spelling-table th:nth-child(2) { width: 11%; }
  .spelling-table th:nth-child(3) { width: 12%; }
  .spelling-table th:nth-child(4) { width: 17%; }
  .spelling-table th:nth-child(5) { width: 54%; }

  .alphabet-table th,
  .alphabet-table td {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(43, 45, 66, 0.09);
  }

  .alphabet-table thead th {
    background: var(--bg-dark);
    color: #fff;
    font-size: 0.77rem;
    font-weight: 700;
  }

  .alphabet-table tbody tr:nth-child(even) {
    background: rgba(229, 169, 59, 0.1);
  }

  .alphabet-table tbody tr:last-child th,
  .alphabet-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .alphabet-table tbody th,
  .alphabet-table tbody td {
    font-size: 0.9rem;
  }

  .letter-cell {
    width: 18%;
    color: var(--text-main);
    font-size: 1rem !important;
    font-weight: 800;
  }

  .alphabet-table td:last-child,
  .example-line span {
    color: #76520d;
    font-weight: 700;
  }

  .example-with-speech,
  .example-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .speech-button {
    display: inline-grid;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(229, 169, 59, 0.55);
    border-radius: 6px;
    background: rgba(229, 169, 59, 0.12);
    color: var(--accent-gold);
    cursor: pointer;
    transition: transform 0.16s ease, color 0.16s ease, background-color 0.16s ease;
  }

  .speech-button svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .speech-button:hover:not(:disabled) {
    transform: scale(1.08);
    background: var(--accent-gold);
    color: var(--text-main);
  }

  .speech-button:focus-visible {
    outline: 3px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .speech-button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }

  .special-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .special-item {
    min-width: 0;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(43, 45, 66, 0.13);
    border-left: 4px solid var(--accent-gold);
    border-radius: 6px;
    background: #fff;
  }

  .special-topline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .special-letter {
    color: #76520d;
    font-size: 1.7rem;
    font-weight: 800;
    line-height: 1;
  }

  .special-topline h3 {
    margin: 0;
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .special-item p {
    margin-bottom: 0.55rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .special-item .example-line {
    margin-bottom: 0;
    color: var(--text-main);
  }

  @media (max-width: 640px) {
    .pronunciation-page {
      gap: 2.1rem;
    }

    h1 {
      font-size: 1.85rem;
    }

    .section-heading {
      display: block;
    }

    .section-note {
      margin-top: 0.6rem;
    }

    .special-grid {
      grid-template-columns: 1fr;
    }
  }
</style>