---
import AuthPortal from '@core/auth/AuthPortal.astro';
import { isAdminNim } from '@core/auth/admin';

if (Astro.locals.user) {
  return Astro.redirect(isAdminNim(Astro.locals.profile?.nim) ? '/admin' : '/en/dashboard');
}
---

<AuthPortal
  portal="student"
  language="en"
  title="Login | English - NdUniverse"
  eyebrow="English Learning Portal"
  heading="Welcome back!"
  description="Sign in with your email or student ID."
  buttonText="Sign in"
/>
