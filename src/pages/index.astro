---
const title = 'NdUniverse - Platform Belajar Bahasa Jerman & Inggris';
const description = 'Belajar bahasa Jerman dan Inggris dengan materi CEFR, latihan empat pilar, persiapan Goethe, IELTS, TOEFL, dan dukungan tutor AI.';
const siteUrl = Astro.site ?? 'https://nduniverse.ndhistira.my.id';
const canonicalUrl = new URL('/', siteUrl).toString();
const imageUrl = new URL('/android-chrome-512x512.png', siteUrl).toString();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NdUniverse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="id" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={new URL('/en', siteUrl).toString()} />
    <link rel="alternate" hreflang="de" href={new URL('/de', siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <title>{title}</title>
  </head>
  <body>
    <main class="landing-shell">
      <section class="hero-section" aria-labelledby="page-title">
        <p class="hero-kicker">A global learning platform</p>
        <img src="/logo-nduniverse.png" alt="NdUniverse" class="brand-logo" />
        <h1 id="page-title">NdUniverse</h1>
        <p class="tagline">Connecting Languages &amp; Cultures</p>
      </section>

      <section class="about-section content-section" aria-labelledby="about-title">
        <div class="section-marker">01 / THE UNIVERSE</div>
        <div class="about-copy">
          <h2 id="about-title">Satu ruang untuk bahasa, budaya, dan kesempatan global.</h2>
          <p>NdUniverse adalah platform belajar bahasa terpadu. Kami menyediakan kurikulum standar internasional (CEFR/IELTS/TOEFL) dan simulasi ujian untuk mempersiapkan karir global Anda.</p>
        </div>
      </section>

      <section class="features-section content-section" aria-labelledby="features-title">
        <div class="section-marker">02 / WHAT YOU CAN DO</div>
        <div>
          <h2 id="features-title" class="section-title">Belajar dengan arah yang jelas.</h2>
          <div class="feature-grid">
            <article class="feature-card">
              <span class="feature-icon" aria-hidden="true">◈</span>
              <h3>4 Pilar CEFR</h3>
              <p>Bangun kemampuan Reading, Listening, Writing, dan Speaking secara seimbang.</p>
            </article>
            <article class="feature-card">
              <span class="feature-icon" aria-hidden="true">◇</span>
              <h3>Sertifikasi &amp; Ujian</h3>
              <p>Latih diri melalui simulasi ujian standar internasional dengan target yang terukur.</p>
            </article>
            <article class="feature-card">
              <span class="feature-icon" aria-hidden="true">✦</span>
              <h3>Persiapan Karir</h3>
              <p>Pelajari bahasa profesional dan siapkan diri untuk kesempatan kerja lintas negara.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="language-section content-section" aria-labelledby="language-title">
        <div class="section-marker">03 / CHOOSE YOUR MODULE</div>
        <div>
          <h2 id="language-title" class="section-title">Mulai dari bahasa yang ingin Anda kuasai.</h2>
          <nav class="language-grid" aria-label="Pilih modul bahasa">
            <a class="language-card" href="/login-en">
              <span class="flag" aria-hidden="true">🇬🇧</span>
              <span class="language-copy">
                <strong>English</strong>
                <span>IELTS/TOEFL Prep</span>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
            <a class="language-card" href="/login-de">
              <span class="flag" aria-hidden="true">🇩🇪</span>
              <span class="language-copy">
                <strong>German</strong>
                <span>Goethe-Zertifikat Prep</span>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </nav>
        </div>
      </section>

      <footer class="landing-footer">
        <span>NdUniverse</span>
        <span>© 2026 NdUniverse. Connecting Languages &amp; Cultures.</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(:root) { --nd-bg-dark:#0b1520; --nd-bg-deep:#071019; --nd-gold:#e5a93b; --nd-gold-soft:#f1dfb2; --nd-text:#f8fafc; --nd-muted:rgba(248,250,252,.66); --nd-line:rgba(229,169,59,.28); }
  :global(*) { box-sizing:border-box; }
  :global(html) { min-width:320px; min-height:100%; scroll-behavior:smooth; }
  :global(body) { min-width:320px; min-height:100vh; margin:0; background:var(--nd-bg-dark); color:var(--nd-text); font-family:'Plus Jakarta Sans',ui-sans-serif,sans-serif; }
  .landing-shell { position:relative; overflow:hidden; padding:clamp(3rem,7vw,6rem) clamp(1.25rem,5vw,5rem) 1.5rem; background:radial-gradient(circle at 75% 4%,rgba(229,169,59,.14),transparent 25%),linear-gradient(145deg,var(--nd-bg-dark),var(--nd-bg-deep) 72%); }
  .landing-shell::before { position:absolute; top:0; right:8%; width:1px; height:100%; background:linear-gradient(180deg,transparent,var(--nd-line) 25%,transparent 80%); content:""; opacity:.5; pointer-events:none; }
  .hero-section { display:grid; min-height:min(78vh,760px); align-content:center; justify-items:center; padding:3rem 0 6rem; text-align:center; }
  .hero-kicker,.section-marker { color:var(--nd-gold); font-size:.7rem; font-weight:800; letter-spacing:.18em; text-transform:uppercase; }
  .hero-kicker { margin:0 0 1.4rem; }
  .brand-logo { width:180px; max-width:60vw; height:auto; margin-bottom:1.2rem; object-fit:contain; }
  h1 { margin:0; color:var(--nd-text); font-size:clamp(3.5rem,11vw,9rem); letter-spacing:.015em; line-height:.9; }
  .tagline { margin:1.25rem 0 0; color:var(--nd-muted); font-size:clamp(1rem,2.4vw,1.35rem); letter-spacing:.06em; }
  .content-section { position:relative; display:grid; grid-template-columns:minmax(150px,.38fr) minmax(0,1.62fr); gap:clamp(1.5rem,6vw,6rem); max-width:1200px; margin:0 auto; padding:clamp(4rem,9vw,8rem) 0; border-top:1px solid var(--nd-line); }
  .section-marker { padding-top:.35rem; }
  .about-copy { max-width:820px; }
  .about-copy h2,.section-title { margin:0; color:var(--nd-text); font-size:clamp(2rem,4.7vw,4.4rem); font-weight:600; letter-spacing:-.02em; line-height:1.05; }
  .about-copy p { max-width:680px; margin:1.5rem 0 0; color:var(--nd-muted); font-size:clamp(1rem,1.7vw,1.2rem); line-height:1.8; }
  .feature-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:2rem; }
  .feature-card { min-height:220px; padding:1.35rem; border:1px solid var(--nd-line); border-radius:.8rem; background:rgba(255,255,255,.035); transition:transform .2s ease,background-color .2s ease,border-color .2s ease; }
  .feature-card:hover { border-color:var(--nd-gold); background:rgba(229,169,59,.08); transform:translateY(-4px); }
  .feature-icon { display:block; margin-bottom:2.5rem; color:var(--nd-gold); font-size:2rem; line-height:1; }
  .feature-card h3 { margin:0; color:var(--nd-text); font-size:1.05rem; }
  .feature-card p { margin:.65rem 0 0; color:var(--nd-muted); font-size:.85rem; line-height:1.65; }
  .language-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-top:2rem; }
  .language-card { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:1rem; min-height:125px; padding:1.25rem; border:1px solid var(--nd-line); border-radius:.8rem; background:rgba(255,255,255,.045); color:var(--nd-text); text-decoration:none; transition:transform .2s ease,background-color .2s ease,border-color .2s ease; }
  .language-card:hover,.language-card:focus-visible { border-color:var(--nd-gold); background:rgba(229,169,59,.1); transform:translateY(-4px); }
  .flag { font-size:2.2rem; line-height:1; }
  .language-copy { display:grid; min-width:0; gap:.3rem; }
  .language-copy strong { font-size:1.2rem; }
  .language-copy span { color:var(--nd-muted); font-size:.8rem; overflow-wrap:anywhere; }
  .arrow { color:var(--nd-gold); font-size:1.35rem; }
  .landing-footer { display:flex; max-width:1200px; align-items:center; justify-content:space-between; gap:1rem; margin:0 auto; padding:1.5rem 0 .5rem; border-top:1px solid var(--nd-line); color:rgba(248,250,252,.46); font-size:.72rem; }
  .landing-footer span:first-child { color:var(--nd-gold-soft); font-weight:800; letter-spacing:.08em; }
  @media (max-width:768px) { .landing-shell { padding-inline:1rem; } .hero-section { min-height:70vh; padding-bottom:4rem; } .brand-logo { width:min(180px,70vw); max-height:180px; } .content-section { grid-template-columns:1fr; gap:1.5rem; padding:4rem 0; } .feature-grid,.language-grid { grid-template-columns:1fr; } .feature-card { min-height:0; } .feature-icon { margin-bottom:1.5rem; } .language-card { min-width:0; } .landing-footer { align-items:flex-start; flex-direction:column; } }
  @media (prefers-reduced-motion:reduce) { .feature-card,.language-card { transition:none; } }
</style>
