---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import HelpContent from '../components/HelpContent.astro';

export const prerender = false;

const user = Astro.locals.user;
const profile = Astro.locals.profile;
---

<DashboardLayout
  title="Bantuan | siDeutsch"
  description="Panduan akun, kuis, XP, bookmark, dan pengaturan password siDeutsch."
  active="help"
  user={user}
  profile={profile}
>
  <HelpContent showPublicLink />
</DashboardLayout>
