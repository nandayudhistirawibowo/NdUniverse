---
import Layout from '@core/ui/Layout.astro';
import { getEntry, render } from 'astro:content';
import { normalizePassedPillars } from '@core/db/progress-client.js';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login-de');

const item = await getEntry('materi', Astro.params.slug ?? '');
if (!item) return new Response('Materi tidak ditemukan.', { status: 404 });

const { Content } = await render(item);
const trackLabel = item.data.track === 'Alltagsdeutsch' ? 'Alltagsdeutsch' : 'Fachdeutsch';
const levelOrJurusan = item.data.track === 'Alltagsdeutsch' ? item.data.level : item.data.jurusan;
const batchSize = 5;
const sessionCount = Math.ceil(item.data.vocab.length / batchSize);
const notesKey = `catatan_materi_${item.id}`;
const referer = Astro.request.headers.get('referer');
let dashboardReturnHref = item.data.track === 'Alltagsdeutsch' ? '/dashboard/alltags' : '/dashboard/fach';

if (referer) {
  try {
    const source = new URL(referer);
    const sourcePath = source.pathname;
    if (source.origin === Astro.url.origin && (sourcePath === '/dashboard' || sourcePath.startsWith('/dashboard/'))) {
      if (['/dashboard', '/dashboard/katalog', '/dashboard/alltags', '/dashboard/fach', '/dashboard/profil'].includes(sourcePath)) {
        dashboardReturnHref = sourcePath;
      }
    }
  } catch {
    // Keep the track-specific dashboard fallback when the referrer is invalid.
  }
}

const publicReturnHref = item.data.track === 'Alltagsdeutsch' ? '/alltagsdeutsch' : '/fachdeutsch';
const returnHref = user ? dashboardReturnHref : publicReturnHref;
const { data: savedProgress } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('sessions_passed, notes')
    .eq('user_id', user.id)
    .eq('material_slug', item.id)
    .eq('language_code', 'de')
    .maybeSingle()
  : { data: null };
const passedPillars = normalizePassedPillars(savedProgress?.sessions_passed);
const vocabSessions = Array.from({ length: sessionCount }, (_, index) => ({
  sessionNumber: index + 1,
  vocab: item.data.vocab.slice(index * batchSize, (index + 1) * batchSize),
}));
---

<Layout
  title={`${item.data.judulMateri} | siDeutsch`}
  description={item.data.deskripsi}
  hideNavbar={true}
>
  <article class="page-shell">
    <header class="page-header">
      <p class="eyebrow">{item.data.fakultas ?? item.data.jurusan ?? 'Materi'} • {trackLabel}</p>
      <h1>{item.data.judulMateri}</h1>
      <div class="meta-row">
        <div class="meta-badges">
          <span class="pill">{trackLabel}</span>
          {levelOrJurusan && <span class="pill soft">{levelOrJurusan}</span>}
        </div>
        <a href={returnHref}>← Kembali ke Dashboard</a>
      </div>
    </header>

    <section class="content-panel">
      <div class="lesson-copy prose">
        <Content />
      </div>

      <section class="session-list" aria-labelledby="vocabulary-title">
        <header class="vocabulary-heading">
          <div>
            <p class="eyebrow">Bantuan</p>
            <h2 id="vocabulary-title">Kosakata per Sesi</h2>
            <p>Hafalkan kosakata berikut sebelum memulai latihan.</p>
          </div>
          <span>{item.data.vocab.length} kosakata</span>
        </header>

        {vocabSessions.map((session) => (
          <section class="sesi-card" aria-labelledby={`session-vocab-${session.sessionNumber}`}>
            <div class="sesi-heading">
              <h3 id={`session-vocab-${session.sessionNumber}`}>
                Sesi {session.sessionNumber}: Kosakata {((session.sessionNumber - 1) * batchSize) + 1}-{Math.min(session.sessionNumber * batchSize, item.data.vocab.length)}
              </h3>
              <span>{session.vocab.length} kata</span>
            </div>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Bahasa Jerman</th>
                    <th scope="col">Bahasa Indonesia</th>
                    <th scope="col">Dengar</th>
                  </tr>
                </thead>
                <tbody>
                  {session.vocab.map((entry) => (
                    <tr>
                      <td lang="de">{entry.german}</td>
                      <td>{entry.indonesian}</td>
                      <td>
                        <button
                          class="vocab-speech-button"
                          type="button"
                          data-speech={entry.german}
                          aria-label={`Dengarkan ${entry.german}`}
                          title={`Dengarkan ${entry.german}`}
                        >🔊</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="pillar-buttons" aria-label={`Latihan Sesi ${session.sessionNumber}`}>
              {(['reading', 'listening', 'writing', 'speaking'] as const).map((pillar) => {
                const label = pillar === 'reading' ? 'Membaca' : pillar === 'listening' ? 'Menyimak' : pillar === 'writing' ? 'Menulis' : 'Berbicara';
                const sessionPillarKey = `s${session.sessionNumber}-${pillar}`;
                const isComplete = passedPillars.includes(sessionPillarKey) || (session.sessionNumber === 1 && passedPillars.includes(pillar));
                return (
                  <a
                    href={`/materi/${item.id}/latihan?type=${pillar}&session=${session.sessionNumber}`}
                    data-progress-pillar={pillar}
                    data-progress-session={session.sessionNumber}
                    data-progress-slug={item.id}
                    data-progress-language="de"
                    data-pillar-label={label}
                    class={isComplete ? 'is-complete' : ''}
                    aria-label={`${label}${isComplete ? ' selesai' : ''}`}
                  >
                    <span data-pillar-check aria-hidden="true">{isComplete ? '✓ ' : ''}</span>{label}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </section>
    </section>

    {user && (
      <section class="notes-panel" aria-labelledby="notes-title">
        <label id="notes-title" for="learning-notes">Catatan Belajar Lu</label>
        <textarea
          id="learning-notes"
          data-learning-notes
          data-notes-key={notesKey}
          placeholder="Tulis catatan atau rangkuman lu di sini..."
          rows="6"
        >{savedProgress?.notes ?? ''}</textarea>
        <p class="notes-status" data-notes-status aria-live="polite">Catatan tersimpan otomatis.</p>
      </section>
    )}
  </article>
</Layout>

<script>
  import { playAudioTTS } from '@german/config/german-speech.js';

  import {
    fetchUserProgress,
    getProgressClient,
    normalizePassedSessions,
    upsertUserProgress,
  } from '@core/db/progress-client.js';

  window.addEventListener('nd:progress-updated', (event) => {
    const { slug, languageCode, pillars } = (event as CustomEvent<{
      slug: string;
      languageCode: string;
      pillars: string[];
    }>).detail;
    if (languageCode !== 'de') return;

    document.querySelectorAll<HTMLAnchorElement>('[data-progress-pillar]').forEach((link) => {
      if (link.dataset.progressSlug !== slug) return;
      const sessionNum = Number(link.dataset.progressSession || 1);
      const pillarType = link.dataset.progressPillar ?? '';
      const sessionPillarKey = `s${sessionNum}-${pillarType}`;
      const isComplete = pillars.includes(sessionPillarKey) || (sessionNum === 1 && pillars.includes(pillarType));
      const label = link.dataset.pillarLabel ?? '';
      link.classList.toggle('is-complete', isComplete);
      link.setAttribute('aria-label', `${label}${isComplete ? ' selesai' : ''}`);
      const check = link.querySelector<HTMLElement>('[data-pillar-check]');
      if (check) check.textContent = isComplete ? '✓ ' : '';
    });
  });

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('.vocab-speech-button').forEach((button) => {
      button.onclick = () => {
        const speechText = String(button.dataset.speech ?? '').replace(/\s+/g, ' ').trim();
        playAudioTTS(speechText, button);
      };
    });

  const notesField = document.querySelector<HTMLTextAreaElement>('[data-learning-notes]');
  const notesStatus = document.querySelector<HTMLElement>('[data-notes-status]');
  const notesKey = notesField?.dataset.notesKey;
  const progressClient = getProgressClient();
  let notesUserId: string | null = null;
  let notesEdited = false;
  let notesSaveTimer = 0;

  if (notesField && notesKey) {
    try {
      notesField.value = window.localStorage.getItem(notesKey) ?? '';
    } catch {
      if (notesStatus) notesStatus.textContent = 'Penyimpanan lokal tidak tersedia di browser ini.';
    }

    notesField.addEventListener('input', () => {
      notesEdited = true;
      try {
        window.localStorage.setItem(notesKey, notesField.value);
        if (notesStatus) notesStatus.textContent = 'Catatan tersimpan.';
      } catch {
        if (notesStatus) notesStatus.textContent = 'Catatan belum bisa disimpan di browser ini.';
      }

      if (notesUserId) {
        window.clearTimeout(notesSaveTimer);
        notesSaveTimer = window.setTimeout(async () => {
          try {
            await upsertUserProgress(progressClient, notesUserId, notesKey.replace('catatan_materi_', ''), {
              notes: notesField.value,
            });
            if (notesStatus) notesStatus.textContent = 'Catatan tersimpan.';
          } catch {
            if (notesStatus) notesStatus.textContent = 'Catatan tersimpan di browser; sinkronisasi tertunda.';
          }
        }, 500);
      }
    });

    if (progressClient) {
      void (async () => {
        try {
          const { data: { user } } = await progressClient.auth.getUser();
          if (!user) return;
          const materialSlug = notesKey.replace('catatan_materi_', '');
          const remoteProgress = await fetchUserProgress(progressClient, user.id, materialSlug);
          notesUserId = user.id;

          if (notesEdited) {
            await upsertUserProgress(progressClient, user.id, materialSlug, { notes: notesField.value });
          } else if (remoteProgress?.notes) {
            notesField.value = remoteProgress.notes;
            window.localStorage.setItem(notesKey, remoteProgress.notes);
          } else if (notesField.value) {
            await upsertUserProgress(progressClient, user.id, materialSlug, { notes: notesField.value });
          }
        } catch {
          if (notesStatus) notesStatus.textContent = 'Catatan tetap tersedia di browser; sinkronisasi tertunda.';
        }
      })();
    }
  }
  });
</script>

<style>
