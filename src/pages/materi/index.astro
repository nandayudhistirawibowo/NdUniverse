---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const materi = await getCollection('materi');
const sortedMateri = materi.toSorted((first, second) =>
  first.data.judulMateri.localeCompare(second.data.judulMateri, 'id')
);
---

<Layout
  title="Semua Materi | siDeutsch"
  description="Jelajahi seluruh materi Alltagsdeutsch dan Fachdeutsch siDeutsch."
>
  <main class="catalog-page">
    <header class="page-hero">
      <p class="eyebrow">Katalog pembelajaran</p>
      <h1>Semua Materi</h1>
      <p class="intro">Jelajahi materi bahasa Jerman sehari-hari dan kosakata sesuai bidang studi.</p>
    </header>

    <label class="search-field" for="material-search">
      <span>Cari materi berdasarkan judul</span>
      <input
        id="material-search"
        type="search"
        placeholder="Contoh: Perkenalan Dasar"
        autocomplete="off"
      />
    </label>

    <p id="search-status" class="search-status" aria-live="polite">
      {sortedMateri.length} materi
    </p>

    <div class="materi-grid" id="material-grid">
      {sortedMateri.map((item) => (
        <a
          class="materi-card"
          href={`/materi/${item.id}`}
          data-material-card
          data-title={item.data.judulMateri.toLocaleLowerCase('id')}
        >
          <p class="category">{item.data.track}</p>
          <h2>{item.data.judulMateri}</h2>
          <p class="description">{item.data.deskripsi}</p>
          <div class="card-meta">
            {item.data.level && <span>{item.data.level}</span>}
            {item.data.jurusan && <span>{item.data.jurusan}</span>}
          </div>
        </a>
      ))}
    </div>

    <p id="no-results" class="no-results" hidden>Tidak ada materi dengan judul tersebut.</p>
  </main>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#material-search');
  const materialCards = Array.from(document.querySelectorAll<HTMLElement>('[data-material-card]'));
  const searchStatus = document.querySelector<HTMLElement>('#search-status');
  const noResults = document.querySelector<HTMLElement>('#no-results');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLocaleLowerCase('id');
    let visibleCount = 0;

    for (const card of materialCards) {
      const matches = card.dataset.title?.includes(query) ?? false;
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    if (searchStatus) {
      searchStatus.textContent = `${visibleCount} materi`;
    }

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
  });
</script>

<style>
  .catalog-page {
    padding-top: 1rem;
  }

  .page-hero {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .intro {
    margin: 0.75rem 0 0;
    max-width: 700px;
    color: var(--muted);
    line-height: 1.7;
  }

  .search-field {
    display: grid;
    gap: 0.5rem;
    max-width: 560px;
    color: var(--text-dark);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .search-field input {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: var(--card-bg);
    color: var(--text-dark);
    font: inherit;
  }

  .search-field input:focus-visible {
    outline: 3px solid rgba(229, 169, 59, 0.24);
    border-color: var(--accent-gold);
  }

  .search-status {
    margin: 1.25rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .materi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .materi-card {
    display: flex;
    min-height: 210px;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card-bg);
    color: var(--text-dark);
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(26, 26, 30, 0.05);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .materi-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-gold);
    box-shadow: 0 10px 20px rgba(229, 169, 59, 0.18);
  }

  .category {
    margin: 0 0 0.5rem;
    color: var(--text-main);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .materi-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .materi-card .description {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    flex: 1;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .card-meta span {
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-red);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .no-results {
    margin-top: 1.5rem;
    color: var(--muted);
  }

  [hidden] {
    display: none !important;
  }
</style>
