---
import Layout from '../../layouts/Layout.astro';
import HelpHint from '../../components/HelpHint.jsx';

const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
---

<Layout
  title="Alltagsdeutsch | siDeutsch"
  description="Pilih level CEFR untuk memulai belajar bahasa Jerman sehari-hari."
>
  <section class="page-shell">
    <a class="dashboard-back-link" href="/">← Kembali ke Beranda</a>
    <div class="level-heading">
      <div>
        <p class="eyebrow">Alltagsdeutsch</p>
        <div class="heading-title">
          <h1>Pilih Level Kamu</h1>
          <HelpHint title="Belajar Bertahap" text="Pilih materi, pelajari kosakata per sesi, lalu latih 4 pilar CEFR (Reading, Listening, Writing, Speaking)." client:load />
        </div>
        <p class="lead">Mulai dari percakapan dasar hingga komunikasi lanjutan dalam kehidupan sehari-hari.</p>
      </div>
      <a class="goethe-button" href="/ujian/goethe">Simulate Goethe-Zertifikat</a>
    </div>

    <div class="level-grid">
      {levels.map((level) => (
        <a class="level-card" href={`/alltagsdeutsch/${level}`}>
          <span class="level-badge">{level}</span>
          <h2>{level}</h2>
          <p>
            {level === 'A1' && 'Pelajaran dasar untuk perkenalan dan percakapan sederhana.'}
            {level === 'A2' && 'Komunikasi dasar dalam rutinitas dan kegiatan harian.'}
            {level === 'B1' && 'Menjelajah topik seperti pekerjaan, transportasi, dan kehidupan sosial.'}
            {level === 'B2' && 'Diskusi yang lebih lancar dan detail untuk situasi nyata.'}
            {level === 'C1' && 'Pemahaman bahasa yang kuat untuk konteks kompleks dan profesional.'}
            {level === 'C2' && 'Kebebasan ekspresi tingkat mahir dalam semua situasi.'}
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .dashboard-back-link {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 1.1rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .dashboard-back-link:hover {
    border-color: var(--accent-gold);
    background: rgba(229, 169, 59, 0.1);
  }

  .page-shell {
    padding-top: 1rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .heading-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .level-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .goethe-button {
    flex: 0 0 auto;
    padding: 0.72rem 1rem;
    border: 1px solid var(--accent-gold);
    border-radius: 0.65rem;
    background: var(--accent-gold);
    color: #4b3508;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(229, 169, 59, 0.18);
  }

  .lead {
    margin-top: 0.75rem;
    max-width: 720px;
    color: var(--text-dark);
    line-height: 1.7;
  }

  .level-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .level-card {
    display: block;
    padding: 1.3rem;
    border-radius: 12px;
    background: var(--card-bg);
    border: 2px solid var(--accent-gold);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .level-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-gold);
    box-shadow: 0 10px 20px rgba(229, 169, 59, 0.18);
  }

  .level-badge {
    display: inline-flex;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-red);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0.9rem 0 0.5rem;
    font-size: 1.8rem;
  }

  .level-card p {
    margin: 0;
    color: var(--text-dark);
    line-height: 1.7;
  }
</style>
