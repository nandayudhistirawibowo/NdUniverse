---
import Layout from '../../layouts/Layout.astro';

const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
---

<Layout
  title="Alltagsdeutsch | siDeutsch"
  description="Pilih level CEFR untuk memulai belajar bahasa Jerman sehari-hari."
>
  <section class="page-shell">
    <p class="eyebrow">Alltagsdeutsch</p>
    <h1>Pilih Level Kamu</h1>
    <p class="lead">Mulai dari percakapan dasar hingga komunikasi lanjutan dalam kehidupan sehari-hari.</p>

    <div class="level-grid">
      {levels.map((level) => (
        <a class="level-card" href={`/alltagsdeutsch/${level}`}>
          <span class="level-badge">{level}</span>
          <h2>{level}</h2>
          <p>
            {level === 'A1' && 'Pelajaran dasar untuk perkenalan dan percakapan sederhana.'}
            {level === 'A2' && 'Komunikasi dasar dalam rutinitas dan kegiatan harian.'}
            {level === 'B1' && 'Menjelajah topik seperti pekerjaan, transportasi, dan kehidupan sosial.'}
            {level === 'B2' && 'Diskusi yang lebih lancar dan detail untuk situasi nyata.'}
            {level === 'C1' && 'Pemahaman bahasa yang kuat untuk konteks kompleks dan profesional.'}
            {level === 'C2' && 'Kebebasan ekspresi tingkat mahir dalam semua situasi.'}
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-shell {
    padding-top: 1rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .lead {
    margin-top: 0.75rem;
    max-width: 720px;
    color: var(--text-dark);
    line-height: 1.7;
  }

  .level-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .level-card {
    display: block;
    padding: 1.3rem;
    border-radius: 12px;
    background: var(--card-bg);
    border: 2px solid var(--accent-gold);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .level-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-gold);
    box-shadow: 0 10px 20px rgba(229, 169, 59, 0.18);
  }

  .level-badge {
    display: inline-flex;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-red);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0.9rem 0 0.5rem;
    font-size: 1.8rem;
  }

  .level-card p {
    margin: 0;
    color: var(--text-dark);
    line-height: 1.7;
  }
</style>
