---
import Layout from '../layouts/Layout.astro';
import GrammarSpeech from '../components/GrammarSpeech.astro';

const articles = [
  { article: 'der', gender: 'Maskulin', example: 'der Mann', meaning: 'pria' },
  { article: 'die', gender: 'Feminin', example: 'die Frau', meaning: 'wanita' },
  { article: 'das', gender: 'Netral', example: 'das Kind', meaning: 'anak' },
];

const conjugations = [
  { pronoun: 'ich', sein: 'bin', haben: 'habe' },
  { pronoun: 'du', sein: 'bist', haben: 'hast' },
  { pronoun: 'er', sein: 'ist', haben: 'hat' },
  { pronoun: 'sie', sein: 'ist', haben: 'hat' },
  { pronoun: 'es', sein: 'ist', haben: 'hat' },
  { pronoun: 'wir', sein: 'sind', haben: 'haben' },
  { pronoun: 'ihr', sein: 'seid', haben: 'habt' },
  { pronoun: 'sie', sein: 'sind', haben: 'haben' },
  { pronoun: 'Sie', sein: 'sind', haben: 'haben' },
];

const sentenceExamples = [
  { sentence: 'Ich lerne Deutsch.', structure: 'Subjek + Verb + Objek', meaning: 'Saya belajar bahasa Jerman.' },
  { sentence: 'Heute lerne ich Deutsch.', structure: 'Keterangan + Verb + Subjek + Objek', meaning: 'Hari ini saya belajar bahasa Jerman.' },
];

const questionWords = [
  { word: 'Wer', meaning: 'Siapa', example: 'Wer bist du?', translation: 'Siapa kamu?' },
  { word: 'Was', meaning: 'Apa', example: 'Was lernst du?', translation: 'Apa yang kamu pelajari?' },
  { word: 'Wo', meaning: 'Di mana', example: 'Wo wohnst du?', translation: 'Kamu tinggal di mana?' },
  { word: 'Wann', meaning: 'Kapan', example: 'Wann beginnt der Kurs?', translation: 'Kapan kursus dimulai?' },
  { word: 'Warum', meaning: 'Mengapa', example: 'Warum lernst du Deutsch?', translation: 'Mengapa kamu belajar bahasa Jerman?' },
  { word: 'Wie', meaning: 'Bagaimana', example: 'Wie heißt du?', translation: 'Siapa namamu?' },
  { word: 'Woher', meaning: 'Dari mana', example: 'Woher kommst du?', translation: 'Kamu berasal dari mana?' },
  { word: 'Wohin', meaning: 'Ke mana', example: 'Wohin gehst du?', translation: 'Kamu pergi ke mana?' },
];

const pluralExamples = [
  { singular: 'das Kind', plural: 'die Kinder', pattern: '-er' },
  { singular: 'der Mann', plural: 'die Männer', pattern: 'Umlaut + -er' },
  { singular: 'die Frau', plural: 'die Frauen', pattern: '-en' },
  { singular: 'das Buch', plural: 'die Bücher', pattern: 'Umlaut + -er' },
  { singular: 'der Tisch', plural: 'die Tische', pattern: '-e' },
  { singular: 'die Lampe', plural: 'die Lampen', pattern: '-n' },
  { singular: 'das Auto', plural: 'die Autos', pattern: '-s' },
  { singular: 'der Lehrer', plural: 'die Lehrer', pattern: 'Tidak berubah' },
];

const caseArticles = [
  { gender: 'Maskulin', nominativ: 'der', akkusativ: 'den', dativ: 'dem' },
  { gender: 'Feminin', nominativ: 'die', akkusativ: 'die', dativ: 'der' },
  { gender: 'Netral', nominativ: 'das', akkusativ: 'das', dativ: 'dem' },
  { gender: 'Plural', nominativ: 'die', akkusativ: 'die', dativ: 'den (+n)' },
];

const caseExamples = [
  { sentence: 'Der Mann sieht den Hund.', nominativ: 'der Mann', object: 'den Hund', objectCase: 'Akkusativ', translation: 'Pria itu melihat anjing itu.' },
  { sentence: 'Ich helfe dem Mann.', nominativ: 'ich', object: 'dem Mann', objectCase: 'Dativ', translation: 'Saya membantu pria itu.' },
];
---

<Layout
  title="Tata Bahasa (Grammatik) | siDeutsch"
  description="Panduan tata bahasa Jerman untuk pemula: artikel der, die, das, konjugasi sein dan haben, serta susunan kalimat dasar."
>
  <div class="grammar-page">
    <header class="page-heading">
      <p class="eyebrow">Panduan Pemula</p>
      <h1>Tata Bahasa (Grammatik)</h1>
      <p class="intro-copy">Dasar-dasar tata bahasa Jerman dalam contoh singkat.</p>
    </header>

    <section class="grammar-section" aria-labelledby="articles-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">01 / Kata sandang</p>
          <h2 id="articles-heading">Artikel: der, die, das</h2>
        </div>
        <p class="section-note">Setiap nomina bahasa Jerman memiliki gender gramatikal.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel artikel bahasa Jerman" tabindex="0">
        <table class="grammar-table">
          <thead>
            <tr>
              <th scope="col">Artikel</th>
              <th scope="col">Gender</th>
              <th scope="col">Contoh</th>
            </tr>
          </thead>
          <tbody>
            {articles.map(({ article, gender, example, meaning }) => (
              <tr>
                <th scope="row" lang="de">{article}</th>
                <td>{gender}</td>
                <td><GrammarSpeech text={example} /> ({meaning})</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="concept-note">Dalam bahasa Jerman, setiap kata benda (nomina) memiliki gender gramatikal: Maskulin (der), Feminin (die), dan Netral (das). Gender ini ga selalu sesuai sama jenis kelamin makhluk hidup. Contohnya, “<span lang="de">das Mädchen</span>” (anak perempuan) itu Netral, bukan Feminin. Jadi, lu harus hafalin artikelnya bareng sama katanya, karena ga ada aturan mutlak.</p>
    </section>

    <section class="grammar-section" aria-labelledby="verbs-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 / Kata kerja</p>
          <h2 id="verbs-heading">Konjugasi sein & haben</h2>
        </div>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel konjugasi sein dan haben" tabindex="0">
        <table class="grammar-table conjugation-table">
          <thead>
            <tr>
              <th scope="col">Pronoun</th>
              <th scope="col">sein (menjadi / ada)</th>
              <th scope="col">haben (memiliki)</th>
            </tr>
          </thead>
          <tbody>
            {conjugations.map(({ pronoun, sein, haben }) => (
              <tr>
                <th scope="row" lang="de">{pronoun}</th>
                <td><GrammarSpeech text={sein} /></td>
                <td><GrammarSpeech text={haben} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="concept-note">Kata kerja “<span lang="de">sein</span>” (menjadi) dan “<span lang="de">haben</span>” (memiliki) adalah dua kata kerja paling penting di bahasa Jerman. Keduanya sering dipake buat bikin kalimat dasar atau ngebantu kata kerja lain (sebagai kata kerja bantu). Konjugasinya berubah tergantung subjeknya (<span lang="de">ich, du, er/sie/es, wir, ihr, sie/Sie</span>).</p>
    </section>

    <section class="grammar-section" aria-labelledby="sentence-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">03 / Susunan kalimat</p>
          <h2 id="sentence-heading">Kalimat utama</h2>
        </div>
      </div>

      <p class="rule-summary">Pola dasar: <strong>Subjek + Predikat (kata kerja) + Objek</strong>. Dalam kalimat utama, kata kerja yang dikonjugasikan menempati posisi kedua.</p>

      <div class="table-scroll" role="region" aria-label="Contoh susunan kalimat Jerman" tabindex="0">
        <table class="grammar-table sentence-table">
          <thead>
            <tr>
              <th scope="col">Contoh kalimat</th>
              <th scope="col">Susunan</th>
              <th scope="col">Arti</th>
            </tr>
          </thead>
          <tbody>
            {sentenceExamples.map(({ sentence, structure, meaning }) => (
              <tr>
                <th scope="row"><GrammarSpeech text={sentence} /></th>
                <td>{structure}</td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="concept-note">Dalam kalimat utama (<span lang="de">Hauptsatz</span>), kata kerja yang udah dikonjugasi <strong>wajib</strong> berada di posisi kedua. Kalau lu mulai kalimatnya pake keterangan waktu (kayak “<span lang="de">Heute</span>”), kata kerjanya tetep di posisi kedua, dan subjeknya geser ke posisi ketiga. Ini namanya aturan V2 (Verb Second).</p>
    </section>

    <section class="grammar-section" aria-labelledby="questions-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">04 / Kalimat tanya</p>
          <h2 id="questions-heading">Penyusunan Kalimat Tanya (Fragen)</h2>
        </div>
      </div>

      <p class="rule-summary">W-Fragen dimulai dengan kata tanya, lalu kata kerja. Ja/Nein-Fragen dimulai dengan kata kerja terkonjugasi dan dijawab dengan “Ja” atau “Nein”.</p>

      <h3 class="subsection-title">W-Fragen</h3>
      <div class="table-scroll" role="region" aria-label="Tabel W-Fragen bahasa Jerman" tabindex="0">
        <table class="grammar-table question-table">
          <thead>
            <tr>
              <th scope="col">Kata tanya</th>
              <th scope="col">Arti</th>
              <th scope="col">Contoh</th>
              <th scope="col">Terjemahan</th>
            </tr>
          </thead>
          <tbody>
            {questionWords.map(({ word, meaning, example, translation }) => (
              <tr>
                <th scope="row" lang="de">{word}</th>
                <td>{meaning}</td>
                <td><GrammarSpeech text={example} /></td>
                <td>{translation}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="subsection-title subsection-spaced">Ja/Nein-Fragen</h3>
      <div class="table-scroll" role="region" aria-label="Contoh Ja/Nein-Frage bahasa Jerman" tabindex="0">
        <table class="grammar-table question-table">
          <thead>
            <tr>
              <th scope="col">Pola</th>
              <th scope="col">Contoh</th>
              <th scope="col">Terjemahan</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Verb + Subjek + ...</th>
              <td><GrammarSpeech text="Sprichst du Deutsch?" /></td>
              <td>Apakah kamu bicara bahasa Jerman?</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="concept-note">W-Fragen (kalimat tanya pake kata tanya) itu dimulai dengan kata tanya, lalu diikuti kata kerja. Sedangkan Ja/Nein-Fragen (kalimat tanya yang jawabannya Ya/Tidak) itu dimulai langsung dengan kata kerja, tanpa kata tanya. Contoh: “<span lang="de">Sprichst du Deutsch?</span>” (Apakah kamu bicara Jerman?).</p>
    </section>

    <section class="grammar-section" aria-labelledby="plural-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">05 / Kata benda</p>
          <h2 id="plural-heading">Pluralisasi Nomina (Plural)</h2>
        </div>
        <p class="section-note">Bentuk jamak bervariasi: akhiran dapat berupa -e, -en, -er, -s, perubahan Umlaut, atau tanpa perubahan.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel bentuk singular dan plural bahasa Jerman" tabindex="0">
        <table class="grammar-table plural-table">
          <thead>
            <tr>
              <th scope="col">Singular</th>
              <th scope="col">Plural</th>
              <th scope="col">Pola</th>
            </tr>
          </thead>
          <tbody>
            {pluralExamples.map(({ singular, plural, pattern }) => (
              <tr>
                <th scope="row"><GrammarSpeech text={singular} /></th>
                <td lang="de">{plural}</td>
                <td>{pattern}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="concept-note">Di bahasa Jerman, membentuk kata jamak (Plural) itu ga semudah nambahin “-s” kayak di bahasa Inggris. Ada banyak pola: nambah -e, -en, -er, -s, atau malah ngubah vokal (Umlaut) tanpa nambah akhiran. Karena itu, cara paling aman adalah menghafal bentuk jamaknya bareng sama kata tunggalnya.</p>
    </section>

    <section class="grammar-section" aria-labelledby="cases-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">06 / Kasus</p>
          <h2 id="cases-heading">Kasus Dasar</h2>
        </div>
      </div>

      <p class="rule-summary"><strong>Nominativ</strong> menandai subjek, <strong>Akkusativ</strong> objek langsung, dan <strong>Dativ</strong> objek tidak langsung.</p>

      <div class="table-scroll" role="region" aria-label="Perubahan artikel menurut kasus" tabindex="0">
        <table class="grammar-table case-table">
          <thead>
            <tr>
              <th scope="col">Gender</th>
              <th scope="col">Nominativ</th>
              <th scope="col">Akkusativ</th>
              <th scope="col">Dativ</th>
            </tr>
          </thead>
          <tbody>
            {caseArticles.map(({ gender, nominativ, akkusativ, dativ }) => (
              <tr>
                <th scope="row">{gender}</th>
                <td lang="de">{nominativ}</td>
                <td lang="de">{akkusativ}</td>
                <td lang="de">{dativ}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="table-scroll case-examples-scroll" role="region" aria-label="Contoh kalimat dengan kasus" tabindex="0">
        <table class="grammar-table sentence-table">
          <thead>
            <tr>
              <th scope="col">Contoh kalimat</th>
              <th scope="col">Nominativ</th>
              <th scope="col">Objek</th>
              <th scope="col">Arti</th>
            </tr>
          </thead>
          <tbody>
            {caseExamples.map(({ sentence, nominativ, object, objectCase, translation }) => (
              <tr>
                <th scope="row"><GrammarSpeech text={sentence} /></th>
                <td lang="de">{nominativ}</td>
                <td lang="de">{object} ({objectCase})</td>
                <td>{translation}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="concept-note">Bahasa Jerman punya 4 kasus (Fall). Tiga yang paling dasar adalah Nominativ (buat subjek), Akkusativ (buat objek langsung), dan Dativ (buat objek tidak langsung). Artikel (der/die/das) bakal berubah tergantung kasusnya. Contoh: “<span lang="de">der Mann</span>” (Nominativ) berubah jadi “<span lang="de">den Mann</span>” (Akkusativ). Jadi, lu harus tau peran kata dalam kalimat buat milih artikel yang bener.</p>
    </section>
  </div>
</Layout>

  <script>
    const grammarSpeechSupported = () =>
      'speechSynthesis' in window && typeof SpeechSynthesisUtterance !== 'undefined';

    const configureGrammarSpeechButtons = () => {
      const supported = grammarSpeechSupported();
      document.querySelectorAll<HTMLButtonElement>('.grammar-speech-button').forEach((button) => {
        button.disabled = !supported;
      });
    };

    document.addEventListener('astro:page-load', configureGrammarSpeechButtons);
    configureGrammarSpeechButtons();

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('.grammar-speech-button');
      if (!button || button.disabled || !grammarSpeechSupported()) return;

      const utterance = new SpeechSynthesisUtterance(button.dataset.grammarSpeech ?? '');
      utterance.lang = 'de-DE';
      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);
    });
  </script>

<style>
  .grammar-page {
    display: grid;
    gap: 2.8rem;
    padding-top: 0.5rem;
  }

  .page-heading {
    max-width: 780px;
  }

  .grammar-section {
    min-width: 0;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.55rem;
    color: #806018;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    color: var(--text-main);
    font-size: 2.35rem;
    line-height: 1.15;
  }

  .intro-copy {
    margin: 0.85rem 0 0;
    color: var(--muted);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.45rem;
  }

  .section-note {
    max-width: 430px;
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .table-scroll {
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    border: 1px solid rgba(43, 45, 66, 0.16);
    border-radius: 8px;
    background: var(--bg-main);
    scrollbar-color: var(--accent-gold) rgba(43, 45, 66, 0.08);
  }

  .grammar-table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    text-align: left;
  }

  .conjugation-table {
    min-width: 680px;
    table-layout: fixed;
  }

  .conjugation-table tr > :nth-child(1) { width: 34%; }
  .conjugation-table tr > :nth-child(2) { width: 33%; }
  .conjugation-table tr > :nth-child(3) { width: 33%; }

  .grammar-table th,
  .grammar-table td {
    padding: 0.72rem 1rem;
    border-bottom: 1px solid rgba(43, 45, 66, 0.09);
    vertical-align: top;
  }

  .grammar-table thead th {
    background: var(--bg-dark);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .grammar-table tbody tr:nth-child(even) {
    background: rgba(229, 169, 59, 0.1);
  }

  .grammar-table tbody tr:last-child th,
  .grammar-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .grammar-table tbody th,
  .grammar-table tbody td {
    font-size: 0.9rem;
  }

  .grammar-table tbody th {
    color: var(--text-main);
    font-weight: 800;
  }

  .grammar-table td span {
    color: #76520d;
    font-weight: 700;
  }

  .conjugation-table tbody td[lang='de'] {
    color: #76520d;
    font-weight: 700;
  }

  .rule-summary {
    max-width: 820px;
    margin: 0 0 1rem;
    color: var(--text-main);
    line-height: 1.7;
  }

  .rule-summary strong {
    color: #76520d;
  }

  .subsection-title {
    margin: 1.25rem 0 0.75rem;
    color: var(--text-main);
    font-size: 1rem;
  }

  .subsection-spaced {
    margin-top: 1.5rem;
  }

  .sentence-table {
    min-width: 650px;
  }

  .question-table {
    min-width: 680px;
  }

  .plural-table,
  .case-table {
    min-width: 560px;
  }

  .case-examples-scroll {
    margin-top: 0.85rem;
  }

  .concept-note {
    margin: 0.9rem 0 0;
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--accent-gold);
    border-radius: 6px;
    background: var(--bg-light, #f1f2f4);
    color: var(--text-main);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .concept-note strong {
    color: #76520d;
  }

  @media (max-width: 640px) {
    .grammar-page {
      gap: 2.1rem;
    }

    h1 {
      font-size: 1.85rem;
    }

    .section-heading {
      display: block;
    }

    .section-note {
      margin-top: 0.6rem;
    }
  }
</style>