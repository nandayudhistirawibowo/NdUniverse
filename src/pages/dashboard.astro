---
const user = Astro.locals.user;
const preferredLanguage = String(user?.user_metadata?.language_code ?? Astro.cookies.get('language')?.value ?? '').toLowerCase();
const error = Astro.url.searchParams.get('error');
if (!user) return Astro.redirect(preferredLanguage === 'en' ? '/login-en' : '/login-de');
const dashboardPath = preferredLanguage === 'en' ? '/en/dashboard' : '/dashboard-de';
return Astro.redirect(error ? `${dashboardPath}?error=${encodeURIComponent(error)}` : dashboardPath);
---
