---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { normalizePassedPillars } from '@core/db/progress-client-en.js';
import { getCollection } from 'astro:content';

const POINTS_PER_LEVEL = { A1: 10, A2: 20, B1: 30, B2: 40, C1: 50, C2: 60 };
const LEVEL_STEPS = [
  { threshold: 0, label: 'A1 Beginner', nextThreshold: 200, nextLabel: 'A1 Advanced' },
  { threshold: 200, label: 'A1 Advanced', nextThreshold: 400, nextLabel: 'A2 Beginner' },
  { threshold: 400, label: 'A2 Beginner', nextThreshold: 700, nextLabel: 'A2 Advanced' },
  { threshold: 700, label: 'A2 Advanced', nextThreshold: 1000, nextLabel: 'B1' },
  { threshold: 1000, label: 'B1', nextThreshold: 1400, nextLabel: 'B2' },
  { threshold: 1400, label: 'B2', nextThreshold: 1800, nextLabel: 'C1' },
  { threshold: 1800, label: 'C1', nextThreshold: 2200, nextLabel: 'C2 (Mastery)' },
  { threshold: 2200, label: 'C2 (Mastery)', nextThreshold: null, nextLabel: null },
];

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const displayName = profile?.nama_lengkap
  || user?.user_metadata?.nama_lengkap
  || profile?.nim
  || user?.user_metadata?.nim
  || 'Learner';
const accessDenied = Astro.url.searchParams.get('error') === 'admin-only';
const { data: progressData, error: progressError } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('material_slug, language_code, sessions_passed')
    .eq('user_id', user.id)
    .eq('language_code', 'en')
  : { data: [], error: null };
if (progressError) throw progressError;

const materials = (await getCollection('englishEveryday'))
  .filter((material) => material.data.track === 'Everyday English');
const materialBySlug = new Map(materials.map((material) => [material.id, material]));
const progressRows = progressData ?? [];
const completedMaterials = progressRows.flatMap((row) => {
  const material = materialBySlug.get(row.material_slug);
  if (!material || normalizePassedPillars(row.sessions_passed).length !== 4) return [];
  return [{
    slug: material.id.split('/').at(-1) ?? material.id,
    title: material.data.title ?? material.id,
    level: material.data.level ?? '',
  }];
});
const totalPoints = completedMaterials.reduce(
  (total, material) => total + (POINTS_PER_LEVEL[material.level] ?? 0),
  0,
);
const currentLevel = [...LEVEL_STEPS].reverse().find((step) => totalPoints >= step.threshold) ?? LEVEL_STEPS[0];
const levelProgressPercent = currentLevel.nextThreshold !== null
  ? Math.max(0, Math.min(100, Math.floor(
    ((totalPoints - currentLevel.threshold) / (currentLevel.nextThreshold - currentLevel.threshold)) * 100,
  )))
  : 100;
---

<DashboardLayout
  title="English Dashboard | NdUniverse"
  description="Track your English learning progress and continue your studies."
  active="home"
  user={user}
  profile={profile}
>
  <section class="dashboard-content">
    {accessDenied && <p class="access-notice" role="alert">Administrator access is not available for this account.</p>}
    <header class="dashboard-heading">
      <p class="eyebrow">English Learning</p>
      <h1>Hello, {displayName} <span aria-hidden="true">👋</span></h1>
      <p>Keep building your English skills, one session at a time.</p>
    </header>

    <section class="welcome-strip">
      <div>
        <p class="eyebrow">Keep Learning</p>
        <h2>Ready for your next session?</h2>
        <p>Choose a material, learn new vocabulary, and complete all four practice skills.</p>
        <a href="/en/materi">Browse Materials <span aria-hidden="true">→</span></a>
      </div>
      <a class="welcome-mark" href="/en/materi" aria-label="Browse English materials">📚</a>
    </section>

    <section class="level-card" aria-labelledby="level-title">
      <div class="level-summary">
        <p class="level-eyebrow">Everyday English Level</p>
        <p class="level-caption">Current CEFR Level</p>
        <h2 id="level-title">{currentLevel.label}</h2>
        <p class="level-points">{totalPoints} points earned from materials passed in all four skills.</p>
      </div>
      <div class="level-next-step">
        {currentLevel.nextThreshold !== null ? (
          <>
            <div class="level-progress-heading">
              <span>Next: {currentLevel.nextLabel}</span>
              <strong>{levelProgressPercent}%</strong>
            </div>
            <div
              class="level-progress-track"
              role="progressbar"
              aria-label={`Progress toward ${currentLevel.nextLabel}`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={levelProgressPercent}
            >
              <span style={`width: ${levelProgressPercent}%`} />
            </div>
            <p>{totalPoints} / {currentLevel.nextThreshold} points to reach {currentLevel.nextLabel}</p>
          </>
        ) : (
          <>
            <div class="level-progress-heading"><span>Highest level reached</span><strong>100%</strong></div>
            <div class="level-progress-track" role="progressbar" aria-label="Highest level reached" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
              <span style="width: 100%" />
            </div>
            <p>You have reached C2 Mastery. Keep practicing to maintain your skills.</p>
          </>
        )}
      </div>
    </section>

    <nav class="shortcut-grid" aria-label="Learning shortcuts">
      <a href="/en/materi"><strong>Material Catalog</strong><span>Explore all English materials.</span></a>
      <a href="/en/everyday-english"><strong>Everyday English</strong><span>Practice from A1 through C2.</span></a>
      <a href="/en/exam"><strong>IELTS / TOEFL</strong><span>Prepare for an English exam.</span></a>
      <a href="/en/career"><strong>Career Prep</strong><span>Practice workplace English.</span></a>
    </nav>

    <section class="completed-section" aria-labelledby="completed-title">
      <div class="completed-heading">
        <div><p class="eyebrow">Achievements</p><h2 id="completed-title">Completed Materials</h2></div>
        <span>{completedMaterials.length} materials</span>
      </div>
      {completedMaterials.length > 0 ? (
        <ul class="completed-list">
          {completedMaterials.map((material) => (
            <li><a href={`/en/materi/${material.slug}`}>{material.title}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      ) : (
        <p class="completed-empty">No materials have passed all four skills yet.</p>
      )}
    </section>
  </section>
</DashboardLayout>

<style>
  .dashboard-content { display: grid; gap: 1.25rem; min-width: 0; padding: .5rem 0 2rem; }
  .dashboard-heading h1 { margin: .3rem 0; font-size: clamp(2rem, 4vw, 3rem); }
  .dashboard-heading > p:last-child, .completed-empty { margin: 0; color: var(--muted); }
  .eyebrow, .level-eyebrow { margin: 0; color: #966313; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .access-notice { margin: 0; padding: .8rem 1rem; border: 1px solid #e6a3a3; border-radius: 8px; background: #fff2f2; color: #7d2626; }
  .welcome-strip { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: 10px; background: var(--card-bg); }
  .welcome-strip h2 { margin: .35rem 0; }
  .welcome-strip p:not(.eyebrow) { margin: .5rem 0; color: var(--muted); }
  .welcome-strip a:not(.welcome-mark) { color: #966313; font-weight: 800; text-decoration: none; }
  .welcome-mark { display: grid; width: 64px; height: 64px; flex: 0 0 auto; place-items: center; border-radius: 12px; background: rgba(229, 169, 59, .14); font-size: 2rem; text-decoration: none; }
  .level-card { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 1.5rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: 10px; background: var(--card-bg); }
  .level-caption { margin: .5rem 0 0; color: var(--muted); font-weight: 700; }
  .level-summary h2 { margin: .25rem 0; color: #966313; font-size: 2rem; }
  .level-points, .level-next-step p { margin: .4rem 0 0; color: var(--muted); line-height: 1.5; }
  .level-progress-heading { display: flex; justify-content: space-between; gap: .75rem; }
  .level-progress-track { height: 10px; margin-top: .75rem; overflow: hidden; border-radius: 999px; background: #e8e5de; }
  .level-progress-track span { display: block; height: 100%; border-radius: inherit; background: var(--accent-gold); }
  .shortcut-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .shortcut-grid a { display: grid; gap: .45rem; min-height: 95px; align-content: center; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text-main); text-decoration: none; }
  .shortcut-grid a:hover { border-color: var(--accent-gold); }
  .shortcut-grid span { color: var(--muted); }
  .completed-section { display: grid; gap: .75rem; }
  .completed-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .completed-heading h2 { margin: .3rem 0 0; }
  .completed-heading > span { color: var(--muted); font-weight: 700; }
  .completed-list { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .completed-list a { display: flex; justify-content: space-between; gap: .75rem; padding: .8rem 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text-main); text-decoration: none; }
  @media (max-width: 700px) {
    .level-card { grid-template-columns: 1fr; }
    .shortcut-grid { grid-template-columns: 1fr; }
    .welcome-mark { display: none; }
  }
</style>
