---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { hasCompletedPillarSession } from '@core/db/progress-client-en.js';
import { getCollection } from 'astro:content';

const POINTS_PER_LEVEL = { A1: 10, A2: 20, B1: 30, B2: 40, C1: 50, C2: 60 };
const LEVEL_STEPS = [
  { threshold: 0, label: 'A1 Pemula', nextThreshold: 200, nextLabel: 'A1 Lanjutan' },
  { threshold: 200, label: 'A1 Lanjutan', nextThreshold: 400, nextLabel: 'A2 Pemula' },
  { threshold: 400, label: 'A2 Pemula', nextThreshold: 700, nextLabel: 'A2 Lanjutan' },
  { threshold: 700, label: 'A2 Lanjutan', nextThreshold: 1000, nextLabel: 'B1' },
  { threshold: 1000, label: 'B1', nextThreshold: 1400, nextLabel: 'B2' },
  { threshold: 1400, label: 'B2', nextThreshold: 1800, nextLabel: 'C1' },
  { threshold: 1800, label: 'C1', nextThreshold: 2200, nextLabel: 'C2 (Mahir)' },
  { threshold: 2200, label: 'C2 (Mahir)', nextThreshold: null, nextLabel: null },
];

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const displayName = profile?.nama_lengkap
  || user?.user_metadata?.nama_lengkap
  || profile?.nim
  || user?.user_metadata?.nim
  || 'Pelajar';
const accessDenied = Astro.url.searchParams.get('error') === 'admin-only';
const { data: progressData, error: progressError } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('material_slug, language_code, xp, sessions_passed')
    .eq('user_id', user.id)
    .eq('language_code', 'en')
  : { data: [], error: null };
if (progressError) throw progressError;

const materials = (await getCollection('englishEveryday'))
  .filter((material) => material.data.track === 'Everyday English');
const materialBySlug = new Map(materials.map((material) => [material.id, material]));
const progressRows = progressData ?? [];
const completedMaterials = progressRows.flatMap((row) => {
  const material = materialBySlug.get(row.material_slug);
  if (!material || !hasCompletedPillarSession(row.sessions_passed)) return [];
  return [{
    slug: material.id.split('/').at(-1) ?? material.id,
    title: material.data.title ?? material.id,
    level: material.data.level ?? '',
  }];
});
const totalXp = progressRows.reduce(
  (total, row) => total + Math.max(0, Number(row.xp) || 0),
  0,
);
const totalPoints = completedMaterials.reduce(
  (total, material) => total + (POINTS_PER_LEVEL[material.level] ?? 0),
  0,
);
const levelMaterials = materials.map((material) => ({
  slug: material.id,
  title: material.data.title ?? material.id,
  level: material.data.level ?? '',
}));
const currentLevel = [...LEVEL_STEPS].reverse().find((step) => totalPoints >= step.threshold) ?? LEVEL_STEPS[0];
const levelProgressPercent = currentLevel.nextThreshold !== null
  ? Math.max(0, Math.min(100, Math.floor(
    ((totalPoints - currentLevel.threshold) / (currentLevel.nextThreshold - currentLevel.threshold)) * 100,
  )))
  : 100;
---

<DashboardLayout
  title="Dasbor | NdUniverse"
  description="Pantau progres belajar bahasa Inggris dan lanjutkan pembelajaran."
  active="home"
  user={user}
  profile={profile}
>
  <section class="dashboard-content">
    {accessDenied && <p class="access-notice" role="alert">Akses Admin ditolak. Akun ini tidak memiliki izin administrator.</p>}
    <header class="dashboard-heading">
      <p class="eyebrow">Belajar Bahasa Inggris</p>
      <h1>Halo, {displayName} <span aria-hidden="true">👋</span></h1>
      <p>Terus tingkatkan kemampuan bahasa Inggrismu, satu sesi setiap kali.</p>
    </header>

    <section class="welcome-strip">
      <div>
        <p class="eyebrow">Lanjutkan belajar</p>
        <h2>Siap memulai sesi berikutnya?</h2>
        <p>Pilih materi, pelajari kosakata baru, dan selesaikan latihan empat keterampilan.</p>
        <a href="/en/materi"><span>Jelajahi Materi</span> <span aria-hidden="true">→</span></a>
      </div>
      <a class="welcome-mark" href="/en/materi" aria-label="Buka katalog materi">📚</a>
    </section>

    <section
      class="level-card"
      aria-labelledby="level-title"
      data-progress-dashboard
      data-progress-rows={JSON.stringify(progressRows)}
      data-level-materials={JSON.stringify(levelMaterials)}
      data-level-steps={JSON.stringify(LEVEL_STEPS)}
    >
      <div class="level-summary">
        <p class="level-eyebrow">Level Bahasa Inggris Sehari-hari</p>
        <p class="level-caption">Level CEFR Saat Ini</p>
        <h2 id="level-title" data-level-label>{currentLevel.label}</h2>
        <p class="level-points" data-level-points>
          {totalPoints} poin dari materi yang lulus di keempat keterampilan · {totalXp} XP
        </p>
      </div>
      <div class="level-next-step">
        {currentLevel.nextThreshold !== null ? (
          <>
            <div class="level-progress-heading">
              <span data-level-next-label>Berikutnya: {currentLevel.nextLabel}</span>
              <strong data-level-percent>{levelProgressPercent}%</strong>
            </div>
            <div
              class="level-progress-track"
              role="progressbar"
              aria-label={`Progress menuju ${currentLevel.nextLabel}`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={levelProgressPercent}
              data-level-progress
            >
              <span data-level-fill style={`width: ${levelProgressPercent}%`} />
            </div>
            <p data-level-summary>{totalPoints} / {currentLevel.nextThreshold} poin menuju {currentLevel.nextLabel}</p>
          </>
        ) : (
          <>
            <div class="level-progress-heading"><span data-level-next-label>Level tertinggi</span><strong data-level-percent>100%</strong></div>
            <div class="level-progress-track" role="progressbar" aria-label="Level tertinggi tercapai" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" data-level-progress>
              <span data-level-fill style="width: 100%" />
            </div>
            <p data-level-summary>Kamu telah mencapai C2 Mastery. Terus berlatih untuk mempertahankan kemampuanmu.</p>
          </>
        )}
      </div>
    </section>

    <nav class="shortcut-grid" aria-label="Pintasan belajar">
      <a href="/en/materi"><strong>Katalog Materi</strong><span>Jelajahi semua materi bahasa Inggris.</span></a>
      <a href="/en/everyday-english"><strong>Bahasa Inggris Sehari-hari</strong><span>Berlatih dari A1 hingga C2.</span></a>
      <a href="/en/exam"><strong>IELTS / TOEFL</strong><span>Persiapkan diri untuk ujian bahasa Inggris.</span></a>
      <a href="/en/career"><strong>Persiapan Karier</strong><span>Berlatih bahasa Inggris di tempat kerja.</span></a>
    </nav>

    <section class="completed-section" aria-labelledby="completed-title">
      <div class="completed-heading">
        <div><p class="eyebrow">Pencapaian</p><h2 id="completed-title">Materi selesai</h2></div>
        <span data-completed-count>{completedMaterials.length} materi</span>
      </div>
      <ul class="completed-list" data-completed-list>
        {completedMaterials.map((material) => (
          <li><a href={`/en/materi/${material.slug}`}>{material.title}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
      <p class="completed-empty" data-completed-empty hidden={completedMaterials.length > 0}>
        <span>Belum ada materi yang lulus di keempat keterampilan.</span>
      </p>
    </section>
  </section>
</DashboardLayout>

<script>
  import { hasCompletedPillarSession } from '@core/db/progress-client-en.js';

  const POINTS_PER_LEVEL = { A1: 10, A2: 20, B1: 30, B2: 40, C1: 50, C2: 60 };

  window.addEventListener('nd:progress-updated', (event) => {
    const { slug, languageCode, pillars, xp } = (event as CustomEvent<{
      slug: string;
      languageCode: string;
      session: number | null;
      pillar: string | null;
      xpEarned: number;
      pillars: string[];
      xp: number;
    }>).detail;
    if (languageCode !== 'en') return;

    const dashboard = document.querySelector<HTMLElement>('[data-progress-dashboard]');
    if (!dashboard) return;

    const rows = new Map<string, { material_slug: string; language_code: string; xp: number; sessions_passed: unknown }>(
      (JSON.parse(dashboard.dataset.progressRows ?? '[]') as Array<{
        material_slug: string;
        language_code: string;
        xp: number;
        sessions_passed: unknown;
      }>).map((row) => [row.material_slug, row]),
    );
    rows.set(slug, { material_slug: slug, language_code: 'en', xp, sessions_passed: pillars });
    dashboard.dataset.progressRows = JSON.stringify([...rows.values()]);
    const totalXp = [...rows.values()].reduce(
      (total, row) => total + Math.max(0, Number(row.xp) || 0),
      0,
    );

    const materials = JSON.parse(dashboard.dataset.levelMaterials ?? '[]') as Array<{
      slug: string;
      title: string;
      level: string;
    }>;
    const steps = JSON.parse(dashboard.dataset.levelSteps ?? '[]') as Array<{
      threshold: number;
      label: string;
      nextThreshold: number | null;
      nextLabel: string | null;
    }>;
    const completed = materials.filter((material) => (
      hasCompletedPillarSession(rows.get(material.slug)?.sessions_passed)
    ));
    const totalPoints = completed.reduce(
      (total, material) => total + (POINTS_PER_LEVEL[material.level] ?? 0),
      0,
    );
    const currentLevel = [...steps].reverse().find((step) => totalPoints >= step.threshold) ?? steps[0];
    if (!currentLevel) return;

    const percentage = currentLevel.nextThreshold
      ? Math.min(100, Math.max(0, Math.floor(
        ((totalPoints - currentLevel.threshold) / (currentLevel.nextThreshold - currentLevel.threshold)) * 100,
      )))
      : 100;
    const label = dashboard.querySelector<HTMLElement>('[data-level-label]');
    const points = dashboard.querySelector<HTMLElement>('[data-level-points]');
    const progress = dashboard.querySelector<HTMLElement>('[data-level-progress]');
    const fill = dashboard.querySelector<HTMLElement>('[data-level-fill]');
    const summary = dashboard.querySelector<HTMLElement>('[data-level-summary]');
    const nextLabel = dashboard.querySelector<HTMLElement>('[data-level-next-label]');
    const percentLabel = dashboard.querySelector<HTMLElement>('[data-level-percent]');
    if (label) label.textContent = currentLevel.label;
    if (points) points.textContent = `${totalPoints} poin dari materi yang lulus di keempat keterampilan · ${totalXp} XP`;
    if (progress) {
      progress.setAttribute('aria-valuenow', String(percentage));
      progress.setAttribute('aria-label', currentLevel.nextThreshold === null
        ? 'Level tertinggi tercapai'
        : `Progres menuju ${currentLevel.nextLabel}`);
    }
    if (fill) fill.style.width = `${percentage}%`;
    if (nextLabel) {
      nextLabel.textContent = currentLevel.nextThreshold === null
        ? 'Level tertinggi'
        : `Berikutnya: ${currentLevel.nextLabel}`;
    }
    if (percentLabel) percentLabel.textContent = `${percentage}%`;
    if (summary) {
      summary.textContent = currentLevel.nextThreshold === null
        ? 'Kamu telah mencapai C2 Mahir. Terus berlatih untuk mempertahankan kemampuanmu.'
        : `${totalPoints} / ${currentLevel.nextThreshold} poin menuju ${currentLevel.nextLabel}`;
    }

    const list = document.querySelector<HTMLElement>('[data-completed-list]');
    const count = document.querySelector<HTMLElement>('[data-completed-count]');
    const empty = document.querySelector<HTMLElement>('[data-completed-empty]');
    if (list) {
      list.replaceChildren(...completed.map((material) => {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `/en/materi/${encodeURIComponent(material.slug.split('/').at(-1) ?? material.slug)}`;
        link.textContent = material.title;
        const arrow = document.createElement('span');
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '→';
        link.append(arrow);
        item.append(link);
        return item;
      }));
    }
    if (count) count.textContent = `${completed.length} materi`;
    if (empty) empty.hidden = completed.length > 0;
  });
</script>

<style>
  .dashboard-content { display: grid; gap: 1.25rem; min-width: 0; padding: .5rem 0 2rem; }
  .dashboard-heading h1 { margin: .3rem 0; font-size: clamp(2rem, 4vw, 3rem); }
  .dashboard-heading > p:last-child, .completed-empty { margin: 0; color: var(--muted); }
  .eyebrow, .level-eyebrow { margin: 0; color: #966313; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .access-notice { margin: 0; padding: .8rem 1rem; border: 1px solid #e6a3a3; border-radius: 8px; background: #fff2f2; color: #7d2626; }
  .welcome-strip { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: 10px; background: var(--card-bg); }
  .welcome-strip h2 { margin: .35rem 0; }
  .welcome-strip p:not(.eyebrow) { margin: .5rem 0; color: var(--muted); }
  .welcome-strip a:not(.welcome-mark) { color: #966313; font-weight: 800; text-decoration: none; }
  .welcome-mark { display: grid; width: 64px; height: 64px; flex: 0 0 auto; place-items: center; border-radius: 12px; background: rgba(229, 169, 59, .14); font-size: 2rem; text-decoration: none; }
  .level-card { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 1.5rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: 10px; background: var(--card-bg); }
  .level-caption { margin: .5rem 0 0; color: var(--muted); font-weight: 700; }
  .level-summary h2 { margin: .25rem 0; color: #966313; font-size: 2rem; }
  .level-points, .level-next-step p { margin: .4rem 0 0; color: var(--muted); line-height: 1.5; }
  .level-progress-heading { display: flex; justify-content: space-between; gap: .75rem; }
  .level-progress-track { height: 10px; margin-top: .75rem; overflow: hidden; border-radius: 999px; background: #e8e5de; }
  .level-progress-track span { display: block; height: 100%; border-radius: inherit; background: var(--accent-gold); }
  .shortcut-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .shortcut-grid a { display: grid; gap: .45rem; min-height: 95px; align-content: center; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text-main); text-decoration: none; }
  .shortcut-grid a:hover { border-color: var(--accent-gold); }
  .shortcut-grid span { color: var(--muted); }
  .completed-section { display: grid; gap: .75rem; }
  .completed-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .completed-heading h2 { margin: .3rem 0 0; }
  .completed-heading > span { color: var(--muted); font-weight: 700; }
  .completed-list { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .completed-list a { display: flex; justify-content: space-between; gap: .75rem; padding: .8rem 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text-main); text-decoration: none; }
  @media (max-width: 700px) {
    .level-card { grid-template-columns: 1fr; }
    .shortcut-grid { grid-template-columns: 1fr; }
    .welcome-mark { display: none; }
  }
</style>
