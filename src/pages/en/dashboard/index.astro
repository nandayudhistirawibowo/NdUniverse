---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
const user = Astro.locals.user;
const profile = Astro.locals.profile;
const displayName = profile?.nama_lengkap || user?.user_metadata?.nama_lengkap || 'Learner';
---
<DashboardLayout title="English Dashboard | NdUniverse" description="English learning dashboard." active="home" user={user} profile={profile}><section class="dashboard-content"><header class="dashboard-heading"><p class="eyebrow">English Module</p><h1>Hello, {displayName}</h1><p>Continue your English learning journey.</p></header><article class="level-card"><div><span>Current CEFR level</span><strong>A1</strong></div><div class="progress-track" role="progressbar" aria-label="A1 progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="25"><span></span></div><small>Module progress: 25%</small></article><nav class="shortcut-grid" aria-label="Quick links"><a href="/en/materi"><strong>Material Catalog</strong><span>Explore A1-C2 materials</span></a><a href="/en/ujian"><strong>IELTS / TOEFL</strong><span>Start exam practice</span></a><a href="/en/career"><strong>Career Prep</strong><span>Prepare for professional work</span></a><a href="/dashboard-en/bookmark"><strong>Bookmarks</strong><span>Open saved vocabulary</span></a></nav></section></DashboardLayout>
<style>.dashboard-content{display:grid;gap:1.25rem}.dashboard-heading h1{margin:.3rem 0;font-size:clamp(2rem,4vw,3rem)}.dashboard-heading p:last-child{margin:0;color:var(--muted)}.eyebrow{color:#966313;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.level-card{display:grid;gap:.85rem;padding:1.25rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg)}.level-card>div:first-child{display:flex;justify-content:space-between;align-items:baseline}.level-card strong{color:#966313;font-size:2rem}.progress-track{height:10px;overflow:hidden;border-radius:999px;background:#e8e5de}.progress-track span{display:block;width:25%;height:100%;background:var(--accent-gold)}.level-card small{color:var(--muted)}.shortcut-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.shortcut-grid a{display:grid;gap:.45rem;min-height:120px;align-content:center;padding:1rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--text-main);text-decoration:none}.shortcut-grid a:hover{border-color:var(--accent-gold)}.shortcut-grid span{color:var(--muted)}@media(max-width:700px){.shortcut-grid{grid-template-columns:1fr}}</style>
