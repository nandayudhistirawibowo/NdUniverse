---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { getCollection } from 'astro:content';

const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const materials = (await getCollection('englishEveryday'))
	.filter((item) => item.data.track === 'Everyday English')
	.toSorted((left, right) => {
		const levelOrder = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
		const levelDifference = levelOrder.indexOf(left.data.level ?? '') - levelOrder.indexOf(right.data.level ?? '');
		return levelDifference || (left.data.title ?? left.id).localeCompare(right.data.title ?? right.id);
	});
---

<DashboardLayout
	title="Everyday English | NdUniverse"
	description="Everyday English learning materials by CEFR level."
	active="everydayEnglish"
	user={Astro.locals.user}
	profile={Astro.locals.profile}
>
	<section class="everyday-page">
		<a class="back-link" href="/en/dashboard">← <span data-i18n="catalog.back">Kembali ke Dasbor</span></a>
		<header>
			<p class="eyebrow"><span data-i18n="nav.everyday">Bahasa Inggris Sehari-hari</span> · <span data-i18n="catalog.materialCount" data-i18n-params={JSON.stringify({ count: materials.length })}>{materials.length} materi</span></p>
			<h1 data-i18n="nav.everyday">Bahasa Inggris Sehari-hari</h1>
			<p class="lead" data-i18n="catalog.chooseCefr">Pilih level dan lanjutkan belajar bahasa Inggris praktis.</p>
		</header>
		<div class="catalog-controls">
			<div class="level-filter">
				<label for="level-filter" data-i18n="catalog.chooseEnglishLevel">Pilih level</label>
				<select id="level-filter" data-level-filter>
					<option value="ALL" data-i18n="catalog.allLevels">Semua Level</option>
					{levels.map((level) => <option value={level}>{level}</option>)}
				</select>
			</div>
			<div class="exam-actions">
				<a class="exam-link ielts-link" data-i18n="catalog.ieltsExam" data-exam-link data-exam-type="ielts" href="/en/exam/ielts">Ujian IELTS</a>
				<a class="exam-link toefl-link" data-i18n="catalog.toeflExam" data-exam-link data-exam-type="toefl" href="/en/exam/toefl">Ujian TOEFL</a>
			</div>
		</div>
		{materials.length > 0 ? (
			<div class="material-grid">
				{materials.map((item) => (
					<article class="material-card" data-level={item.data.level ?? ''}>
						<span>{item.data.level ?? 'Everyday English'}</span>
						<h2>{item.data.title ?? item.id}</h2>
						<p>{item.data.description ?? ''}</p>
						<a href={`/en/materi/${item.id.split('/').at(-1)}`}><span data-i18n="catalog.englishMaterialOpen">Buka materi</span> →</a>
					</article>
				))}
			</div>
		) : (
			<p class="empty-state" data-i18n="catalog.noEverydayEnglish">Materi Everyday English belum tersedia.</p>
		)}
	</section>
</DashboardLayout>

<script>
	import { getDashboardLanguage, translateDashboard } from '@core/i18n/dashboard-language';

	const filter = document.querySelector<HTMLSelectElement>('[data-level-filter]');
	const applyFilter = () => {
		const selected = filter?.value ?? 'ALL';
		const language = getDashboardLanguage();
		document.querySelectorAll<HTMLAnchorElement>('[data-exam-link]').forEach((examLink) => {
			const examType = examLink.dataset.examType;
			if (!examType) return;
			examLink.href = selected === 'ALL'
				? `/en/exam/${examType}`
				: `/en/exam/${examType}/${selected.toLowerCase()}`;
			const translationKey = examType === 'ielts' ? 'catalog.ieltsExam' : 'catalog.toeflExam';
			examLink.dataset.i18n = translationKey;
			examLink.textContent = selected === 'ALL'
				? translateDashboard(translationKey, language)
				: `${translateDashboard(translationKey, language)} ${selected}`;
		});
		document.querySelectorAll<HTMLElement>('.material-card[data-level]').forEach((card) => {
			card.hidden = selected !== 'ALL' && card.dataset.level !== selected;
		});
	};
	filter?.addEventListener('change', applyFilter);
	window.addEventListener('nd:dashboard-language-changed', applyFilter);
	document.addEventListener('astro:page-load', applyFilter);
	applyFilter();
</script>

<style>
	.everyday-page { display: grid; gap: 1.5rem; width: min(1120px, 100%); margin: 0 auto; padding: 1rem 0 3rem; }
	.back-link { width: fit-content; color: var(--text-main); font-weight: 700; text-decoration: none; }
	.eyebrow { margin: 0 0 .6rem; color: #966313; font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(2rem, 5vw, 4rem); }
	.lead { max-width: 700px; margin: 1rem 0 0; color: var(--muted); line-height: 1.75; }
	.material-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
	.material-card { display: grid; align-content: start; gap: .65rem; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
	.material-card[hidden] { display: none; }
	.material-card span { color: #966313; font-size: .75rem; font-weight: 800; }
	.material-card h2, .material-card p { margin: 0; }
	.material-card p, .empty-state { color: var(--muted); line-height: 1.55; }
	.material-card a { color: #966313; font-weight: 800; text-decoration: none; }
	.catalog-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.level-filter { display: flex; align-items: center; gap: .75rem; }
	.level-filter label { font-weight: 800; }
	.level-filter select { min-height: 44px; padding: .55rem .75rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); color: var(--text-main); }
	.exam-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
	.exam-link { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; padding: .65rem 1rem; border-radius: 8px; color: #fff; font-weight: 900; text-decoration: none; touch-action: manipulation; }
	.ielts-link { background: #2874b8; }
	.toefl-link { background: #218449; }
	@media (max-width: 700px) {
		.material-grid { grid-template-columns: 1fr; }
		.catalog-controls { width: 100%; align-items: stretch; flex-direction: column; }
		.level-filter { width: 100%; align-items: flex-start; flex-direction: column; }
		.level-filter select, .exam-link { width: 100%; }
		.exam-actions { display: grid; grid-template-columns: 1fr; }
	}
</style>
