---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { getCollection } from 'astro:content';

const materials = (await getCollection('english'))
	.filter((item) => item.data.track === 'Everyday English')
	.toSorted((left, right) => {
		const levelOrder = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
		const levelDifference = levelOrder.indexOf(left.data.level ?? '') - levelOrder.indexOf(right.data.level ?? '');
		return levelDifference || (left.data.title ?? left.id).localeCompare(right.data.title ?? right.id);
	});
---

<DashboardLayout
	title="Everyday English | NdUniverse"
	description="Everyday English learning materials by CEFR level."
	active="everydayEnglish"
	user={Astro.locals.user}
	profile={Astro.locals.profile}
>
	<section class="everyday-page">
		<a class="back-link" href="/en/dashboard">← Back to English Dashboard</a>
		<header>
			<p class="eyebrow">Everyday English · {materials.length} Materials</p>
			<h1>Everyday English</h1>
			<p class="lead">Choose a level and continue building practical English skills.</p>
		</header>
		{materials.length > 0 ? (
			<div class="material-grid">
				{materials.map((item) => (
					<article class="material-card">
						<span>{item.data.level ?? 'Everyday English'}</span>
						<h2>{item.data.title ?? item.id}</h2>
						<p>{item.data.description ?? ''}</p>
						<a href={`/en/materi/${item.id.split('/').at(-1)}`}>Open Material →</a>
					</article>
				))}
			</div>
		) : (
			<p class="empty-state">No Everyday English materials are available yet.</p>
		)}
	</section>
</DashboardLayout>

<style>
	.everyday-page { display: grid; gap: 1.5rem; width: min(1120px, 100%); margin: 0 auto; padding: 1rem 0 3rem; }
	.back-link { width: fit-content; color: var(--text-main); font-weight: 700; text-decoration: none; }
	.eyebrow { margin: 0 0 .6rem; color: #966313; font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(2rem, 5vw, 4rem); }
	.lead { max-width: 700px; margin: 1rem 0 0; color: var(--muted); line-height: 1.75; }
	.material-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
	.material-card { display: grid; align-content: start; gap: .65rem; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
	.material-card span { color: #966313; font-size: .75rem; font-weight: 800; }
	.material-card h2, .material-card p { margin: 0; }
	.material-card p, .empty-state { color: var(--muted); line-height: 1.55; }
	.material-card a { color: #966313; font-weight: 800; text-decoration: none; }
	@media (max-width: 700px) { .material-grid { grid-template-columns: 1fr; } }
</style>
