---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import EnglishExam from '../../../../modules/english/components/EnglishExam-en.jsx';
import { getCollection } from 'astro:content';

export const prerender = false;

const examType = String(Astro.params.type ?? '').toLowerCase();
const level = String(Astro.params.level ?? '').toUpperCase();
if (!['ielts', 'toefl'].includes(examType)) return new Response('Jenis ujian tidak ditemukan.', { status: 404 });
if (!['A1', 'A2', 'B1', 'B2', 'C1', 'C2'].includes(level)) return new Response('Level ujian tidak ditemukan.', { status: 404 });

const examEntries = (await getCollection('englishExam')).filter(
  (entry) => entry.data.exam_type === examType && entry.data.level === level
);
const examEntry = examEntries.find((entry) => entry.id.endsWith('-mock'))
  ?? examEntries[0];
if (!examEntry) return new Response('Konten ujian untuk level ini tidak ditemukan.', { status: 404 });

const exam = {
  exam_type: examEntry.data.exam_type,
  level: examEntry.data.level,
  reading: examEntry.data.reading,
  listening: examEntry.data.listening,
  writing: examEntry.data.writing,
  speaking: examEntry.data.speaking,
};
const label = examType.toUpperCase();
---

<DashboardLayout
  title={`Ujian ${label} ${level} | NdUniverse`}
  description={`Latihan ujian ${label} untuk level ${level}.`}
  active="exam"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <EnglishExam client:load exam={exam} type={examType} level={level} />
</DashboardLayout>
