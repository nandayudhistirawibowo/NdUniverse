---
import Layout from '@core/ui/Layout.astro';
import Quiz from '../../../components/Quiz-en.jsx';

const words = [
  { german: 'to introduce yourself', indonesian: 'memperkenalkan diri', context: 'I can introduce myself in a new class.' },
  { german: 'the appointment', indonesian: 'janji temu', context: 'I have an appointment tomorrow morning.' },
  { german: 'the neighborhood', indonesian: 'lingkungan tempat tinggal', context: 'My neighborhood is quiet and friendly.' },
  { german: 'to ask for directions', indonesian: 'bertanya arah', context: 'I ask for directions at the station.' },
  { german: 'the daily routine', indonesian: 'rutinitas harian', context: 'My daily routine starts at seven.' },
];
---

<Layout title="Everyday English | NdUniverse" description="Everyday English practice on NdUniverse.">
  <main class="english-page">
    <a class="back-link" href="/en">← Back to English Module</a>
    <header>
      <p class="eyebrow">Everyday English</p>
      <h1>Practice everyday communication.</h1>
      <p class="lead">Start with a focused vocabulary session, then continue with Reading, Listening, Writing, and Speaking practice.</p>
    </header>
    <Quiz client:load items={words} track="English" level="Foundation" materialId="english-everyday" sessionMode batchSize={5} />
  </main>
</Layout>

<style>
  .english-page { display:grid; gap:1.5rem; width:min(1120px,100%); margin:0 auto; padding:1rem 0 3rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-decoration:none; }
  .back-link:hover { color:var(--accent-gold); }
  .eyebrow { margin:0 0 .6rem; color:#966313; font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  h1 { margin:0; color:var(--text-main); font-size:clamp(2rem,5vw,4rem); line-height:1; }
  .lead { max-width:700px; margin:1rem 0 0; color:var(--muted); line-height:1.75; }
</style>
