---
import Layout from '@core/ui/Layout.astro';
---
<Layout title="Bantuan | NdUniverse" description="Bantuan dan panduan belajar bahasa Inggris di NdUniverse."><main class="simple-page"><a href="/en" class="back-link">← Kembali ke modul Bahasa Inggris</a><p class="eyebrow">Bantuan</p><h1>Apa yang bisa kami bantu?</h1><p>Pilih jalur belajar, selesaikan latihan empat keterampilan, dan hubungi dukungan jika memerlukan bantuan.</p></main></Layout>
<style>.simple-page{display:grid;gap:.9rem;width:min(900px,100%);margin:0 auto}.back-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}.eyebrow{color:#966313;font-size:.78rem;font-weight:800;text-transform:uppercase}.simple-page p:last-child{color:var(--muted)}h1{margin:0}</style>
