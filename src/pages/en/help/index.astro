---
import Layout from '@core/ui/Layout.astro';
---
<Layout title="Bantuan | NdUniverse" description="Bantuan dan panduan belajar bahasa Inggris di NdUniverse."><main class="simple-page"><a href="/en" class="back-link">← Kembali ke modul Bahasa Inggris</a><p class="eyebrow">Bantuan</p><h1>Apa yang bisa kami bantu?</h1><p>Pilih jalur belajar, selesaikan latihan empat keterampilan, dan hubungi dukungan jika memerlukan bantuan.</p></main></Layout>
<style>
  :global(html:root body) {
    --bg-main: #0b1520;
    --bg-dark: #071019;
    --accent-gold: #e5a93b;
    --accent-red: #d93838;
    --text-main: #f8fafc;
    --card-bg: #071019;
    --muted: rgba(248, 250, 252, 0.66);
    --border: rgba(229, 169, 59, 0.28);
    background: var(--bg-main);
    color: var(--text-main);
  }

  .simple-page { display: grid; gap: .9rem; width: min(900px, 100%); margin: 0 auto; }
  .back-link { width: fit-content; color: var(--text-main); font-weight: 800; text-decoration: none; }
  .eyebrow { color: var(--accent-gold); font-size: .78rem; font-weight: 800; text-transform: uppercase; }
  .simple-page p:last-child { color: var(--muted); }
  h1 { margin: 0; color: var(--text-main); }
</style>
