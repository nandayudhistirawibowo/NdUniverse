---
import Layout from '@core/ui/Layout.astro';
---

<Layout title="English Pronunciation Guide | NdUniverse" description="English pronunciation practice and listening guide.">
  <main class="pronunciation-page">
    <a class="back-link" href="/en">← Back to English Module</a>
    <header>
      <p class="eyebrow">Pronunciation Guide</p>
      <h1>Practice clear English pronunciation.</h1>
      <p class="lead">English pronunciation lessons and listening exercises will be added here.</p>
    </header>
  </main>
</Layout>

<style>
  .pronunciation-page { display: grid; gap: 1.5rem; width: min(1120px, 100%); margin: 0 auto; padding: 1rem 0 3rem; }
  .back-link { width: fit-content; color: var(--text-main); font-weight: 700; text-decoration: none; }
  .eyebrow { margin: 0 0 .6rem; color: #966313; font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2rem, 5vw, 4rem); }
  .lead { max-width: 700px; margin: 1rem 0 0; color: var(--muted); line-height: 1.75; }
</style>
