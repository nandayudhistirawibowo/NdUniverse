---
import Layout from '@core/ui/Layout.astro';
import Quiz from '../../../modules/english/components/Quiz-en.jsx';
import { getCollection } from 'astro:content';

export const prerender = false;

const slug = Astro.url.searchParams.get('slug') ?? '';
const materials = await getCollection('englishEveryday');
const item = materials.find((entry) => entry.id === slug || entry.id.endsWith(`/${slug}`));
if (!item) return new Response('Material not found.', { status: 404 });

const type = Astro.url.searchParams.get('type') ?? '';
const pillarLabels = { reading: 'Reading', listening: 'Listening', writing: 'Writing', speaking: 'Speaking' };
const pillarLabel = pillarLabels[type] ?? 'Practice';
const batchSize = 5;
const sessionNumber = Math.max(1, Number(Astro.url.searchParams.get('session')) || 1);
const startIndex = (sessionNumber - 1) * batchSize;
const sessionCount = Math.ceil(item.data.vocab.length / batchSize);
const materialSlug = item.id.split('/').at(-1) ?? item.id;
const vocab = item.data.vocab.map((entry) => ({
  german: entry.word,
  indonesian: entry.translation,
  context: entry.context,
  reading_text: entry.reading_text,
  reading_question: entry.reading_question,
  listening_audio: entry.listening_audio,
  writing_instruction: entry.writing_instruction,
  speaking_question: entry.speaking_question,
}));
---

<Layout
  title={`Practice: ${item.data.title ?? materialSlug} | NdUniverse`}
  description={`English practice for ${item.data.title ?? materialSlug}.`}
  hideNavbar={true}
>
  <main class="practice-page">
    <a class="back-link" href={`/en/materi/${materialSlug}`} data-practice-back>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 18-6-6 6-6M8 12h12" /></svg>
      <span data-back-label>Back to Material</span>
    </a>
    <header class="page-heading">
      <p class="eyebrow">English Practice</p>
      <h1>{pillarLabel}: {item.data.title ?? materialSlug}</h1>
      <p>Practice up to {batchSize} questions in this session.</p>
    </header>

    <section class="practice-panel" aria-label={`Practice ${item.data.title ?? materialSlug}`}>
      <Quiz
        client:load
        items={vocab}
        track={item.data.track}
        level={item.data.level}
        returnHref={`/en/materi/${materialSlug}`}
        startIndex={startIndex}
        session={sessionNumber}
        batchSize={batchSize}
        sessionMode={true}
        materialId={item.id}
        type={type}
      />
    </section>
  </main>
</Layout>

<style>
  .practice-page {
    display: grid;
    max-width: 1000px;
    min-height: calc(100svh - 8.5rem);
    align-content: center;
    gap: 0.9rem;
    margin: 0 auto;
    padding: 1.25rem 0;
  }

  .back-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.2rem;
    color: var(--text-main);
    font-weight: 700;
    text-encoration: none;
  }

  .back-link svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .back-link:hover {
    color: var(--text-main);
    transform: translateX(-2px);
  }

  .page-heading {
    margin-bottom: 0.25rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.45rem);
  }

  .page-heading > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .practice-panel {
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card-bg);
    box-shadow: 0 20px 50px rgba(26, 26, 30, 0.1);
  }

  @media (max-width: 640px) {
    .practice-page {
      min-height: calc(100svh - 7rem);
      padding: 0.75rem 0;
    }

    .practice-panel {
      padding: 0.85rem;
    }
  }
</style>
