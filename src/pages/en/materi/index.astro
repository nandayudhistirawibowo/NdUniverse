---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { clampMaterialXp, MAX_MATERIAL_XP } from '@core/db/progress-xp.js';
import { getCollection } from 'astro:content';

export const prerender = false;

const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const materials = await getCollection('englishEveryday');

const user = Astro.locals.user;
const { data: progressData } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('material_slug, xp')
    .eq('user_id', user.id)
    .eq('language_code', 'en')
  : { data: [] };

const xpBySlug = new Map<string, number>();
for (const row of (progressData ?? [])) {
  const xp = clampMaterialXp(row.xp);
  xpBySlug.set(row.material_slug, xp);
  const short = row.material_slug.split('/').at(-1);
  if (short && !xpBySlug.has(short)) xpBySlug.set(short, xp);
}

---
<DashboardLayout title="Katalog Materi | NdUniverse" description="Katalog materi belajar bahasa Inggris." active="catalog" user={Astro.locals.user} profile={Astro.locals.profile}>
  <section class="catalog-content">
    <a class="back-link" href="/en/dashboard">← Kembali ke Dashboard</a>
    <header><p class="eyebrow">Katalog Materi</p><h1>Belajar Bahasa Inggris</h1><p>Pilih materi berdasarkan level CEFR.</p></header>
    {levels.map((level) => {
      const items = materials.filter((item) => item.data.level === level);
      return (
        <section class="level-section">
          <h2><span>Level</span> {level}</h2>
          {items.length ? (
            <div class="material-grid">
              {items.map((item) => {
                const shortSlug = item.id.split('/').at(-1) ?? item.id;
                const currentXp = xpBySlug.get(item.id) ?? xpBySlug.get(shortSlug) ?? 0;
                const percentage = currentXp >= MAX_MATERIAL_XP
                  ? 100
                  : Math.round((currentXp / MAX_MATERIAL_XP) * 100);
                return (
                  <a class="material-card" data-level={level} href={`/en/materi/${item.id.split('/').at(-1)}`}>
                    <span class="track-tag">{item.data.track ?? 'Bahasa Inggris Sehari-hari'}</span>
                    <h3>{item.data.title ?? item.id}</h3>
                    <p>{item.data.description ?? ''}</p>
                    <div class="card-progress-wrap">
                      <div class="card-progress-info">
                        <span>Progres</span>
                        <span class="card-progress-percent">{percentage}%</span>
                      </div>
                      <div class="card-progress-track" role="progressbar" aria-valuenow={percentage} aria-valuemin="0" aria-valuemax="100" aria-label={`Progres ${item.data.title ?? item.id}`}>
                        <div class="card-progress-fill" style={`width: ${percentage}%`} />
                      </div>
                    </div>
                    <small>Buka materi →</small>
                  </a>
                );
              })}
            </div>
          ) : (
            <p class="empty">Belum ada materi.</p>
          )}
        </section>
      );
    })}
  </section>
</DashboardLayout>
<style>
  :global(html:root body){--bg-main:#0b1520;--bg-dark:#071019;--accent-gold:#e5a93b;--accent-red:#d93838;--text-main:#f8fafc;--card-bg:#071019;--muted:rgba(248,250,252,.66);--border:rgba(229,169,59,.28);background:var(--bg-main);color:var(--text-main)}
  .catalog-content{display:grid;gap:1.5rem}
  .back-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}
  .eyebrow{color:var(--accent-gold);font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .catalog-content h1{margin:.25rem 0}.catalog-content header>p:last-child{color:var(--muted)}
  .level-section{display:grid;gap:.75rem}.material-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1rem}
  .material-card{--level-accent:var(--accent-gold);display:grid;gap:.5rem;padding:1rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--text-main);text-decoration:none}
  .material-card[data-level="A1"],.material-card[data-level="A2"]{--level-accent:#10B981}
  .material-card[data-level="B1"],.material-card[data-level="B2"]{--level-accent:#3B82F6}
  .material-card[data-level="C1"],.material-card[data-level="C2"]{--level-accent:#7C3AED}
  .material-card span{color:var(--accent-gold);font-size:.75rem;font-weight:800;text-transform:uppercase}
  .material-card h3,.material-card p{margin:0}.material-card p{color:var(--muted);line-height:1.55}
  .card-progress-wrap{display:grid;gap:.35rem;margin-top:auto;padding-top:.4rem}
  .card-progress-info{display:flex;justify-content:space-between;align-items:center;font-size:.75rem;color:var(--muted);font-weight:700}
  .card-progress-percent{color:var(--accent-gold);font-weight:800;font-size:.8rem}
  .card-progress-track{width:100%;height:6px;background:rgba(255,255,255,.1);border-radius:4px;overflow:hidden}
  .card-progress-fill{height:100%;background:var(--accent-gold);border-radius:4px;transition:width .3s ease}
  .material-card small{color:var(--level-accent);font-weight:800}
  .empty{color:var(--muted)}
@media (max-width: 767px) {
  .material-grid {
    grid-template-columns: minmax(0, 1fr)
  }
}
</style>
