---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { getCollection } from 'astro:content';
const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const materials = await getCollection('englishEveryday');
---
<DashboardLayout title="Katalog Materi | NdUniverse" description="Katalog materi belajar bahasa Inggris." active="catalog" user={Astro.locals.user} profile={Astro.locals.profile}>
  <section class="catalog-content">
    <a class="back-link" href="/en/dashboard">← Kembali ke Dashboard</a>
    <header><p class="eyebrow">Katalog Materi</p><h1>Belajar Bahasa Inggris</h1><p>Pilih materi berdasarkan level CEFR.</p></header>
    {levels.map((level) => { const items = materials.filter((item) => item.data.level === level); return <section class="level-section"><h2><span>Level</span> {level}</h2>{items.length ? <div class="material-grid">{items.map((item) => <a class="material-card" data-level={level} href={`/en/materi/${item.id.split('/').at(-1)}`}><span>{item.data.track ?? 'Bahasa Inggris Sehari-hari'}</span><h3>{item.data.title ?? item.id}</h3><p>{item.data.description ?? ''}</p><small>Buka materi</small></a>)}</div> : <p class="empty">Belum ada materi.</p>}</section>; })}
  </section>
</DashboardLayout>
<style>
  :global(html:root body){--bg-main:#0b1520;--bg-dark:#071019;--accent-gold:#e5a93b;--accent-red:#d93838;--text-main:#f8fafc;--card-bg:#071019;--muted:rgba(248,250,252,.66);--border:rgba(229,169,59,.28);background:var(--bg-main);color:var(--text-main)}
  .catalog-content{display:grid;gap:1.5rem}
  .back-link{width:fit-content;color:var(--text-main);font-weight:800;text-decoration:none}
  .eyebrow{color:var(--accent-gold);font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .catalog-content h1{margin:.25rem 0}.catalog-content header>p:last-child{color:var(--muted)}
  .level-section{display:grid;gap:.75rem}.material-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}
  .material-card{--level-accent:var(--accent-gold);display:grid;gap:.5rem;padding:1rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--text-main);text-decoration:none}
  .material-card[data-level="A1"],.material-card[data-level="A2"]{--level-accent:#10B981}
  .material-card[data-level="B1"],.material-card[data-level="B2"]{--level-accent:#3B82F6}
  .material-card[data-level="C1"],.material-card[data-level="C2"]{--level-accent:#7C3AED}
  .material-card span{color:var(--accent-gold);font-size:.75rem;font-weight:800;text-transform:uppercase}
  .material-card h3,.material-card p{margin:0}.material-card p{color:var(--muted);line-height:1.55}
  .material-card small{color:var(--level-accent);font-weight:800}
  .empty{color:var(--muted)}@media(max-width:700px){.material-grid{grid-template-columns:1fr}}
</style>
