---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { normalizePassedPillars } from '@core/db/progress-client-en.js';
import { getCollection } from 'astro:content';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');

const slug = Astro.params.slug ?? '';
const materials = await getCollection('englishEveryday');
const item = materials.find((entry) => entry.id === slug || entry.id.endsWith(`/${slug}`));
if (!item) return new Response('Materi tidak ditemukan.', { status: 404 });
const materialSlug = item.id.split('/').at(-1) ?? item.id;
const user = Astro.locals.user;
const { data: savedProgress, error: progressError } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('xp, sessions_passed')
    .eq('user_id', user.id)
    .eq('material_slug', item.id)
    .eq('language_code', 'en')
    .maybeSingle()
  : { data: null, error: null };
if (progressError) throw progressError;
console.log('[DEBUG 3] Render Materi. Data sesi dari DB:', savedProgress?.sessions_passed ?? null);
const passedPillars = normalizePassedPillars(savedProgress?.sessions_passed);
const vocab = item.data.vocab.map((entry) => ({
  german: entry.word,
  indonesian: entry.translation,
  context: entry.context,
  reading_text: entry.reading_text,
  reading_question: entry.reading_question,
  listening_audio: entry.listening_audio,
  writing_instruction: entry.writing_instruction,
  speaking_question: entry.speaking_question,
}));
const sessions = Array.from({ length: Math.ceil(vocab.length / 5) }, (_, index) => {
  const words = vocab.slice(index * 5, index * 5 + 5);
  return { number: index + 1, words, maxXp: words.length * 10 };
});
const materialMaxXp = sessions.reduce((sum, session) => sum + session.maxXp * 4, 0);
const materialXp = Math.min(
  materialMaxXp,
  sessions.reduce((sum, session) => {
    const completedPillarCount = ['reading', 'listening', 'writing', 'speaking'].filter((pillar) => {
      const sessionPillarKey = `s${session.number}-${pillar}`;
      return passedPillars.includes(sessionPillarKey) || (session.number === 1 && passedPillars.includes(pillar));
    }).length;
    return sum + (session.maxXp * completedPillarCount);
  }, 0),
);
---
<DashboardLayout title={`${item.data.title ?? item.id} | NdUniverse`} description={item.data.description ?? ''} active="catalog" user={Astro.locals.user} profile={Astro.locals.profile}>
  <article class="material-page">
    <a class="back-link" href={item.data.track === 'Academic English' ? '/en/dashboard' : '/en/everyday-english'} data-session-back><span aria-hidden="true">←</span> <span>Kembali ke Materi</span></a>
    <header>
      <p class="eyebrow">{item.data.track ?? 'Bahasa Inggris Sehari-hari'} · {item.data.level}</p>
      <h1>{item.data.title ?? item.id}</h1>
      <p>{item.data.description}</p>
      {user && <p class="material-xp-summary">XP materi: <strong data-material-xp data-material-slug={item.id} data-material-max-xp={materialMaxXp}>{materialXp}</strong> / {materialMaxXp} XP</p>}
    </header>
    {sessions.map((session) => {
      const sessionMaxXp = session.maxXp * 4;
      const completedPillarCount = passedPillars.filter((key) => key.startsWith(`s${session.number}-`) || (session.number === 1 && ['reading', 'listening', 'writing', 'speaking'].includes(key))).length;
      const sessionEarnedXp = Math.min(sessionMaxXp, session.maxXp * completedPillarCount);
      return (
      <section class="session-card">
        <div class="session-heading">
          <h2>Sesi {session.number}</h2>
          <div class="session-progress" data-session-progress={session.number} data-session-max-xp={sessionMaxXp}>
            <progress max={sessionMaxXp} value={sessionEarnedXp} aria-label={`Progres XP sesi ${session.number}`}></progress>
            <span data-session-xp-label>{sessionEarnedXp} / {sessionMaxXp} XP</span>
          </div>
        </div>
        <div class="table-wrap table-scroll" role="region" aria-label="Kosakata dan audio" tabindex="0">
          <p class="audio-legend">Audio: <img src="/flags/us.svg" alt="US" class="flag-icon" /> Kualitas Tinggi | <img src="/flags/gb.svg" alt="UK" class="flag-icon" /> Browser</p>
          <table>
            <thead>
              <tr>
                <th>Bahasa Inggris</th>
                <th>Bahasa Indonesia</th>
                <th>Konteks</th>
                <th>Audio kata</th>
                <th>Audio kalimat</th>
              </tr>
            </thead>
            <tbody>
              {session.words.map((word) => (
                <tr>
                  <td lang="en">{word.german}</td>
                  <td>{word.indonesian}</td>
                  <td lang="en">{word.context}</td>
                  <td>
                    <div class="vocab-audio-controls">
                      <button class="vocab-speech-button audio-btn" type="button" data-vocab-speech="us" data-vocab-text={word.german} aria-label={`Putar kata dalam bahasa Inggris AS: ${word.german}`} title="Bahasa Inggris AS"><img src="/flags/us.svg" alt="US" class="flag-icon" /></button>
                      <button class="vocab-speech-button audio-btn" type="button" data-vocab-speech="uk" data-vocab-text={word.german} aria-label={`Putar kata dalam bahasa Inggris UK: ${word.german}`} title="Bahasa Inggris UK"><img src="/flags/gb.svg" alt="UK" class="flag-icon" /></button>
                    </div>
                  </td>
                  <td>
                    <div class="vocab-audio-controls">
                      <button class="vocab-speech-button audio-btn" type="button" data-vocab-speech="us" data-vocab-text={word.context} aria-label={`Putar kalimat dalam bahasa Inggris AS: ${word.context}`} title="Bahasa Inggris AS"><img src="/flags/us.svg" alt="US" class="flag-icon" /></button>
                      <button class="vocab-speech-button audio-btn" type="button" data-vocab-speech="uk" data-vocab-text={word.context} aria-label={`Putar kalimat dalam bahasa Inggris UK: ${word.context}`} title="Bahasa Inggris UK"><img src="/flags/gb.svg" alt="UK" class="flag-icon" /></button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <nav class="pillar-links" aria-label={`Pilar latihan sesi ${session.number}`}>
          {(['reading', 'listening', 'writing', 'speaking'] as const).map((pillar) => {
            const label = pillar === 'reading' ? 'Membaca' : pillar === 'listening' ? 'Menyimak' : pillar === 'writing' ? 'Menulis' : 'Berbicara';
            const sessionPillarKey = `s${session.number}-${pillar}`;
            const isComplete = passedPillars.includes(sessionPillarKey) || (session.number === 1 && passedPillars.includes(pillar));
            const pillarMaxXp = session.maxXp;
            const pillarEarnedXp = isComplete ? pillarMaxXp : 0;
            return (
              <a
                href={`/en/materi/latihan?slug=${materialSlug}&type=${pillar}&session=${session.number}`}
                data-progress-pillar={pillar}
                data-progress-session={session.number}
                data-progress-slug={item.id}
                data-progress-language="en"
                data-pillar-label={label}
                data-pillar-max-xp={pillarMaxXp}
                class={`pillar-card${isComplete ? ' is-complete' : ''}`}
                title={isComplete ? 'Selesai' : undefined}
              >
                <span class="pillar-title">{label}</span>
                <progress max={pillarMaxXp} value={pillarEarnedXp} aria-label={`Progres ${label}`}></progress>
                <span class="pillar-status" data-pillar-status>{isComplete ? '[✓] 100% (Selesai)' : `[ ] 0% (Kurang ${pillarMaxXp} XP lagi)`}</span>
              </a>
            );
          })}
        </nav>
      </section>
      );
    })}
  </article>
</DashboardLayout>
<script>
  import { playAudioTTS, preloadEnglishTtsAudio } from '../../../modules/english/config/english-speech.js';

  const bindVocabularyAudio = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-vocab-text]').forEach((button) => {
      const text = button.dataset.vocabText ?? '';
      const accent = button.dataset.vocabSpeech ?? '';
      if (text && accent) preloadEnglishTtsAudio(text, accent);
      if (button.dataset.speechBound) return;
      button.dataset.speechBound = 'true';
      button.addEventListener('click', () => {
        if (text && accent) void playAudioTTS(text, accent, button);
      });
    });
  };

  document.addEventListener('astro:page-load', bindVocabularyAudio);
  bindVocabularyAudio();

  window.addEventListener('nd:progress-updated', (event) => {
    const detail = (event as CustomEvent<{
      slug?: string;
      languageCode?: string;
      pillars?: string[];
      sessions_passed?: string[];
      xp?: number;
    }>).detail ?? {};
    console.log('[UI AUDIT] Event diterima:', detail);
    const { slug, languageCode, xp } = detail;
    const pillars = Array.isArray(detail.pillars)
      ? detail.pillars
      : Array.isArray(detail.sessions_passed)
        ? detail.sessions_passed
        : [];
    if (languageCode !== 'en') return;

    document.querySelectorAll<HTMLAnchorElement>('[data-progress-pillar]').forEach((link) => {
      if (link.dataset.progressSlug !== slug) return;
      const sessionNum = Number(link.dataset.progressSession || 1);
      const pillarType = link.dataset.progressPillar ?? '';
      const sessionPillarKey = `s${sessionNum}-${pillarType}`;
      const isComplete = pillars.includes(sessionPillarKey) || (sessionNum === 1 && pillars.includes(pillarType));
      const label = link.dataset.pillarLabel ?? '';
      link.classList.toggle('is-complete', isComplete);
      link.setAttribute('aria-label', `${label}${isComplete ? ' completed, 100% complete' : `, 0% complete, ${link.dataset.pillarMaxXp} XP remaining`}`);
      const progress = link.querySelector<HTMLProgressElement>('progress');
      if (progress) progress.value = isComplete ? Number(link.dataset.pillarMaxXp) : 0;
      const status = link.querySelector<HTMLElement>('[data-pillar-status]');
      if (status) status.textContent = isComplete ? '[✓] 100% (Selesai)' : `[ ] 0% (Kurang ${link.dataset.pillarMaxXp} XP lagi)`;
    });

    document.querySelectorAll<HTMLElement>('[data-session-progress]').forEach((meter) => {
      const sessionNum = Number(meter.dataset.sessionProgress);
      const cards = [...document.querySelectorAll<HTMLAnchorElement>('[data-progress-pillar]')]
        .filter((link) => link.dataset.progressSlug === slug && Number(link.dataset.progressSession) === sessionNum);
      const completedCount = cards.filter((link) => {
        const pillar = link.dataset.progressPillar ?? '';
        return pillars.includes(`s${sessionNum}-${pillar}`) || (sessionNum === 1 && pillars.includes(pillar));
      }).length;
      const maxXp = Number(cards[0]?.dataset.pillarMaxXp ?? 0);
      const sessionMaxXp = Number(meter.dataset.sessionMaxXp ?? 0);
      const earnedXp = Math.min(sessionMaxXp, maxXp * completedCount);
      const progress = meter.querySelector<HTMLProgressElement>('progress');
      if (progress) progress.value = earnedXp;
      const label = meter.querySelector<HTMLElement>('[data-session-xp-label]');
      if (label) label.textContent = `${earnedXp} / ${sessionMaxXp} XP`;
    });

    const xpLabel = document.querySelector<HTMLElement>('[data-material-xp]');
    if (xpLabel?.dataset.materialSlug !== slug) return;
    if (xpLabel && typeof xp === 'number' && Number.isFinite(xp)) {
      const materialMaxXp = Number(xpLabel.dataset.materialMaxXp ?? 0);
      const cappedXp = Math.min(materialMaxXp > 0 ? materialMaxXp : xp, Math.max(0, xp));
      xpLabel.textContent = materialMaxXp > 0 ? `${cappedXp}` : String(cappedXp);
    }
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-session-back]').forEach((link) => {
    link.addEventListener('click', () => {
      const session = new URLSearchParams(window.location.search).get('session');
      if (session) window.sessionStorage.setItem('nduniverse-last-session', session);
      if (document.referrer && new URL(document.referrer, window.location.origin).pathname.includes('/en/everyday-english')) {
        link.href = '/en/everyday-english';
      }
    });
  });
</script>
<style>
  .material-page { display: grid; gap: 1.25rem; }
  .back-link { width: fit-content; color: var(--text-main); font-weight: 800; text-decoration: none; }
  .eyebrow { color: var(--accent-gold); font-size: .78rem; font-weight: 800; text-transform: uppercase; }
  .session-card { display: grid; gap: .75rem; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
  .material-xp-summary { color: var(--muted); }
  .material-xp-summary strong { color: var(--accent-gold); }
  .session-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .session-heading h2 { margin: 0; }
  .session-progress { display: grid; grid-template-columns: minmax(100px, 1fr) auto; align-items: center; gap: .5rem; min-width: min(100%, 260px); color: var(--muted); font-size: .8rem; }
  progress { width: 100%; height: .55rem; overflow: hidden; border: 0; border-radius: 999px; background: var(--border); accent-color: var(--accent-gold); }
  progress::-webkit-progress-bar { border-radius: 999px; background: var(--border); }
  progress::-webkit-progress-value { border-radius: 999px; background: var(--accent-gold); }
  progress::-moz-progress-bar { border-radius: 999px; background: var(--accent-gold); }
  .table-wrap { overflow-x: auto; }
  .audio-legend { margin: 0 0 .4rem; color: var(--muted); font-size: .75rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: .65rem; border-bottom: 1px solid var(--border); text-align: left; }
  .vocab-audio-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem; }
  .vocab-speech-button { display: inline-grid; width: auto; min-width: 44px; min-height: 44px; place-items: center; padding: 8px; border: 1px solid var(--border); border-radius: 8px; background: transparent; line-height: 1; cursor: pointer; transition: transform .16s ease, border-color .16s ease, background-color .16s ease; }
  @media (max-width: 480px) { .vocab-audio-controls { gap: .15rem; } }
  .vocab-speech-button.is-playing { border-color: var(--accent-gold); background: color-mix(in srgb, var(--accent-gold) 18%, var(--card-bg)); }
  .pillar-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; }
  .pillar-card { display: grid; align-content: start; gap: .65rem; min-width: 0; padding: .85rem; border: 1px solid var(--border); border-radius: 10px; background: color-mix(in srgb, var(--card-bg) 92%, var(--accent-gold)); color: var(--text-main); text-decoration: none; transition: border-color .16s ease, transform .16s ease; }
  .pillar-card:hover { border-color: var(--accent-gold); transform: translateY(-2px); }
  .pillar-card.is-complete { border-color: var(--accent-gold); }
  .pillar-title { font-weight: 800; }
  .pillar-status { color: var(--muted); font-size: .78rem; font-weight: 700; }
  .pillar-card.is-complete .pillar-status { color: #43b581; }
  @media (max-width: 700px) { .pillar-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
