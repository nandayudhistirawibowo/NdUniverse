---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { normalizePassedPillars } from '@core/db/progress-client-en.js';
import { getCollection } from 'astro:content';
const slug = Astro.params.slug ?? '';
const materials = await getCollection('englishEveryday');
const item = materials.find((entry) => entry.id === slug || entry.id.endsWith(`/${slug}`));
if (!item) return new Response('Material not found.', { status: 404 });
const materialSlug = item.id.split('/').at(-1) ?? item.id;
const user = Astro.locals.user;
const { data: savedProgress, error: progressError } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('sessions_passed')
    .eq('user_id', user.id)
    .eq('material_slug', item.id)
    .eq('language_code', 'en')
    .maybeSingle()
  : { data: null, error: null };
if (progressError) throw progressError;
const passedPillars = normalizePassedPillars(savedProgress?.sessions_passed);
const vocab = item.data.vocab.map((entry) => ({
  german: entry.word,
  indonesian: entry.translation,
  context: entry.context,
  reading_text: entry.reading_text,
  reading_question: entry.reading_question,
  listening_audio: entry.listening_audio,
  writing_instruction: entry.writing_instruction,
  speaking_question: entry.speaking_question,
}));
const sessions = Array.from({ length: Math.ceil(vocab.length / 5) }, (_, index) => ({ number: index + 1, words: vocab.slice(index * 5, index * 5 + 5) }));
---
<DashboardLayout title={`${item.data.title ?? item.id} | NdUniverse`} description={item.data.description ?? ''} active="catalog" user={Astro.locals.user} profile={Astro.locals.profile}>
  <article class="material-page">
    <a class="back-link" href={item.data.track === 'Academic English' ? '/en/dashboard' : '/en/everyday-english'} data-session-back><span aria-hidden="true">←</span> <span data-i18n="quiz.backMaterial">Back to Materials</span></a>
    <header>
      <p class="eyebrow">{item.data.track ?? 'Everyday English'} · {item.data.level}</p>
      <h1>{item.data.title ?? item.id}</h1>
      <p>{item.data.description}</p>
    </header>
    {sessions.map((session) => (
      <section class="session-card">
        <h2 data-i18n="material.session" data-i18n-params={JSON.stringify({ session: session.number })}>Session {session.number}</h2>
        <div class="table-wrap">
          <p class="audio-legend" data-i18n="material.audioLegend">Audio: 🇺🇸 High Quality | 🇬🇧 Browser</p>
          <table>
            <thead>
              <tr>
                <th data-i18n="material.english">English</th>
                <th data-i18n="material.indonesian">Indonesian</th>
                <th data-i18n="material.context">Context</th>
                <th data-i18n="material.wordAudio">Word audio</th>
                <th data-i18n="material.sentenceAudio">Sentence audio</th>
              </tr>
            </thead>
            <tbody>
              {session.words.map((word) => (
                <tr>
                  <td lang="en">{word.german}</td>
                  <td>{word.indonesian}</td>
                  <td lang="en">{word.context}</td>
                  <td>
                    <div class="vocab-audio-controls">
                      <button class="vocab-speech-button" type="button" data-vocab-speech="us" data-vocab-text={word.german} aria-label={`Play word in US English: ${word.german}`} data-i18n-aria-label="material.playWordUs" data-i18n-params={JSON.stringify({ word: word.german })} title="US English" data-i18n-title="material.usEnglish">🇺🇸</button>
                      <button class="vocab-speech-button" type="button" data-vocab-speech="uk" data-vocab-text={word.german} aria-label={`Play word in UK English: ${word.german}`} data-i18n-aria-label="material.playWordUk" data-i18n-params={JSON.stringify({ word: word.german })} title="UK English" data-i18n-title="material.ukEnglish">🇬🇧</button>
                    </div>
                  </td>
                  <td>
                    <div class="vocab-audio-controls">
                      <button class="vocab-speech-button" type="button" data-vocab-speech="us" data-vocab-text={word.context} aria-label={`Play sentence in US English: ${word.context}`} data-i18n-aria-label="material.playSentenceUs" data-i18n-params={JSON.stringify({ sentence: word.context })} title="US English" data-i18n-title="material.usEnglish">🇺🇸</button>
                      <button class="vocab-speech-button" type="button" data-vocab-speech="uk" data-vocab-text={word.context} aria-label={`Play sentence in UK English: ${word.context}`} data-i18n-aria-label="material.playSentenceUk" data-i18n-params={JSON.stringify({ sentence: word.context })} title="UK English" data-i18n-title="material.ukEnglish">🇬🇧</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <nav class="pillar-links" aria-label={`Session ${session.number} practice pillars`} data-i18n-aria-label="material.practicePillars" data-i18n-params={JSON.stringify({ session: session.number })}>
          {(['reading', 'listening', 'writing', 'speaking'] as const).map((pillar) => {
            const label = pillar[0].toUpperCase() + pillar.slice(1);
            const isComplete = passedPillars.includes(pillar);
            return (
              <a
                href={`/en/materi/latihan?slug=${materialSlug}&type=${pillar}&session=${session.number}`}
                data-progress-pillar={pillar}
                data-progress-slug={item.id}
                data-progress-language="en"
                data-pillar-label={label}
                class={isComplete ? 'is-complete' : ''}
                title={isComplete ? 'Completed' : undefined}
                data-i18n-title={isComplete ? 'material.completed' : undefined}
              >
                <span data-pillar-check aria-hidden="true">{isComplete ? '✓ ' : ''}</span><span data-i18n={`material.${pillar}`}>{label}</span>
              </a>
            );
          })}
        </nav>
      </section>
    ))}
  </article>
</DashboardLayout>
<script>
  import { playAudioTTS } from '../../../modules/english/config/english-speech.js';

  const bindVocabularyAudio = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-vocab-text]').forEach((button) => {
      if (button.dataset.speechBound) return;
      button.dataset.speechBound = 'true';
      button.addEventListener('click', () => {
        const text = button.dataset.vocabText;
        const accent = button.dataset.vocabSpeech;
        if (text && accent) void playAudioTTS(text, accent, button);
      });
    });
  };

  document.addEventListener('astro:page-load', bindVocabularyAudio);
  bindVocabularyAudio();

  window.addEventListener('nd:progress-updated', (event) => {
    const { slug, languageCode, pillars } = (event as CustomEvent<{
      slug: string;
      languageCode: string;
      pillars: string[];
    }>).detail;
    if (languageCode !== 'en') return;

    document.querySelectorAll<HTMLAnchorElement>('[data-progress-pillar]').forEach((link) => {
      if (link.dataset.progressSlug !== slug) return;
      const isComplete = pillars.includes(link.dataset.progressPillar ?? '');
      const label = link.dataset.pillarLabel ?? '';
      link.classList.toggle('is-complete', isComplete);
      link.setAttribute('aria-label', `${label}${isComplete ? ' completed' : ''}`);
      const check = link.querySelector<HTMLElement>('[data-pillar-check]');
      if (check) check.textContent = isComplete ? '✓ ' : '';
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-session-back]').forEach((link) => {
    link.addEventListener('click', () => {
      const session = new URLSearchParams(window.location.search).get('session');
      if (session) window.sessionStorage.setItem('nduniverse-last-session', session);
      if (document.referrer && new URL(document.referrer, window.location.origin).pathname.includes('/en/everyday-english')) {
        link.href = '/en/everyday-english';
      }
    });
  });
</script>
<style>
  .material-page { display: grid; gap: 1.25rem; }
  .back-link { width: fit-content; color: var(--text-main); font-weight: 800; text-decoration: none; }
  .eyebrow { color: #966313; font-size: .78rem; font-weight: 800; text-transform: uppercase; }
  .session-card { display: grid; gap: .75rem; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
  .table-wrap { overflow-x: auto; }
  .audio-legend { margin: 0 0 .4rem; color: var(--muted); font-size: .75rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: .65rem; border-bottom: 1px solid var(--border); text-align: left; }
  .vocab-audio-controls { display: flex; align-items: center; gap: .25rem; }
  .vocab-speech-button { width: 28px; height: 28px; padding: 0; border: 1px solid var(--border); border-radius: 5px; background: var(--card-bg); font-size: .8rem; line-height: 1; cursor: pointer; }
  .vocab-speech-button.is-playing { border-color: var(--accent-gold); background: #fff4dc; }
  .pillar-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .5rem; }
  .pillar-links a { min-height: 42px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 8px; color: var(--text-main); text-decoration: none; font-weight: 800; }
  .pillar-links a.is-complete { border-color: #3a8b55; background: #eaf6ed; color: #236b38; }
  @media (max-width: 700px) { .pillar-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
