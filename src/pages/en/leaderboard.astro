---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import Leaderboard from '@core/ui/Leaderboard.astro';
import { fetchLeaderboard } from '@core/db/leaderboard';

export const prerender = false;

const { entries, unavailable } = await fetchLeaderboard();
---

<DashboardLayout
  title="Papan Peringkat Bahasa Inggris"
  description="Peringkat siswa berdasarkan progres belajar Bahasa Inggris."
  active="leaderboard"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <Leaderboard entries={entries} language="en" unavailable={unavailable} />
</DashboardLayout>
