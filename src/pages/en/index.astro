---
import Layout from '@core/ui/Layout.astro';

if (Astro.locals.user) return Astro.redirect('/en/dashboard');

const features = [
  { href: '/en/everyday-english', title: 'Bahasa Inggris Sehari-hari', text: 'Latih kosakata praktis dan empat keterampilan utama bahasa Inggris.' },
  { href: '/en/exam', title: 'Persiapan IELTS / TOEFL', text: 'Latih keterampilan Membaca, Menyimak, Menulis, dan Berbicara melalui ujian simulasi.' },
  { href: '/en/career', title: 'Persiapan Karier', text: 'Pelajari kosakata profesional dan persiapkan diri untuk wawancara kerja berbahasa Inggris.' },
];
---

<Layout
  title="Belajar Bahasa Inggris | NdUniverse"
  description="Jelajahi materi praktis, jalur belajar CEFR, dan persiapan IELTS atau TOEFL di NdUniverse."
  url="/en"
  alternates={[
    { lang: 'id', url: '/' },
    { lang: 'en', url: '/en' },
    { lang: 'de', url: '/de' },
    { lang: 'x-default', url: '/' },
  ]}
>
  <main class="module-page">
    <a class="back-link" href="/">← Kembali ke NdUniverse</a>
    <header>
      <p class="eyebrow">NdUniverse · Bahasa Inggris</p>
      <h1>Kuasai Bahasa Inggris untuk masa depan.</h1>
      <p class="lead">Pilih jalur belajar untuk komunikasi sehari-hari, ujian internasional, atau peluang karier global.</p>
    </header>
    <div class="feature-grid">
      {features.map((feature) => (
        <a class="feature-card" href={feature.href}>
          <strong>{feature.title}</strong>
          <span>{feature.text}</span>
          <small>Buka modul →</small>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .module-page { display:grid; gap:2rem; width:min(1120px,100%); margin:0 auto; padding:1rem 0 3rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-decoration:none; }
  .back-link:hover { color:var(--accent-gold); }
  .eyebrow { margin:0 0 .6rem; color:#966313; font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  h1 { margin:0; color:var(--text-main); font-size:clamp(2.2rem,6vw,4.8rem); line-height:1; }
  .lead { max-width:680px; margin:1rem 0 0; color:var(--muted); line-height:1.75; }
  .feature-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .feature-card { display:grid; min-height:220px; align-content:start; gap:.75rem; padding:1.35rem; border:1px solid var(--border); border-radius:1rem; background:var(--card-bg); color:var(--text-main); text-decoration:none; box-shadow:var(--shadow); transition:transform .18s ease,border-color .18s ease; }
  .feature-card:hover { border-color:var(--accent-gold); transform:translateY(-3px); }
  .feature-card strong { font-size:1.2rem; }
  .feature-card span { color:var(--muted); line-height:1.65; }
  .feature-card small { align-self:end; color:#966313; font-weight:800; }
  @media(max-width:768px) { .feature-grid { grid-template-columns:1fr; } .feature-card { min-height:0; } }
</style>
