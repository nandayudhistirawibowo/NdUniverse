---
import Layout from '@core/ui/Layout.astro';

const tenses = [
  {
    tense: 'Present',
    example: 'I go to work every day.',
    meaning: 'Use the present for habits and current situations. Keep the base form “go”; add -s for he/she/it.',
  },
  {
    tense: 'Past',
    wrong: 'I go yesterday.',
    example: 'I went yesterday.',
    meaning: 'Use the past for a completed event. “Go” changes to “went”; adding “yesterday” alone is not enough.',
  },
  {
    tense: 'Future',
    example: 'I will go tomorrow.',
    meaning: 'Use this for plans or events in the future. Put “will” before the base verb.',
  },
];

const articles = [
  {
    article: 'A',
    title: 'Before a consonant sound',
    description: 'Use “a” before a singular noun that begins with a consonant sound.',
    example: 'a book',
  },
  {
    article: 'An',
    title: 'Before a vowel sound',
    description: 'Use “an” before a singular noun that begins with a vowel sound.',
    example: 'an apple',
  },
  {
    article: 'The',
    title: 'A specific item',
    description: 'Use “the” when both the speaker and listener know which item is meant.',
    example: 'the book on the table',
  },
];

const prepositions = [
  {
    preposition: 'In',
    usage: 'Use for broad periods of time and locations: months, years, cities, or countries.',
    examples: ['in May', 'in 2026', 'in Jakarta'],
  },
  {
    preposition: 'On',
    usage: 'Use for specific days or dates, and for things on a surface.',
    examples: ['on Monday', 'on the table'],
  },
  {
    preposition: 'At',
    usage: 'Use for a specific time or a location treated as a precise point.',
    examples: ['at 7 PM', 'at the bus stop'],
  },
];

const plurals = [
  {
    rule: 'Add -s',
    description: 'The general rule for many plural nouns.',
    examples: [{ singular: 'cat', plural: 'cats' }],
  },
  {
    rule: 'Add -es',
    description: 'Often used for nouns ending in sounds such as s, x, z, ch, or sh.',
    examples: [{ singular: 'box', plural: 'boxes' }],
  },
  {
    rule: 'Irregular forms',
    description: 'Some nouns change form and need to be learned individually.',
    examples: [
      { singular: 'child', plural: 'children' },
      { singular: 'mouse', plural: 'mice' },
    ],
  },
];
---

<Layout
  title="English Grammar Guide | NdUniverse"
  description="A clear English grammar guide for learners whose first language is Indonesian."
>
  <main class="grammar-page">
    <a class="back-link" href="/en">← Back to Home</a>

    <header class="page-heading">
      <p class="eyebrow">Beginner Guide · English Grammar</p>
      <h1>English Grammar</h1>
      <p class="intro-copy">
        Start with the patterns used most often. Comparing English with Indonesian helps highlight what to pay attention to when building an English sentence.
      </p>
    </header>

    <section class="guide-section" aria-labelledby="tenses-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">01 / Time</p>
          <h2 id="tenses-heading">Tenses: Verbs Mark Time</h2>
        </div>
        <p class="section-note">In Indonesian, verbs usually stay the same: the equivalent of “go yesterday” and “go tomorrow” uses the same verb.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="English tenses table" tabindex="0">
        <table class="guide-table tenses-table">
          <thead>
            <tr>
              <th scope="col">Tense</th>
              <th scope="col">Example</th>
              <th scope="col">Meaning and Notes</th>
            </tr>
          </thead>
          <tbody>
            {tenses.map(({ tense, wrong, example, meaning }) => (
              <tr>
                <th scope="row" class="row-heading">{tense}</th>
                <td>
                  {wrong && <p class="incorrect-example"><span lang="en">{wrong}</span> <span aria-label="incorrect">❌</span></p>}
                  <div class="example-with-speech">
                    <span lang="en">{example} <span aria-label="correct">✅</span></span>
                    <button class="speaker-button" type="button" data-speak={example} aria-label={`Listen to ${example}`} title={`Listen to ${example}`}>
                      <span aria-hidden="true">🔊</span>
                    </button>
                  </div>
                </td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="section-note footnote">Quick pattern: present <span lang="en">go</span>, past <span lang="en">went</span>, future <span lang="en">will go</span>. Other verbs may have regular past forms (<span lang="en">play → played</span>) or irregular forms.</p>
    </section>

    <section class="guide-section" aria-labelledby="articles-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 / Articles</p>
          <h2 id="articles-heading">Articles: A, An, and The</h2>
        </div>
        <p class="section-note">Indonesian has no direct equivalents of “a,” “an,” and “the,” so English learners often leave these words out.</p>
      </div>

      <div class="article-grid">
        {articles.map(({ article, title, description, example }) => (
          <article class="article-card">
            <p class="article-label">{article}</p>
            <h3>{title}</h3>
            <p class="card-description">{description}</p>
            <div class="example-with-speech">
              <span lang="en">{example}</span>
              <button class="speaker-button" type="button" data-speak={example} aria-label={`Listen to ${example}`} title={`Listen to ${example}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
          </article>
        ))}
      </div>
      <p class="section-note footnote">Choose “a” or “an” based on the first sound, not only the first letter. For example, <span lang="en">an hour</span> begins with a vowel sound because the h is silent.</p>
    </section>

    <section class="guide-section" aria-labelledby="prepositions-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">03 / Prepositions</p>
          <h2 id="prepositions-heading">Prepositions: In, On, and At</h2>
        </div>
        <p class="section-note">The Indonesian equivalents of “in,” “on,” and “at” do not always determine which English preposition to choose.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="English prepositions table" tabindex="0">
        <table class="guide-table">
          <thead>
            <tr><th scope="col">Preposition</th><th scope="col">When to Use It</th><th scope="col">Example Phrases</th></tr>
          </thead>
          <tbody>
            {prepositions.map(({ preposition, usage, examples }) => (
              <tr>
                <th scope="row" class="row-heading">{preposition}</th>
                <td>{usage}</td>
                <td>
                  <div class="phrase-list">
                    {examples.map((example) => (
                      <span class="example-with-speech phrase-example">
                        <span lang="en">{example}</span>
                        <button class="speaker-button" type="button" data-speak={example} aria-label={`Listen to ${example}`} title={`Listen to ${example}`}>
                          <span aria-hidden="true">🔊</span>
                        </button>
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="guide-section" aria-labelledby="plural-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">04 / Pluralization</p>
          <h2 id="plural-heading">Making Nouns Plural</h2>
        </div>
        <p class="section-note">In Indonesian, repeating a word can indicate a plural; in English, the noun itself often changes form.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="English plural noun table" tabindex="0">
        <table class="guide-table plural-table">
          <thead>
            <tr><th scope="col">Rule</th><th scope="col">Explanation</th><th scope="col">Example</th></tr>
          </thead>
          <tbody>
            {plurals.map(({ rule, description, examples }) => (
              <tr>
                <th scope="row" class="row-heading">{rule}</th>
                <td>{description}</td>
                <td>
                  <div class="plural-examples">
                    {examples.map(({ singular, plural }) => (
                      <span class="plural-example">
                        <span lang="en">{singular} → <strong>{plural}</strong></span>
                        <button class="speaker-button" type="button" data-speak={plural} aria-label={`Listen to ${plural}`} title={`Listen to ${plural}`}>
                          <span aria-hidden="true">🔊</span>
                        </button>
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { playAudioTTS } from '../../../modules/english/config/english-speech.js';

  const grammarDocument = document as Document & { __ndUniverseEnglishGrammarHandler?: boolean };
  if (!grammarDocument.__ndUniverseEnglishGrammarHandler) {
    grammarDocument.__ndUniverseEnglishGrammarHandler = true;
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('[data-speak]');
      if (!button) return;

      const text = button.dataset.speak;
      if (text) void playAudioTTS(text, 'us', button);
    });
  }
</script>

<style>
  .grammar-page {
    --grammar-accent: var(--accent-gold, #e5a93b);
    --grammar-ink: var(--text-main, #2b2d42);
    --grammar-muted: var(--muted, #6b7280);
    --grammar-border: var(--border, rgba(43, 45, 66, 0.13));
    --grammar-card: var(--card-bg, #fff);
    --grammar-soft: rgba(229, 169, 59, 0.1);
    display: grid;
    gap: 2.7rem;
    padding: 0.5rem 0 3rem;
  }

  .back-link {
    width: fit-content;
    color: var(--grammar-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--grammar-accent);
  }

  .page-heading {
    max-width: 800px;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.55rem;
    color: var(--grammar-accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    color: var(--grammar-ink);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.15;
  }

  .intro-copy {
    max-width: 740px;
    margin: 0.9rem 0 0;
    color: var(--grammar-muted);
    line-height: 1.75;
  }

  .guide-section {
    min-width: 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--grammar-ink);
    font-size: clamp(1.35rem, 3vw, 1.7rem);
  }

  .section-note {
    max-width: 470px;
    margin: 0;
    color: var(--grammar-muted);
    font-size: 0.87rem;
    line-height: 1.6;
  }

  .table-scroll {
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    border: 1px solid var(--grammar-border);
    border-radius: 0.75rem;
    background: var(--grammar-card);
    scrollbar-color: var(--grammar-accent) var(--grammar-soft);
  }

  .guide-table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    text-align: left;
  }

  .tenses-table {
    min-width: 850px;
  }

  .plural-table {
    min-width: 740px;
  }

  .guide-table th,
  .guide-table td {
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--grammar-border);
    vertical-align: middle;
  }

  .guide-table thead th {
    background: var(--bg-dark, var(--text-main, #2b2d42));
    color: var(--card-bg, #fff);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .guide-table tbody tr:nth-child(even) {
    background: var(--grammar-soft);
  }

  .guide-table tbody tr:last-child th,
  .guide-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .guide-table tbody th,
  .guide-table tbody td {
    color: var(--grammar-ink);
    font-size: 0.91rem;
    line-height: 1.6;
  }

  .row-heading {
    width: 15%;
    font-weight: 800;
  }

  .example-with-speech,
  .plural-example {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .example-with-speech small {
    display: block;
    margin-top: 0.15rem;
    color: var(--grammar-muted);
    font-size: 0.75rem;
  }

  .incorrect-example {
    margin: 0 0 0.5rem;
    color: var(--grammar-muted);
    text-decoration: line-through;
  }

  .speaker-button {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid var(--grammar-border);
    border-radius: 0.6rem;
    background: var(--grammar-soft);
    color: var(--grammar-ink);
    cursor: pointer;
    transition: transform 0.16s ease, border-color 0.16s ease, background-color 0.16s ease;
  }

  .speaker-button:hover {
    transform: scale(1.06);
    border-color: var(--grammar-accent);
    background: var(--grammar-card);
  }

  .speaker-button.is-playing {
    border-color: var(--grammar-accent);
    background: var(--grammar-accent);
  }

  .speaker-button:focus-visible,
  .table-scroll:focus-visible {
    outline: 3px solid var(--grammar-accent);
    outline-offset: 2px;
  }

  .footnote {
    margin-top: 0.7rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .article-card {
    min-width: 0;
    padding: 1.1rem;
    border: 1px solid var(--grammar-border);
    border-top: 3px solid var(--grammar-accent);
    border-radius: 0.75rem;
    background: var(--grammar-card);
  }

  .article-label {
    margin-bottom: 0.35rem;
    color: var(--grammar-accent);
    font-size: 1.6rem;
    font-weight: 800;
  }

  .article-card h3 {
    margin-bottom: 0.6rem;
    color: var(--grammar-ink);
    font-size: 1.05rem;
  }

  .card-description {
    min-height: 4.5rem;
    margin-bottom: 0.9rem;
    color: var(--grammar-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .phrase-list,
  .plural-examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .phrase-example,
  .plural-example {
    padding: 0.3rem 0.4rem 0.3rem 0.65rem;
    border: 1px solid var(--grammar-border);
    border-radius: 0.65rem;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .section-heading {
      display: block;
    }

    .section-note {
      margin-top: 0.55rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .card-description {
      min-height: 0;
    }
  }

  @media (max-width: 520px) {
    .grammar-page {
      gap: 2rem;
    }

    .guide-table th,
    .guide-table td {
      padding: 0.65rem 0.75rem;
    }
  }
</style>
