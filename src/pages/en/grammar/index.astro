---
import Layout from '@core/ui/Layout.astro';

const tenses = [
  {
    tense: 'Saat Ini',
    example: 'I go to work every day.',
    meaning: 'Gunakan bentuk saat ini untuk kebiasaan dan keadaan sekarang. Gunakan bentuk dasar “go”; tambahkan -s untuk he/she/it.',
  },
  {
    tense: 'Lampau',
    wrong: 'I go yesterday.',
    example: 'I went yesterday.',
    meaning: 'Gunakan bentuk lampau untuk peristiwa yang sudah selesai. “Go” berubah menjadi “went”; menambahkan “yesterday” saja tidak cukup.',
  },
  {
    tense: 'Masa Depan',
    example: 'I will go tomorrow.',
    meaning: 'Gunakan bentuk ini untuk rencana atau peristiwa di masa depan. Letakkan “will” sebelum kata kerja dasar.',
  },
];

const articles = [
  {
    article: 'A',
    title: 'Sebelum Bunyi Konsonan',
    description: 'Gunakan “a” sebelum kata benda tunggal yang diawali bunyi konsonan.',
    example: 'a book',
  },
  {
    article: 'An',
    title: 'Sebelum Bunyi Vokal',
    description: 'Gunakan “an” sebelum kata benda tunggal yang diawali bunyi vokal.',
    example: 'an apple',
  },
  {
    article: 'The',
    title: 'Benda Tertentu',
    description: 'Gunakan “the” saat pembicara dan pendengar mengetahui benda yang dimaksud.',
    example: 'the book on the table',
  },
];

const prepositions = [
  {
    preposition: 'In',
    usage: 'Gunakan untuk rentang waktu dan lokasi yang luas: bulan, tahun, kota, atau negara.',
    examples: ['in May', 'in 2026', 'in Jakarta'],
  },
  {
    preposition: 'On',
    usage: 'Gunakan untuk hari atau tanggal tertentu, serta benda yang berada di atas permukaan.',
    examples: ['on Monday', 'on the table'],
  },
  {
    preposition: 'At',
    usage: 'Gunakan untuk waktu tertentu atau lokasi yang dianggap sebagai titik yang spesifik.',
    examples: ['at 7 PM', 'at the bus stop'],
  },
];

const plurals = [
  {
    rule: 'Tambahkan -s',
    description: 'Aturan umum untuk banyak kata benda jamak.',
    examples: [{ singular: 'cat', plural: 'cats' }],
  },
  {
    rule: 'Tambahkan -es',
    description: 'Sering digunakan untuk kata benda yang berakhir dengan bunyi seperti s, x, z, ch, atau sh.',
    examples: [{ singular: 'box', plural: 'boxes' }],
  },
  {
    rule: 'Bentuk Tidak Beraturan',
    description: 'Beberapa kata benda berubah bentuk dan perlu dipelajari satu per satu.',
    examples: [
      { singular: 'child', plural: 'children' },
      { singular: 'mouse', plural: 'mice' },
    ],
  },
];

const beForms = [
  { subject: 'I', form: 'am' },
  { subject: 'You', form: 'are' },
  { subject: 'He', form: 'is' },
  { subject: 'She', form: 'is' },
  { subject: 'It', form: 'is' },
  { subject: 'We', form: 'are' },
  { subject: 'They', form: 'are' },
];

const beExamples = [
  { sentence: 'I am tired.', meaning: 'Saya lelah.' },
  { sentence: 'You are ready.', meaning: 'Kamu siap.' },
  { sentence: 'She is a student.', meaning: 'Dia seorang pelajar.' },
  { sentence: 'They are at home.', meaning: 'Mereka di rumah.' },
];

const pronouns = [
  { subject: 'I', possessive: 'my', meaning: 'saya' },
  { subject: 'You', possessive: 'your', meaning: 'kamu' },
  { subject: 'He', possessive: 'his', meaning: 'dia (laki-laki)' },
  { subject: 'She', possessive: 'her', meaning: 'dia (perempuan)' },
  { subject: 'It', possessive: 'its', meaning: 'benda/hewan' },
  { subject: 'We', possessive: 'our', meaning: 'kami/kita' },
  { subject: 'They', possessive: 'their', meaning: 'mereka' },
];

const pronounExamples = [
  { sentence: 'This is my book.', meaning: 'Ini buku saya.' },
  { sentence: 'Your bag is here.', meaning: 'Tasmu ada di sini.' },
  { sentence: 'Their house is big.', meaning: 'Rumah mereka besar.' },
];

const demonstratives = [
  { word: 'This', distance: 'Dekat', number: 'Tunggal', meaning: 'ini' },
  { word: 'That', distance: 'Jauh', number: 'Tunggal', meaning: 'itu' },
  { word: 'These', distance: 'Dekat', number: 'Jamak', meaning: 'ini' },
  { word: 'Those', distance: 'Jauh', number: 'Jamak', meaning: 'itu' },
];

const demonstrativeExamples = [
  { sentence: 'This is my book.', meaning: 'Ini buku saya.' },
  { sentence: 'That is your bag.', meaning: 'Itu tasmu.' },
  { sentence: 'These are fresh apples.', meaning: 'Apel-apel ini segar.' },
  { sentence: 'Those are your shoes.', meaning: 'Sepatu-sepatu itu milikmu.' },
];

const questionWords = [
  { word: 'What', meaning: 'Apa' },
  { word: 'Where', meaning: 'Di mana' },
  { word: 'When', meaning: 'Kapan' },
  { word: 'Who', meaning: 'Siapa' },
  { word: 'Why', meaning: 'Kenapa' },
  { word: 'How', meaning: 'Bagaimana' },
];

const questionExamples = [
  { statement: 'You are tired.', question: 'Are you tired?', meaning: 'Kamu lelah? / Apakah kamu lelah?' },
  { statement: 'He is a doctor.', question: 'Is he a doctor?', meaning: 'Dia seorang dokter? / Apakah dia seorang dokter?' },
  { statement: 'They are at home.', question: 'Where are they?', meaning: 'Mereka di rumah. / Di mana mereka?' },
];

const quantityWords = [
  { word: 'Many', usage: 'Benda yang bisa dihitung', example: 'apples' },
  { word: 'Much', usage: 'Benda yang tidak bisa dihitung', example: 'water' },
  { word: 'Some', usage: 'Kalimat positif', example: 'some rice' },
  { word: 'Any', usage: 'Kalimat negatif atau pertanyaan', example: 'any money' },
];

const quantityExamples = [
  { sentence: 'I have many apples.', meaning: 'Saya punya banyak apel.' },
  { sentence: 'There is much water.', meaning: 'Ada banyak air.' },
  { sentence: 'We have some rice.', meaning: 'Kami punya sedikit nasi.' },
  { sentence: 'Do you have any money?', meaning: 'Apa kamu punya uang?' },
];
---

<Layout
  title="Panduan Tata Bahasa Inggris | NdUniverse"
  description="Panduan tata bahasa Inggris untuk penutur bahasa Indonesia."
>
  <main class="grammar-page">
    <a class="back-link" href="/en">← Kembali ke Beranda</a>

    <header class="page-heading">
      <p class="eyebrow">Panduan Pemula · Tata Bahasa Inggris</p>
      <h1>Tata Bahasa Inggris</h1>
      <p class="intro-copy">
        Mulailah dengan pola yang paling sering digunakan. Membandingkan bahasa Inggris dan bahasa Indonesia membantu mengenali hal-hal yang perlu diperhatikan saat menyusun kalimat bahasa Inggris.
      </p>
    </header>

    <section class="guide-section" aria-labelledby="tenses-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">01 / Waktu</p>
          <h2 id="tenses-heading">Tenses: Kata Kerja Menandai Waktu</h2>
        </div>
        <p class="section-note">Dalam bahasa Indonesia, kata kerja biasanya tetap sama: bentuk setara untuk “go yesterday” dan “go tomorrow” menggunakan kata kerja yang sama.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel tenses bahasa Inggris" tabindex="0">
        <table class="guide-table tenses-table">
          <thead>
            <tr>
              <th scope="col">Tense</th>
              <th scope="col">Contoh</th>
              <th scope="col">Arti dan Catatan</th>
            </tr>
          </thead>
          <tbody>
            {tenses.map(({ tense, wrong, example, meaning }) => (
              <tr>
                <th scope="row" class="row-heading">{tense}</th>
                <td>
                  {wrong && <p class="incorrect-example"><span lang="en">{wrong}</span> <span aria-label="salah">❌</span></p>}
                  <div class="example-with-speech">
                    <span lang="en">{example} <span aria-label="benar">✅</span></span>
                    <button class="speaker-button" type="button" data-speak={example} aria-label={`Dengarkan ${example}`} title={`Dengarkan ${example}`}>
                      <span aria-hidden="true">🔊</span>
                    </button>
                  </div>
                </td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="section-note footnote">Pola singkat: saat ini <span lang="en">go</span>, lampau <span lang="en">went</span>, masa depan <span lang="en">will go</span>. Kata kerja lain dapat memiliki bentuk lampau beraturan (<span lang="en">play → played</span>) atau tidak beraturan.</p>
    </section>

    <section class="guide-section" aria-labelledby="articles-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 / Artikel</p>
          <h2 id="articles-heading">Artikel: A, An, dan The</h2>
        </div>
        <p class="section-note">Bahasa Indonesia tidak memiliki padanan langsung untuk “a”, “an”, dan “the”, sehingga pelajar bahasa Inggris sering melewatkan kata-kata ini.</p>
      </div>

      <div class="article-grid">
        {articles.map(({ article, title, description, example }) => (
          <article class="article-card">
            <p class="article-label">{article}</p>
            <h3>{title}</h3>
            <p class="card-description">{description}</p>
            <div class="example-with-speech">
              <span lang="en">{example}</span>
              <button class="speaker-button" type="button" data-speak={example} aria-label={`Dengarkan ${example}`} title={`Dengarkan ${example}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
          </article>
        ))}
      </div>
      <p class="section-note footnote">Pilih “a” atau “an” berdasarkan bunyi awal, bukan hanya huruf pertama. Contohnya, <span lang="en">an hour</span> diawali bunyi vokal karena huruf h tidak dilafalkan.</p>
    </section>

    <section class="guide-section" aria-labelledby="prepositions-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">03 / Preposisi</p>
          <h2 id="prepositions-heading">Preposisi: In, On, dan At</h2>
        </div>
        <p class="section-note">Padanan bahasa Indonesia untuk “in”, “on”, dan “at” tidak selalu menentukan preposisi bahasa Inggris yang harus dipilih.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel preposisi bahasa Inggris" tabindex="0">
        <table class="guide-table">
          <thead>
            <tr><th scope="col">Preposisi</th><th scope="col">Penggunaan</th><th scope="col">Contoh Frasa</th></tr>
          </thead>
          <tbody>
            {prepositions.map(({ preposition, usage, examples }) => (
              <tr>
                <th scope="row" class="row-heading">{preposition}</th>
                <td>{usage}</td>
                <td>
                  <div class="phrase-list">
                    {examples.map((example) => (
                      <span class="example-with-speech phrase-example">
                        <span lang="en">{example}</span>
                        <button class="speaker-button" type="button" data-speak={example} aria-label={`Dengarkan ${example}`} title={`Dengarkan ${example}`}>
                          <span aria-hidden="true">🔊</span>
                        </button>
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="guide-section" aria-labelledby="plural-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">04 / Bentuk Jamak</p>
          <h2 id="plural-heading">Membentuk Kata Benda Jamak</h2>
        </div>
        <p class="section-note">Dalam bahasa Indonesia, pengulangan kata dapat menunjukkan bentuk jamak; dalam bahasa Inggris, kata bendanya sering berubah bentuk.</p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel kata benda jamak bahasa Inggris" tabindex="0">
        <table class="guide-table plural-table">
          <thead>
            <tr><th scope="col">Aturan</th><th scope="col">Penjelasan</th><th scope="col">Contoh</th></tr>
          </thead>
          <tbody>
            {plurals.map(({ rule, description, examples }) => (
              <tr>
                <th scope="row" class="row-heading">{rule}</th>
                <td>{description}</td>
                <td>
                  <div class="plural-examples">
                    {examples.map(({ singular, plural }) => (
                      <span class="plural-example">
                        <span lang="en">{singular} → <strong>{plural}</strong></span>
                        <button class="speaker-button" type="button" data-speak={plural} aria-label={`Dengarkan ${plural}`} title={`Dengarkan ${plural}`}>
                          <span aria-hidden="true">🔊</span>
                        </button>
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="guide-section" aria-labelledby="to-be-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">05 / Kata Kerja “To Be”</p>
          <h2 id="to-be-heading">To Be: Am, Are, dan Is</h2>
        </div>
        <p class="section-note">
          Bahasa Indonesia bisa mengatakan “Saya lelah” tanpa kata kerja.
          Dalam bahasa Inggris, kalimat seperti ini perlu memakai “to be”:
          <span lang="en">I am tired.</span>
        </p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel konjugasi to be" tabindex="0">
        <table class="guide-table">
          <thead>
            <tr><th scope="col">Subjek</th><th scope="col">To be</th></tr>
          </thead>
          <tbody>
            {beForms.map(({ subject, form }) => (
              <tr>
                <th scope="row" class="row-heading" lang="en">{subject}</th>
                <td lang="en">{subject} <strong>{form}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="article-grid">
        {beExamples.map(({ sentence, meaning }) => (
          <article class="article-card">
            <div class="example-with-speech">
              <span lang="en">{sentence}</span>
              <button class="speaker-button" type="button" data-speak={sentence}
                aria-label={`Dengarkan ${sentence}`} title={`Dengarkan ${sentence}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
            <p class="card-description">{meaning}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="pronouns-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">06 / Kata Ganti</p>
          <h2 id="pronouns-heading">Subject dan Kata Kepemilikan</h2>
        </div>
        <p class="section-note">
          Dalam bahasa Indonesia, kepemilikan sering ditandai setelah benda
          (“buku saya”). Dalam bahasa Inggris, kata seperti “my” diletakkan
          sebelum benda: <span lang="en">my book</span>.
        </p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel subject dan kata kepemilikan" tabindex="0">
        <table class="guide-table">
          <thead>
            <tr>
              <th scope="col">Subject</th>
              <th scope="col">Possessive adjective</th>
              <th scope="col">Arti</th>
            </tr>
          </thead>
          <tbody>
            {pronouns.map(({ subject, possessive, meaning }) => (
              <tr>
                <th scope="row" class="row-heading" lang="en">{subject}</th>
                <td lang="en">{possessive}</td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="article-grid">
        {pronounExamples.map(({ sentence, meaning }) => (
          <article class="article-card">
            <div class="example-with-speech">
              <span lang="en">{sentence}</span>
              <button class="speaker-button" type="button" data-speak={sentence}
                aria-label={`Dengarkan ${sentence}`} title={`Dengarkan ${sentence}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
            <p class="card-description">{meaning}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="demonstratives-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">07 / Penunjuk Benda</p>
          <h2 id="demonstratives-heading">Demonstratives: This, That, These, Those</h2>
        </div>
        <p class="section-note">
          Dalam bahasa Indonesia, “ini” dan “itu” tidak berubah untuk benda tunggal
          atau jamak. Dalam bahasa Inggris, “this/that” berubah menjadi “these/those”
          untuk benda jamak.
        </p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel demonstratives" tabindex="0">
        <table class="guide-table">
          <thead>
            <tr>
              <th scope="col">Kata</th>
              <th scope="col">Jarak</th>
              <th scope="col">Jumlah</th>
              <th scope="col">Arti</th>
            </tr>
          </thead>
          <tbody>
            {demonstratives.map(({ word, distance, number, meaning }) => (
              <tr>
                <th scope="row" class="row-heading" lang="en">{word}</th>
                <td>{distance}</td>
                <td>{number}</td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="article-grid">
        {demonstrativeExamples.map(({ sentence, meaning }) => (
          <article class="article-card">
            <div class="example-with-speech">
              <span lang="en">{sentence}</span>
              <button class="speaker-button" type="button" data-speak={sentence}
                aria-label={`Dengarkan ${sentence}`} title={`Dengarkan ${sentence}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
            <p class="card-description">{meaning}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="questions-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">08 / Kalimat Tanya</p>
          <h2 id="questions-heading">WH-Questions</h2>
        </div>
        <p class="section-note">
          Dalam bahasa Indonesia, kata tanya sering ditambahkan tanpa membalik
          urutan subjek dan predikat. Dalam bahasa Inggris, “to be” atau kata
          bantu biasanya berpindah ke depan subjek: “You are” menjadi “Are you”.
        </p>
      </div>

      <div class="table-scroll" role="region" aria-label="Daftar kata tanya bahasa Inggris" tabindex="0">
        <table class="guide-table">
          <thead>
            <tr><th scope="col">Kata tanya</th><th scope="col">Arti</th></tr>
          </thead>
          <tbody>
            {questionWords.map(({ word, meaning }) => (
              <tr>
                <th scope="row" class="row-heading" lang="en">{word}</th>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="article-grid">
        {questionExamples.map(({ statement, question, meaning }) => (
          <article class="article-card">
            <div class="example-with-speech">
              <span lang="en">{statement}</span>
              <button class="speaker-button" type="button" data-speak={statement}
                aria-label={`Dengarkan ${statement}`} title={`Dengarkan ${statement}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
            <div class="example-with-speech">
              <span lang="en">{question}</span>
              <button class="speaker-button" type="button" data-speak={question}
                aria-label={`Dengarkan ${question}`} title={`Dengarkan ${question}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
            <p class="card-description">{meaning}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="quantity-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">09 / Hitung Benda</p>
          <h2 id="quantity-heading">Countable dan Uncountable</h2>
        </div>
        <p class="section-note">
          Bahasa Indonesia memakai “banyak” untuk apel maupun air. Dalam bahasa
          Inggris, gunakan “many” untuk benda yang bisa dihitung dan “much” untuk
          benda yang tidak bisa dihitung. “Some” umum dipakai di kalimat positif;
          “any” di kalimat negatif atau pertanyaan.
        </p>
      </div>

      <div class="table-scroll" role="region" aria-label="Tabel many, much, some, dan any" tabindex="0">
        <table class="guide-table">
          <thead>
            <tr>
              <th scope="col">Kata</th>
              <th scope="col">Penggunaan</th>
              <th scope="col">Contoh benda</th>
            </tr>
          </thead>
          <tbody>
            {quantityWords.map(({ word, usage, example }) => (
              <tr>
                <th scope="row" class="row-heading" lang="en">{word}</th>
                <td>{usage}</td>
                <td lang="en">{example}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="article-grid">
        {quantityExamples.map(({ sentence, meaning }) => (
          <article class="article-card">
            <div class="example-with-speech">
              <span lang="en">{sentence}</span>
              <button class="speaker-button" type="button" data-speak={sentence}
                aria-label={`Dengarkan ${sentence}`} title={`Dengarkan ${sentence}`}>
                <span aria-hidden="true">🔊</span>
              </button>
            </div>
            <p class="card-description">{meaning}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  import { playAudioTTS } from '../../../modules/english/config/english-speech.js';

  const grammarDocument = document as Document & { __ndUniverseEnglishGrammarHandler?: boolean };
  if (!grammarDocument.__ndUniverseEnglishGrammarHandler) {
    grammarDocument.__ndUniverseEnglishGrammarHandler = true;
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('[data-speak]');
      if (!button) return;

      const text = button.dataset.speak;
      if (text) void playAudioTTS(text, 'us', button);
    });
  }
</script>

<style>
  .grammar-page {
    --grammar-accent: var(--accent-gold, #e5a93b);
    --grammar-ink: var(--text-main, #2b2d42);
    --grammar-muted: var(--muted, #6b7280);
    --grammar-border: var(--border, rgba(43, 45, 66, 0.13));
    --grammar-card: var(--card-bg, #fff);
    --grammar-soft: rgba(229, 169, 59, 0.1);
    display: grid;
    gap: 2.7rem;
    padding: 0.5rem 0 3rem;
  }

  .back-link {
    width: fit-content;
    color: var(--grammar-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--grammar-accent);
  }

  .page-heading {
    max-width: 800px;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.55rem;
    color: var(--grammar-accent);
    font-size: 0.76rem;
