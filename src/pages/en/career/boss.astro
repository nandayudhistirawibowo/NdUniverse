---
import Layout from '@core/ui/Layout.astro';
import BossFight from '../../../components/BossFight-en.jsx';

const questions = [
  { question: 'Tell me about yourself.', keywords: ['name', 'experience', 'study'] },
  { question: 'What are your strengths?', keywords: ['teamwork', 'communication', 'learning'] },
  { question: 'Why do you want to work with us?', keywords: ['motivation', 'company', 'career'] },
];
---

<Layout title="Interview Challenge | NdUniverse" description="English interview practice on NdUniverse.">
  <main class="boss-page">
    <a class="back-link" href="/en/career">← Back to Career Prep</a>
    <BossFight client:load questions={questions} badge="Career Prep" profession="English Career" returnHref="/en/career" />
  </main>
</Layout>

<style>
  .boss-page { display:grid; gap:1rem; padding:1rem 0 3rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-encoration:none; }
</style>
