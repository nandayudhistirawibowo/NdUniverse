---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import BossFight from '../../../../modules/english/components/BossFight-en.jsx';
import { getCollection } from 'astro:content';

export const prerender = false;

const profesi = String(Astro.params.profesi ?? '').toLowerCase();
const titles = {
  it: ['Teknologi Informasi & Rekayasa Perangkat Lunak', 'Teknologi Informasi'],
  business: ['Bisnis Digital & E-Commerce', 'Bisnis'],
  health: ['Layanan Kesehatan', 'Layanan Kesehatan'],
  nutrition: ['Nutrisi', 'Nutrisi'],
};
const titleData = titles[profesi];
if (!titleData) return new Response('Profesi tidak ditemukan.', { status: 404 });

const careers = await getCollection('englishCareer');
const entry = careers.find((career) => career.id === profesi);
if (!entry) return new Response('Profesi karier tidak ditemukan.', { status: 404 });
const questions = entry?.data.boss_questions ?? [];
---

<DashboardLayout
  title={`Tantangan Wawancara ${titleData[0]} | NdUniverse`}
  description={`Latih pertanyaan wawancara kerja berbahasa Inggris untuk bidang ${titleData[0]}.`}
  active="career"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <section class="boss-page">
    <a class="back-link" href={`/en/career/${profesi}`}>← Kembali ke Karier</a>
    <header>
      <p class="eyebrow">Tantangan Akhir</p>
      <h1>{titleData[0]}</h1>
    </header>
    <BossFight
      client:load
      questions={questions}
      badge={titleData[1]}
      profession={titleData[0]}
      returnHref={`/en/career/${profesi}`}
    />
  </section>
</DashboardLayout>

<style>
  .boss-page { display:grid; gap:1rem; }
  .back-link { width:fit-content; color:var(--text-main); text-decoration:none; font-weight:700; }
  .eyebrow { margin:0; color:#966313; font-size:.72rem; font-weight:800; text-transform:uppercase; }
  header h1 { margin:.35rem 0 0; color:var(--text-main); }
</style>
