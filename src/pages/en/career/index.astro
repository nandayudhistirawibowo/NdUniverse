---
import Layout from '@core/ui/Layout.astro';

const professions = [
  {
    slug: 'it',
    name: 'Teknologi Informasi & Rekayasa Perangkat Lunak',
    description: 'Pelajari kosakata praktis tentang perangkat lunak, sistem, dan wawancara teknis.',
    icon: '💻',
  },
  {
    slug: 'business',
    name: 'Bisnis & E-Commerce',
    description: 'Pelajari bahasa untuk manajemen, penjualan, pemasaran, dan perdagangan daring.',
    icon: '📊',
  },
  {
    slug: 'health',
    name: 'Layanan Kesehatan',
    description: 'Pelajari bahasa Inggris kerja untuk perawatan pasien, tim klinis, dan lingkungan layanan kesehatan.',
    icon: '🩺',
  },
  {
    slug: 'nutrition',
    name: 'Nutrisi',
    description: 'Pelajari istilah nutrisi serta komunikasi untuk edukasi pangan dan kesehatan.',
    icon: '🥗',
  },
];
---

<Layout title="Persiapan Karier Bahasa Inggris | NdUniverse" description="Latih kosakata karier dan wawancara kerja dalam bahasa Inggris.">
  <main class="career-page">
    <a class="back-link" href="/en">← Kembali ke Beranda</a>
    <header class="page-heading">
      <p class="eyebrow">Persiapan Karier</p>
      <h1>Kembangkan Bahasa Inggris untuk Kariermu</h1>
      <p>Pilih profesi untuk berlatih 50 kosakata pekerjaan dalam sepuluh kelompok kuis singkat dan ikuti tantangan wawancara sesuai bidang.</p>
    </header>

    <section class="career-grid" aria-label="Profesi untuk persiapan karier">
      {professions.map((profession) => (
        <article class="career-card">
          <a class="career-card-main" href={`/en/career/${profession.slug}`}>
            <span class="career-icon" aria-hidden="true">{profession.icon}</span>
            <p class="career-label">Modul Karier Bahasa Inggris</p>
            <h2>{profession.name}</h2>
            <p class="career-description">{profession.description}</p>
            <span class="career-link-label">Jelajahi kosakata →</span>
          </a>
          <a class="boss-link" href={`/en/career/${profession.slug}/boss`}>Mulai Tantangan</a>
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  .career-page {
    --career-accent: var(--accent-gold, #e5a93b);
    --career-ink: var(--text-main, #2b2d42);
    --career-muted: var(--muted, #6b7280);
    --career-border: var(--border, rgba(43, 45, 66, 0.13));
    --career-card: var(--card-bg, #fff);
    display: grid;
    gap: 1.5rem;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 0.5rem 0 3rem;
  }

  .back-link {
    width: fit-content;
    color: var(--career-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .page-heading {
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--career-accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--career-ink);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.15;
  }

  .page-heading > p:last-child {
    margin: 0.85rem 0 0;
    color: var(--career-muted);
    line-height: 1.7;
  }

  .career-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .career-card {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.9rem;
    min-width: 0;
    padding: 1.2rem;
    border: 1px solid var(--career-border);
    border-top: 3px solid var(--career-accent);
    border-radius: 0.9rem;
    background: var(--career-card);
    animation: career-card-enter 0.45s ease both;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .career-card:nth-child(2) {
    animation-delay: 0.08s;
  }

  .career-card:nth-child(3) {
    animation-delay: 0.16s;
  }

  .career-card:nth-child(4) {
    animation-delay: 0.24s;
  }

  .career-card:hover {
    transform: translateY(-4px);
    border-color: var(--career-accent);
    box-shadow: 0 12px 28px rgba(43, 45, 66, 0.12);
  }

  .career-card-main {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    color: var(--career-ink);
    text-decoration: none;
  }

  .career-icon {
    font-size: 2rem;
  }

  .career-label {
    margin: 0;
    color: var(--career-accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .career-card h2 {
    margin: 0;
    font-size: 1.3rem;
  }

  .career-description {
    margin: 0;
    color: var(--career-muted);
    line-height: 1.6;
  }

  .career-link-label {
    margin-top: 0.2rem;
    color: var(--career-ink);
    font-weight: 800;
  }

  .boss-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.9rem;
    border-radius: 0.65rem;
    background: var(--accent-red, #d93838);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
  }

  .career-card-main:hover .career-link-label,
  .back-link:hover {
    color: var(--career-accent);
  }

  @keyframes career-card-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-card {
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .career-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
