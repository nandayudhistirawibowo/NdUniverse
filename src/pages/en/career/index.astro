---
import Layout from '@core/ui/Layout.astro';
const professions = [
  { slug:'it', name:'IT', description:'Software, digital systems, and cybersecurity.' },
  { slug:'business', name:'Business', description:'Management, sales, and corporate communication.' },
  { slug:'health', name:'Health', description:'Healthcare, nursing, and medical communication.' },
  { slug:'nutrition', name:'Nutrition', description:'Food, nutrition, and health education.' },
];
---
<Layout title="Career Prep | NdUniverse" description="English career preparation."><main class="career-page"><header><p class="eyebrow">Career Prep</p><h1>Professional Careers</h1><p>Practice vocabulary and interview skills across four professions.</p></header><div class="career-grid">{professions.map((profession)=><a href={`/en/career/${profession.slug}/boss`}><span>Career Prep</span><h2>{profession.name}</h2><p>{profession.description}</p><small>Start interview challenge →</small></a>)}</div></main></Layout>
<style>.career-page{display:grid;gap:1.5rem;width:min(1120px,100%);margin:auto}.eyebrow{color:#966313;font-size:.78rem;font-weight:800;text-transform:uppercase}.career-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.career-grid a{display:grid;gap:.75rem;min-height:220px;padding:1rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--text-main);text-decoration:none}.career-grid span,.career-grid small{color:#966313;font-weight:800}.career-grid h2,.career-grid p{margin:0}@media(max-width:800px){.career-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.career-grid{grid-template-columns:1fr}}</style>
