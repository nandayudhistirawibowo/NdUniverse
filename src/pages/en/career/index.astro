---
import Layout from '@core/ui/Layout.astro';
import CareerQuiz from '../../../components/CareerQuiz-en.jsx';

const words = [
  { german: 'communication', indonesian: 'komunikasi', options: ['komunikasi', 'negosiasi', 'analisis', 'presentasi'] },
  { german: 'teamwork', indonesian: 'kerja tim', options: ['kerja tim', 'anggaran', 'jadwal', 'kontrak'] },
  { german: 'leadership', indonesian: 'kepemimpinan', options: ['kepemimpinan', 'pemasaran', 'pelanggan', 'laporan'] },
  { german: 'experience', indonesian: 'pengalaman', options: ['pengalaman', 'pendidikan', 'gaji', 'kantor'] },
  { german: 'responsibility', indonesian: 'tanggung jawab', options: ['tanggung jawab', 'keuntungan', 'perjalanan', 'peralatan'] },
];
---

<Layout title="Career Prep | NdUniverse" description="English career preparation on NdUniverse.">
  <main class="career-page">
    <a class="back-link" href="/en">← Back to English Module</a>
    <header>
      <p class="eyebrow">Career Prep</p>
      <h1>Prepare for global opportunities.</h1>
      <p class="lead">Practice workplace vocabulary and prepare your English for interviews and international teams.</p>
    </header>
    <CareerQuiz client:load words={words} profession="English Career" />
    <a class="boss-link" href="/en/career/boss">Start Interview Challenge →</a>
  </main>
</Layout>

<style>
  .career-page { display:grid; gap:1.5rem; width:min(1120px,100%); margin:0 auto; padding:1rem 0 3rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-decoration:none; }
  .back-link:hover { color:var(--accent-gold); }
  .eyebrow { margin:0 0 .6rem; color:#966313; font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  h1 { margin:0; color:var(--text-main); font-size:clamp(2rem,5vw,4rem); line-height:1; }
  .lead { margin:1rem 0 0; color:var(--muted); line-height:1.75; }
  .boss-link { display:inline-flex; min-height:44px; align-items:center; justify-content:center; width:fit-content; padding:.75rem 1rem; border-radius:.65rem; background:var(--accent-red); color:#fff; font-weight:800; text-decoration:none; }
</style>
