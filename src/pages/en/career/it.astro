---
import { getEntry } from 'astro:content';
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import CareerQuiz from '../../../modules/english/components/CareerQuiz-en.jsx';
import HelpHint from '@core/ui/HelpHint.jsx';

export const prerender = false;

const entry = await getEntry('career', 'it');
const words = entry?.data.vocab ?? [];
---

<DashboardLayout
  title="IT & Software Engineering | English Career Prep | NdUniverse"
  description="Practice IT vocabulary and interview skills in English."
  active="career"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <section class="career-profession">
    <a class="back-link" href="/en/career">← Back to Career Prep</a>
    <div class="profession-heading">
      <h1>IT &amp; Software Engineering</h1>
      <HelpHint title="IT Career Prep" text="Practice 50 IT vocabulary terms in five-word batches and take a role-specific interview challenge." client:load />
    </div>
    <CareerQuiz client:load words={words} profession="IT" />
    <article class="boss-card">
      <span aria-hidden="true">⚔️</span>
      <div>
        <p>Boss Fight</p>
        <h2>IT Job Interview</h2>
        <p>Practice answering software and technology interview questions in English.</p>
      </div>
      <a href="/en/career/it/boss">Start Interview</a>
    </article>
  </section>
</DashboardLayout>

<style>
  .career-profession { display:grid; gap:1rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-decoration:none; }
  .profession-heading { display:flex; align-items:center; gap:.65rem; flex-wrap:wrap; }
  .profession-heading h1 { margin:0; color:var(--text-main); }
  .boss-card { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:1rem; padding:1.25rem; border:1px solid var(--accent-gold); border-radius:14px; background:var(--card-bg); }
  .boss-card > span { font-size:1.8rem; }
  .boss-card p,.boss-card h2 { margin:.1rem 0; color:var(--text-main); }
  .boss-card div > p:first-child { color:var(--accent-gold); font-size:.72rem; font-weight:800; text-transform:uppercase; }
  .boss-card a { min-height:44px; display:inline-flex; align-items:center; padding:.65rem 1rem; border-radius:.65rem; background:var(--accent-red); color:#fff; font-weight:800; text-decoration:none; }
  @media(max-width:700px) { .boss-card { grid-template-columns:auto 1fr; } .boss-card a { grid-column:1/-1; justify-content:center; } }
</style>
