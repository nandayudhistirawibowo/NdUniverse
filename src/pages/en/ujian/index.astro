---
import Layout from '@core/ui/Layout.astro';
import IELTSExam from '../../../modules/english/components/IELTSExam-en.jsx';
---
<Layout title="English Exams | NdUniverse" description="IELTS/TOEFL English exam practice.">
  <main class="exam-page">
    <header><p class="eyebrow">English Exams</p><h1>IELTS / TOEFL Practice</h1><p>Practice Reading, Listening, Writing, and Speaking.</p></header>
    <IELTSExam client:load level="A1" tasks={{lesen:[{passage:'Online learning gives students flexible access to education.',prompt:'Choose the best meaning of flexible.',answer:'adaptable',options:['adaptable','expensive','traditional','temporary']}],hoeren:[],schreiben:[],sprechen:[]}} available={false}/>
  </main>
</Layout>
<style>.exam-page{width:min(1000px,100%);margin:0 auto;display:grid;gap:1rem}.eyebrow{color:#966313;font-size:.78rem;font-weight:800;text-transform:uppercase}.exam-page h1,.exam-page header p:last-child{margin-bottom:0}</style>
