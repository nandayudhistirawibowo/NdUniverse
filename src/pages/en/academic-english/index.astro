---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

const materials = (await getCollection('englishAcademic'))
  .sort((left, right) => left.data.title.localeCompare(right.data.title));
---

<DashboardLayout
  title="Academic English | NdUniverse"
  description="Academic vocabulary for study and professional communication."
  active="academicEnglish"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <main class="academic-page">
    <a class="back-link" href="/en/dashboard">← Back to English Dashboard</a>
    <header>
      <p class="eyebrow">Academic English · {materials.length} Materials</p>
      <h1>Build language for study and work.</h1>
      <p class="lead">Choose a field to explore academic vocabulary and practice English for your studies.</p>
    </header>
    {materials.length > 0 ? (
      <div class="material-grid">
        {materials.map((item) => {
          const slug = item.id.split('/').at(-1) ?? item.id;
          return (
            <article class="material-card">
              <span class="department-label">{item.data.jurusan}</span>
              <h2>{item.data.title}</h2>
              <p>{item.data.description}</p>
              <a href={`/en/academic-english/${slug}`}>Open Material →</a>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">No Academic English materials are available yet.</p>
    )}
  </main>
</DashboardLayout>

<style>
  .academic-page { display:grid; gap:1.5rem; padding:1rem 0 3rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-decoration:none; }
  .eyebrow { margin:0 0 .6rem; color:var(--accent-gold,#966313); font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  h1 { margin:0; color:var(--text-main); font-size:clamp(2rem,5vw,4rem); }
  .lead { max-width:700px; margin:1rem 0 0; color:var(--muted); line-height:1.75; }
  .material-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:1rem; }
  .material-card { display:grid; align-content:start; gap:.65rem; padding:1rem; border:1px solid var(--border); border-radius:8px; background:var(--card-bg); }
  .department-label { color:var(--accent-gold,#966313); font-size:.75rem; font-weight:800; }
  .material-card h2,.material-card p { margin:0; color:var(--text-main); }
  .material-card p,.empty-state { color:var(--muted); line-height:1.55; }
  .material-card a { color:var(--accent-gold,#966313); font-weight:800; text-decoration:none; }
  @media(max-width:700px) { .material-grid { grid-template-columns:1fr; } }
</style>
