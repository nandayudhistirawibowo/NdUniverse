---
import Layout from '@core/ui/Layout.astro';
import { getCollection } from 'astro:content';
const materials = (await getCollection('english'))
  .filter((item) => item.data.track === 'Academic English')
  .sort((a, b) => (a.data.title ?? a.id).localeCompare(b.data.title ?? b.id));
---

<Layout title="Academic English | NdUniverse" description="Academic English materials for international studies and professional communication.">
  <main class="academic-page">
    <a class="back-link" href="/en">← Back to English Module</a>
    <header><p class="eyebrow">Academic English · {materials.length} Materials</p><h1>Build language for study and work.</h1><p class="lead">Explore academic vocabulary and professional communication materials.</p></header>
    {materials.length > 0 ? <div class="material-grid">{materials.map((item)=><article class="material-card"><span>{item.data.level ?? 'Academic'}</span><h2>{item.data.title ?? item.id}</h2><p>{item.data.description}</p><a href={`/en/materi/${item.id}`}>Open Material →</a></article>)}</div> : <p class="empty-state">No Academic English materials are available yet.</p>}
  </main>
</Layout>

<style>
  .academic-page { display: grid; gap: 1.5rem; width: min(1120px, 100%); margin: 0 auto; padding: 1rem 0 3rem; }
  .back-link { width: fit-content; color: var(--text-main); font-weight: 700; text-decoration: none; }
  .eyebrow { margin: 0 0 .6rem; color: #966313; font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2rem, 5vw, 4rem); }.lead { max-width: 700px; margin: 1rem 0 0; color: var(--muted); line-height: 1.75; }
  .material-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem}.material-card{display:grid;align-content:start;gap:.65rem;padding:1rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg)}.material-card span{color:#966313;font-size:.75rem;font-weight:800}.material-card h2,.material-card p{margin:0}.material-card p{color:var(--muted);line-height:1.55}.material-card a{color:#966313;font-weight:800;text-decoration:none}.empty-state{color:var(--muted)}@media(max-width:700px){.material-grid{grid-template-columns:1fr}}
</style>
