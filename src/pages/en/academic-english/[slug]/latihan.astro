---
import Layout from '@core/ui/Layout.astro';
import Quiz from '../../../../modules/english/components/Quiz-en.jsx';
import { getCollection } from 'astro:content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const materials = await getCollection('englishAcademic');
const item = materials.find((material) => material.id === slug || material.id.endsWith(`/${slug}`));
if (!item) return new Response('Academic English material not found.', { status: 404 });

const allowedTypes = ['reading', 'listening', 'writing', 'speaking'];
const requestedType = Astro.url.searchParams.get('type') ?? '';
if (requestedType && !allowedTypes.includes(requestedType)) {
  return new Response('Practice type not found.', { status: 404 });
}
const type = requestedType;
const materialSlug = item.id.split('/').at(-1) ?? item.id;
const batchSize = 5;
const sessionNumber = Math.max(1, Number(Astro.url.searchParams.get('session')) || 1);
const items = item.data.vocab.map((entry) => ({
  german: entry.word,
  indonesian: entry.translation,
  context: entry.context,
  reading_text: entry.reading_text ?? item.data.reading_text,
  reading_question: entry.reading_question ?? item.data.reading_question,
  listening_audio: entry.listening_audio ?? item.data.listening_audio,
  writing_instruction: entry.writing_instruction ?? item.data.writing_instruction,
  speaking_question: entry.speaking_question ?? item.data.speaking_question,
}));
const sessionCount = Math.ceil(items.length / batchSize);
const startIndex = (sessionNumber - 1) * batchSize;
const labels = { reading: 'Reading', listening: 'Listening', writing: 'Writing', speaking: 'Speaking' };
const pillarLabel = labels[type] ?? 'Vocabulary';
---

<Layout title={`${pillarLabel}: ${item.data.title} | NdUniverse`} description={`Academic English practice for ${item.data.title}.`} hideNavbar={true}>
  <main class="practice-page">
    <a class="back-link" href={`/en/academic-english/${materialSlug}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 18-6-6 6-6M8 12h12" /></svg>
      <span>Back to Material</span>
    </a>
    <header class="page-heading">
      <p class="eyebrow">Academic English · {item.data.jurusan}</p>
      <h1>{pillarLabel}: {item.data.title}</h1>
      <p>Practice academic English vocabulary and build confidence one question at a time.{type ? ` Session ${sessionNumber} of ${sessionCount}.` : ''}</p>
    </header>
    <section class="practice-panel" aria-label={`${pillarLabel} practice for ${item.data.title}`}>
      <Quiz
        client:load
        items={items}
        track="Academic English"
        jurusan={item.data.jurusan}
        returnHref={`/en/academic-english/${materialSlug}`}
        startIndex={startIndex}
        session={sessionNumber}
        batchSize={batchSize}
        sessionMode={Boolean(type)}
        materialId={`academic-${materialSlug}`}
        type={type}
      />
    </section>
  </main>
</Layout>

<style>
  .practice-page { display:grid; max-width:1000px; min-height:calc(100svh - 8.5rem); align-content:center; gap:.9rem; margin:0 auto; padding:1.25rem 0; }
  .back-link { display:inline-flex; width:fit-content; align-items:center; gap:.45rem; margin-bottom:.2rem; color:var(--text-main); font-weight:700; text-decoration:none; }
  .back-link svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .back-link:hover { color:var(--accent-gold,#966313); transform:translateX(-2px); }
  .page-heading { margin-bottom:.25rem; }
  .eyebrow { margin:0 0 .5rem; color:var(--accent-gold,#966313); font-size:.8rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  h1 { margin:0; color:var(--text-main); font-size:clamp(1.8rem,3vw,2.45rem); }
  .page-heading > p:last-child { margin:.75rem 0 0; color:var(--muted); line-height:1.7; }
  .practice-panel { padding:clamp(1rem,3vw,2rem); border:1px solid var(--border); border-radius:10px; background:var(--card-bg); box-shadow:0 20px 50px rgba(26,26,30,.1); }
  @media(max-width:640px) { .practice-page { min-height:calc(100svh - 7rem); padding:.75rem 0; } .practice-panel { padding:.85rem; } }
</style>
