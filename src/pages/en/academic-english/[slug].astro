---
import DashboardLayout from '@core/ui/DashboardLayout-en.astro';
import { normalizePassedPillars } from '@core/db/progress-client-en.js';
import { getCollection } from 'astro:content';

export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const materials = await getCollection('englishAcademic');
const item = materials.find((material) => material.id === slug || material.id.endsWith(`/${slug}`));
if (!item) return new Response('Academic English material not found.', { status: 404 });

const materialSlug = item.id.split('/').at(-1) ?? item.id;
const progressSlug = `academic-${materialSlug}`;
const user = Astro.locals.user;
const { data: savedProgress, error: progressError } = user
  ? await Astro.locals.supabase
    .from('user_progress')
    .select('sessions_passed')
    .eq('user_id', user.id)
    .eq('material_slug', progressSlug)
    .eq('language_code', 'en')
    .maybeSingle()
  : { data: null, error: null };
if (progressError) throw progressError;
const passedPillars = normalizePassedPillars(savedProgress?.sessions_passed);
const vocab = item.data.vocab.map((entry) => ({
  ...entry,
  german: entry.word,
  indonesian: entry.translation,
  reading_text: entry.reading_text ?? item.data.reading_text,
  reading_question: entry.reading_question ?? item.data.reading_question,
  listening_audio: entry.listening_audio ?? item.data.listening_audio,
  writing_instruction: entry.writing_instruction ?? item.data.writing_instruction,
  speaking_question: entry.speaking_question ?? item.data.speaking_question,
}));
const sessionCount = Math.ceil(vocab.length / 5);

const pillars = [
  { type: 'reading', label: 'Membaca', available: Boolean(item.data.reading_text || item.data.reading_question || item.data.vocab.some((entry) => entry.reading_text || entry.reading_question)) },
  { type: 'listening', label: 'Menyimak', available: Boolean(item.data.listening_audio || item.data.vocab.some((entry) => entry.listening_audio)) },
  { type: 'writing', label: 'Menulis', available: Boolean(item.data.writing_instruction || item.data.vocab.some((entry) => entry.writing_instruction)) },
  { type: 'speaking', label: 'Berbicara', available: Boolean(item.data.speaking_question || item.data.vocab.some((entry) => entry.speaking_question)) },
];
---

<DashboardLayout
  title={`${item.data.title} | Academic English | NdUniverse`}
  description={item.data.description}
  active="academicEnglish"
  user={Astro.locals.user}
  profile={Astro.locals.profile}
>
  <main class="academic-material">
    <a class="back-link" href="/en/academic-english">← Kembali ke Bahasa Inggris Akademik</a>
    <header class="material-heading">
      <p class="eyebrow">{item.data.jurusan} · Bahasa Inggris Akademik</p>
      <h1>{item.data.title}</h1>
      <p>{item.data.description}</p>
    </header>

    <section class="vocabulary-section" aria-labelledby="vocabulary-heading">
      <div class="section-heading">
        <h2 id="vocabulary-heading">Kosakata</h2>
        <a class="primary-link" href={`/en/academic-english/${materialSlug}/latihan`}>Mulai Kuis Kosakata</a>
      </div>
      <div class="table-scroll" role="region" aria-label={`Kosakata ${item.data.title}`} tabindex="0">
        <table class="vocabulary-table">
          <thead>
            <tr><th scope="col">Kata</th><th scope="col">Arti</th><th scope="col">Contoh</th></tr>
          </thead>
          <tbody>
            {vocab.map((word) => (
              <tr>
                <th scope="row" lang="en">
                  <span class="audio-example">
                    {word.word}
                    <button class="speaker-button" type="button" data-speak={word.word} aria-label={`Dengarkan ${word.word}`} title={`Dengarkan ${word.word}`}>🔊</button>
                  </span>
                </th>
                <td>{word.translation}</td>
                <td lang="en">
                  <span class="audio-example">
                    {word.context}
                    <button class="speaker-button" type="button" data-speak={word.context} aria-label={`Dengarkan contoh: ${word.context}`} title="Dengarkan contoh">🔊</button>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {pillars.some((pillar) => pillar.available) && (
      <section class="pillar-sessions" aria-label="Sesi keterampilan Bahasa Inggris Akademik">
        {Array.from({ length: sessionCount }, (_, index) => index + 1).map((session) => (
          <div class="pillar-session">
            <h2>Sesi {session}</h2>
            <nav class="pillar-links" aria-label={`Keterampilan Bahasa Inggris Akademik pada sesi ${session}`}>
              {pillars.filter((pillar) => pillar.available).map((pillar) => {
                const sessionPillarKey = `s${session}-${pillar.type}`;
                const isComplete = passedPillars.includes(sessionPillarKey) || (session === 1 && passedPillars.includes(pillar.type));
                return (
                  <a
                    href={`/en/academic-english/${materialSlug}/latihan?type=${pillar.type}&session=${session}`}
                    data-progress-pillar={pillar.type}
                    data-progress-session={session}
                    data-progress-slug={progressSlug}
                    data-progress-language="en"
                    data-pillar-label={pillar.label}
                    class={isComplete ? 'is-complete' : ''}
                    aria-label={`${pillar.label}${isComplete ? ' selesai' : ''}`}
                  >
                    <span data-pillar-check aria-hidden="true">{isComplete ? '✓ ' : ''}</span>{pillar.label}
                  </a>
                );
              })}
            </nav>
          </div>
        ))}
      </section>
    )}
  </main>
</DashboardLayout>

<script>
  import { playAudioTTS } from '../../../modules/english/config/english-speech.js';

  const bindSpeakers = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-speak]').forEach((button) => {
      if (button.dataset.speechBound) return;
      button.dataset.speechBound = 'true';
      button.addEventListener('click', () => {
        const text = button.dataset.speak;
        if (text) void playAudioTTS(text, 'us', button);
      });
    });
  };

  document.addEventListener('astro:page-load', bindSpeakers);
  bindSpeakers();

  window.addEventListener('nd:progress-updated', (event) => {
    const { slug, languageCode, pillars } = (event as CustomEvent<{
      slug: string;
      languageCode: string;
      pillars: string[];
    }>).detail;
    if (languageCode !== 'en') return;

    document.querySelectorAll<HTMLAnchorElement>('[data-progress-pillar]').forEach((link) => {
      if (link.dataset.progressSlug !== slug) return;
      const sessionNum = Number(link.dataset.progressSession || 1);
      const pillarType = link.dataset.progressPillar ?? '';
      const sessionPillarKey = `s${sessionNum}-${pillarType}`;
      const isComplete = pillars.includes(sessionPillarKey) || (sessionNum === 1 && pillars.includes(pillarType));
      const label = link.dataset.pillarLabel ?? '';
      link.classList.toggle('is-complete', isComplete);
      link.setAttribute('aria-label', `${label}${isComplete ? ' selesai' : ''}`);
      const check = link.querySelector<HTMLElement>('[data-pillar-check]');
      if (check) check.textContent = isComplete ? '✓ ' : '';
    });
  });
</script>

<style>
  .academic-material { display:grid; gap:1.25rem; padding:1rem 0 3rem; }
  .back-link { width:fit-content; color:var(--text-main); font-weight:700; text-decoration:none; }
  .back-link:hover { color:var(--accent-gold,#966313); }
  .eyebrow { margin:0 0 .45rem; color:var(--accent-gold,#966313); font-size:.75rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .material-heading h1 { margin:0; color:var(--text-main); font-size:clamp(2rem,5vw,3rem); }
  .material-heading > p:last-child { max-width:760px; margin:.75rem 0 0; color:var(--muted); line-height:1.7; }
  .vocabulary-section { display:grid; gap:.8rem; min-width:0; }
  .section-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .section-heading h2 { margin:0; color:var(--text-main); }
  .primary-link { min-height:48px; display:inline-flex; align-items:center; justify-content:center; padding:.7rem 1rem; border-radius:8px; background:var(--accent-red); color:#fff; font-weight:900; text-decoration:none; }
  .table-scroll { overflow-x:auto; border:1px solid var(--border); border-radius:8px; background:var(--card-bg); }
  .vocabulary-table { width:100%; min-width:660px; border-collapse:collapse; text-align:left; }
  .vocabulary-table th,.vocabulary-table td { padding:.7rem .8rem; border-bottom:1px solid var(--border); color:var(--text-main); vertical-align:middle; }
  .vocabulary-table thead th { background:var(--bg-dark,var(--text-main)); color:var(--card-bg); }
  .vocabulary-table tbody tr:nth-child(even) { background:var(--bg-main,#f8f9fa); }
  .vocabulary-table tbody tr:last-child th,.vocabulary-table tbody tr:last-child td { border-bottom:0; }
  .audio-example { display:inline-flex; align-items:center; gap:.5rem; }
  .speaker-button { width:34px; height:34px; flex:0 0 auto; border:1px solid var(--border); border-radius:7px; background:var(--card-bg); cursor:pointer; }
  .speaker-button.is-playing { border-color:var(--accent-gold); background:var(--bg-main,#fff4dc); }
  .pillar-sessions { display:grid; gap:.75rem; }
  .pillar-session { display:grid; gap:.55rem; }
  .pillar-session h2 { margin:0; color:var(--text-main); font-size:1rem; }
  .pillar-links { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.55rem; }
  .pillar-links a { min-height:44px; display:grid; place-items:center; border:1px solid var(--border); border-radius:8px; color:var(--text-main); font-weight:800; text-decoration:none; }
  .pillar-links a.is-complete { border-color:#3a8b55; background:#eaf6ed; color:#236b38; }
  @media(max-width:700px) {
    .section-heading { align-items:stretch; flex-direction:column; }
    .primary-link { width:100%; box-sizing:border-box; }
    .pillar-links { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
</style>
